# Production domain without trailing slash
SITE_URL=https://seo-eranosian.com
# Optional. Leave empty to use the bundled /send.php (PHP hosting) which e-mails enquiries.
# Set to a Formspree / Web3Forms URL to use a third-party service instead.
PUBLIC_FORM_ENDPOINT=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
PUBLIC_GA_ID=
# Google Search Console HTML-tag verification token
PUBLIC_GSC_VERIFICATION=
