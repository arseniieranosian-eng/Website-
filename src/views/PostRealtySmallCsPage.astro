---
// Blog article N3 "Má SEO smysl pro malou realitní kancelář?" (cs), brief of 23.10.2026. Content: data/post-realty-small-cs.ts.
// Published 24. 10. 2026 (the author's date): the visible "Aktualizováno" and dateModified never precede it. The quote is confirmed; no observations, no portal names, no figures.
import Base from '../layouts/Base.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { postRealtySmallSchemas } from '../lib/schema-post-realty-small';
import { POST_REALTY_SMALL_CS as C, POST_REALTY_SMALL_PUBLISHED } from '../data/post-realty-small-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = [lastModified(['src/views/PostRealtySmallCsPage.astro', 'src/data/post-realty-small-cs.ts'], '2026-10-22'), POST_REALTY_SMALL_PUBLISHED].sort().pop()!;
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-ma-seo-smysl-realitni-kancelar.png';
const cite = new URL(t('postRealtySmall'), site).href;
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
---
<Base {...pageProps('postRealtySmall', lang)} ogType="article" ogImage={OG} schema={postRealtySmallSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postRealtySmall.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
      <p class="lead">{C.lead}</p>
      <p>{C.forWhom}</p>
      <p class="muted small">{C.tocTitle}:</p>
      <ol class="toc">{C.toc.map((x) => <li><a href={`#${x.id}`}>{x.text}</a></li>)}</ol>
    </div>
  </section>

  <section class="section section--tight" id="komu">
    <div class="container narrow">
      <h2>{C.forTitle}</h2>
      <p class="answer">{C.forAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.forTable.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.forTable.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p class="muted small">{C.forNote}</p>
    </div>
  </section>

  <section class="section section--grey" id="konkurence">
    <div class="container narrow">
      <h2>{C.rivalsTitle}</h2>
      <p class="answer">{C.rivalsAnswer}</p>
    </div>
  </section>

  <section class="section" id="cile">
    <div class="container narrow">
      <h2>{C.goalsTitle}</h2>
      <p class="answer">{C.goalsAnswer}</p>
    </div>
  </section>

  <section class="section section--grey" id="kontrola">
    <div class="container narrow">
      <h2>{C.checkTitle}</h2>
      <p class="answer">{C.checkAnswer}</p>
      <ol class="checks">{C.check.map((x) => <li>{x}</li>)}</ol>
      <p>{C.checkLead}{' '}<a href={t('postRealtyNoLeads')}>{C.checkLinkText}</a> {C.checkAuditLead}{' '}<a href={t('audit')}>{C.checkAuditLinkText}</a>.</p>
    </div>
  </section>

  <section class="section" id="cas">
    <div class="container narrow">
      <h2>{C.timeTitle}</h2>
      <p class="answer">{C.timeAnswer}</p>
      <p>{C.timeLead}{' '}<a href={t('start')}>{C.timeStart}</a>{' '}a{' '}<a href={t('fullSeo')}>{C.timeFull}</a>.</p>
    </div>
  </section>

  <section class="section section--grey" id="kanal">
    <div class="container narrow">
      <h2>{C.channelTitle}</h2>
      <p class="answer">{C.channelAnswer}</p>
      <p>{C.channelLead}{' '}<a href={t('postRealty')}>{C.channelLinkText}</a>.</p>
    </div>
  </section>

  <section class="section" id="krok">
    <div class="container narrow">
      <h2>{C.stepTitle}</h2>
      <p class="answer">{C.stepAnswer}</p>
      <p>{C.stepConsultingLead}{' '}<a href={t('consulting')}>{C.stepConsultingLink}</a>. {C.stepLandingLead}{' '}<a href={t('nicheRealty')}>{C.stepLandingLinkText}</a>.</p>
      <figure class="quote-fig">
        <blockquote cite={cite}><p>{C.quote}</p></blockquote>
        <QuoteCaption lang={lang} />
      </figure>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p>{f.links && <p class="small">{f.links.map((l, i) => <>{i > 0 && ' · '}<a class="link-arrow" href={t(l.page)}>{l.text}</a></>)}</p>}</div>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.endTitle}</h2>
      <p>{C.endText}</p>
      <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('audit')}>{C.cta}</a></div>
      <p>{C.endConsulting}{' '}<a href={t('consulting')}>{C.endConsultingLink}</a>.</p>
      <p class="muted">{C.authorNote} <a href={t('about')}>{C.authorLinkText}</a>.</p>
    </div>
  </section>
</Base>
