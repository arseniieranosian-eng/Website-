---
// Russian mini-case "Разбор сайта агентства недвижимости в Праге" (ru), brief of 23.10.2026: a review, not a result. Content: data/case-razbor-ru.ts.
// One quote (the author's); no client quote; no figures; no blog links.
import Base from '../layouts/Base.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { caseRazborSchemas } from '../lib/schema-case-razbor';
import { CASE_RAZBOR_RU as C } from '../data/case-razbor-ru';

const lang = C.lang;
const site = Astro.site!;
const MOD = lastModified(['src/views/CaseRazborRuPage.astro', 'src/data/case-razbor-ru.ts'], '2026-10-23');
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${String(d).padStart(2, '0')}.${String(mo).padStart(2, '0')}.${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const cite = new URL(t('caseRazbor'), site).href;
---
<Base {...pageProps('caseRazbor', lang)} ogType="article" schema={caseRazborSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <p class="eyebrow">{C.label}</p>
      <h1>{META.caseRazbor.ru.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time></p>
      <p class="lead">{C.lead}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.whoTitle}</h2>
      <p class="answer">{C.whoAnswer}</p>
      <p>{C.whoText}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.howTitle}</h2>
      <p class="answer">{C.howAnswer}</p>
      <p><a class="link-arrow" href={t('consulting')}>{C.howLink}</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.seenTitle}</h2>
      <p class="answer">{C.seenAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.table.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p class="muted small">{C.tableNote}</p>
      {C.slides.map((s) => (
        <figure class="case-figure">
          <img src={s.src} width={s.width} height={s.height} alt={s.alt} loading="lazy" decoding="async" />
        </figure>
      ))}
      <p class="muted small">{C.slidesCaption}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.rivalsTitle}</h2>
      <p class="answer">{C.rivalsAnswer}</p>
      <p>{C.rivalsText}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.dirTitle}</h2>
      <p class="answer">{C.dirAnswer}</p>
      {C.directions.map((x) => <><h3>{x.h}</h3><p>{x.text}</p></>)}
      <figure class="quote-fig" style="margin-top: 28px">
        <blockquote cite={cite}><p>{C.quote}</p></blockquote>
        <QuoteCaption lang={lang} />
      </figure>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.planTitle}</h2>
      <p class="answer">{C.planAnswer}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.unknownTitle}</h2>
      <p class="answer">{C.unknownAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.anyTitle}</h2>
      <p class="answer">{C.anyAnswer}</p>
      <ul class="checks">{C.any.map((x) => <li>{x}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p>{f.link && <p><a class="link-arrow" href={t(f.link)}>{f.linkText}</a>{f.link2 && <>{' · '}<a class="link-arrow" href={t(f.link2)}>{f.linkText2}</a></>}</p>}</div>)}</div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.relatedTitle}</h2>
      {C.related.map((n) => <p><a class="link-arrow" href={t(n.key)}>{n.text}</a></p>)}
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.ctaTitle}</h2>
      <p>{C.ctaText}</p>
      <div class="btn-row">
        <a class="btn btn--primary btn--lg" href={t('consulting')}>{C.ctaConsulting}</a>
        <a class="btn btn--secondary btn--lg" href={t('audit')}>{C.ctaAudit}</a>
      </div>
    </div>
  </section>
</Base>
