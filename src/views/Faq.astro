---
import Base from '../layouts/Base.astro';
import CzechNote from '../components/CzechNote.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { META } from '../i18n/meta';
import { path, type Lang } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { FAQ } from '../data/faq';
import { faqSchema } from '../lib/schema';
import { FAQ_PAGE_GROUPS, FAQ_PAGE_UPDATED, FAQ_PAGE_PUBLISHED } from '../data/faq-page-cs';
import { FAQ_PAGE_RU_GROUPS, FAQ_PAGE_RU_UPDATED, FAQ_PAGE_RU_PUBLISHED } from '../data/faq-page-ru';
import { FAQ_PAGE_UK_GROUPS, FAQ_PAGE_UK_UPDATED, FAQ_PAGE_UK_PUBLISHED } from '../data/faq-page-uk';

interface Props { lang: Lang }
const { lang } = Astro.props;
const m = META.faq[lang];
const C = {
  cs: { lead: 'Nenašli jste odpověď? Napište mi.', link: 'Kontakt', ctaTitle: 'Máte jinou otázku?', ctaText: 'Odpovím do jednoho pracovního dne.' },
  en: { lead: 'Didn’t find your answer? Write to me.', link: 'Contact', ctaTitle: 'Have another question?', ctaText: 'I reply within one business day.' },
  ru: { lead: 'Не нашли ответ? Напишите мне.', link: 'Контакты', ctaTitle: 'Остались вопросы?', ctaText: 'Отвечу в течение одного рабочего дня.' },
  uk: { lead: 'Не знайшли відповідь? Напишіть мені.', link: 'Контакти', ctaTitle: 'Залишилися питання?', ctaText: 'Відповім протягом одного робочого дня.' },
}[lang];
// cs, ru and uk have the rebuilt page (6 groups, questions as H3, contents, byline); en keeps the old list.
const PAGES = {
  cs: { groups: FAQ_PAGE_GROUPS, upd: FAQ_PAGE_UPDATED, pub: FAQ_PAGE_PUBLISHED, by: ['Autor', 'Arsenii Eranosian', 'Zveřejněno', 'Aktualizováno'], toc: ['Obsah stránky', 'Na stránce najdete:'] },
  ru: { groups: FAQ_PAGE_RU_GROUPS, upd: FAQ_PAGE_RU_UPDATED, pub: FAQ_PAGE_RU_PUBLISHED, by: ['Автор', 'Арсений Ераносьян', 'Опубликовано', 'Обновлено'], toc: ['Содержание страницы', 'На странице:'] },
  uk: { groups: FAQ_PAGE_UK_GROUPS, upd: FAQ_PAGE_UK_UPDATED, pub: FAQ_PAGE_UK_PUBLISHED, by: ['Автор', 'Арсеній Ераносян', 'Опубліковано', 'Оновлено'], toc: ['Зміст сторінки', 'На сторінці:'] },
} as const;
const PG = (PAGES as any)[lang] as (typeof PAGES)['cs'] | undefined;
const isNew = !!PG;
const fmt = (iso: string) => { const [y, mo, d] = iso.split('-').map(Number); return lang === 'cs' ? `${d}. ${mo}. ${y}` : `${String(d).padStart(2, '0')}.${String(mo).padStart(2, '0')}.${y}`; };
// Czech page: 6 groups with questions as H3; "{key|text}" in an answer is a link; the JSON-LD gets the plain text (Base derives it from the visible page anyway).
const linkParts = (a: string) => a.split(/(\{[a-zA-Z]+\|[^}]+\})/).filter(Boolean).map((p) => {
  const m = p.match(/^\{([a-zA-Z]+)\|([^}]+)\}$/);
  return m ? { href: path(m[1] as Parameters<typeof path>[0], lang), text: m[2] } : { text: p };
});
const plainA = (a: string) => a.replace(/\{[a-zA-Z]+\|([^}]+)\}/g, '$1');
const csItems = (PG ? PG.groups : []).flatMap((g) => g.items.map((i) => ({ id: '', pages: [], q: { cs: i.q }, a: { cs: plainA(i.a) } })));
const lng = lang as any;
---
{isNew ? (
  <Base {...pageProps('faq', lang)} schema={[faqSchema(csItems as any, 'cs')]}>
    <section class="page-hero">
      <div class="container narrow">
        <h1>{m.h1}</h1>
        <p class="updated">{PG!.by[0]}: <a href={path('about', lang)}>{PG!.by[1]}</a> · {PG!.by[2]}: <time datetime={PG!.pub}>{fmt(PG!.pub)}</time> · {PG!.by[3]}: <time datetime={PG!.upd}>{fmt(PG!.upd)}</time></p>
        <p class="lead">{C.lead}{' '}<a class="link-arrow" href={path('contact', lang)}>{C.link}</a></p>
        <nav class="toc" aria-label={PG!.toc[0]}><p class="toc-title">{PG!.toc[1]}</p><ul>{PG!.groups.map((g) => <li><a href={`#${g.id}`}>{g.title}</a></li>)}</ul></nav>
      </div>
    </section>
    {PG!.groups.map((g, i) => (
      <section class={i % 2 === 0 ? 'section section--tight' : 'section section--grey'}>
        <div class="container narrow">
          <h2 id={g.id}>{g.title}</h2>
          <div class="faq-open">{g.items.map((f) => <div><h3>{f.q}</h3><p>{linkParts(f.a).map((p) => p.href ? <a href={p.href}>{p.text}</a> : p.text)}</p></div>)}</div>
        </div>
      </section>
    ))}
    <CtaBand lang={lang} title={C.ctaTitle} text={C.ctaText} id="jina-otazka" />
    <CzechNote lang={lang} pageKey={'faq'} />
  </Base>
) : (
  <Base {...pageProps('faq', lang)} schema={[faqSchema(FAQ, lang)]}>
    <PageHero h1={m.h1} lead={C.lead}><a class="link-arrow" href={path('contact', lang)}>{C.link}</a></PageHero>
    <section class="section section--tight">
      <div class="container narrow">
        <FaqList items={FAQ} lang={lang} />
        {lang === 'en' && <p><a class="link-arrow" href={path('consulting', lang)}>More questions about the paid SEO consultation: SEO consulting in Prague</a></p>}
      </div>
    </section>
    <CtaBand lang={lang} title={C.ctaTitle} text={C.ctaText} />
    <CzechNote lang={lang} pageKey={'faq'} />
  </Base>
)}
