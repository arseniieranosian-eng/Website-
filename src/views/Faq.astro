---
import Base from '../layouts/Base.astro';
import CzechNote from '../components/CzechNote.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { META } from '../i18n/meta';
import { path, type Lang } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { FAQ } from '../data/faq';
import { faqSchema } from '../lib/schema';
import { FAQ_PAGE_GROUPS, FAQ_PAGE_UPDATED } from '../data/faq-page-cs';

interface Props { lang: Lang }
const { lang } = Astro.props;
const m = META.faq[lang];
const C = {
  cs: { lead: 'Nenašli jste odpověď? Napište mi.', link: 'Kontakt', ctaTitle: 'Máte jinou otázku?', ctaText: 'Odpovím do jednoho pracovního dne.' },
  en: { lead: 'Didn’t find your answer? Write to me.', link: 'Contact', ctaTitle: 'Have another question?', ctaText: 'I reply within one business day.' },
  ru: { lead: 'Не нашли ответ? Напишите мне.', link: 'Контакты', ctaTitle: 'Остались вопросы?', ctaText: 'Отвечу в течение одного рабочего дня.' },
  uk: { lead: 'Не знайшли відповідь? Напишіть мені.', link: 'Контакти', ctaTitle: 'Залишилися питання?', ctaText: 'Відповім протягом одного робочого дня.' },
}[lang];
const isCs = lang === 'cs';
const [uy, um, ud] = FAQ_PAGE_UPDATED.split('-').map(Number);
// Czech page: 6 groups with questions as H3; "{key|text}" in an answer is a link; the JSON-LD gets the plain text (Base derives it from the visible page anyway).
const linkParts = (a: string) => a.split(/(\{[a-zA-Z]+\|[^}]+\})/).filter(Boolean).map((p) => {
  const m = p.match(/^\{([a-zA-Z]+)\|([^}]+)\}$/);
  return m ? { href: path(m[1] as Parameters<typeof path>[0], lang), text: m[2] } : { text: p };
});
const plainA = (a: string) => a.replace(/\{[a-zA-Z]+\|([^}]+)\}/g, '$1');
const csItems = FAQ_PAGE_GROUPS.flatMap((g) => g.items.map((i) => ({ id: '', pages: [], q: { cs: i.q }, a: { cs: plainA(i.a) } })));
---
{isCs ? (
  <Base {...pageProps('faq', lang)} schema={[faqSchema(csItems as any, 'cs')]}>
    <section class="page-hero">
      <div class="container narrow">
        <h1>{m.h1}</h1>
        <p class="updated">Autor: <a href={path('about', lang)}>Arsenii Eranosian</a> · Aktualizováno: <time datetime={FAQ_PAGE_UPDATED}>{ud}. {um}. {uy}</time></p>
        <p class="lead">{C.lead}{' '}<a class="link-arrow" href={path('contact', lang)}>{C.link}</a></p>
        <nav class="toc" aria-label="Obsah stránky"><p class="toc-title">Na stránce najdete:</p><ul>{FAQ_PAGE_GROUPS.map((g) => <li><a href={`#${g.id}`}>{g.title}</a></li>)}</ul></nav>
      </div>
    </section>
    {FAQ_PAGE_GROUPS.map((g, i) => (
      <section class={i % 2 === 0 ? 'section section--tight' : 'section section--grey'}>
        <div class="container narrow">
          <h2 id={g.id}>{g.title}</h2>
          <div class="faq-open">{g.items.map((f) => <div><h3>{f.q}</h3><p>{linkParts(f.a).map((p) => p.href ? <a href={p.href}>{p.text}</a> : p.text)}</p></div>)}</div>
        </div>
      </section>
    ))}
    <CtaBand lang={lang} title={C.ctaTitle} text={C.ctaText} id="jina-otazka" />
    <CzechNote lang={lang} pageKey={'faq'} />
  </Base>
) : (
  <Base {...pageProps('faq', lang)} schema={[faqSchema(FAQ, lang)]}>
    <PageHero h1={m.h1} lead={C.lead}><a class="link-arrow" href={path('contact', lang)}>{C.link}</a></PageHero>
    <section class="section section--tight">
      <div class="container narrow">
        <FaqList items={FAQ} lang={lang} />
        {lang === 'en' && <p><a class="link-arrow" href={path('consulting', lang)}>More questions about the paid SEO consultation: SEO consulting in Prague</a></p>}
      </div>
    </section>
    <CtaBand lang={lang} title={C.ctaTitle} text={C.ctaText} />
    <CzechNote lang={lang} pageKey={'faq'} />
  </Base>
)}
