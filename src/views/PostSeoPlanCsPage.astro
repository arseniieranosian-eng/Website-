---
// Blog article K3 "Jak vypadá SEO plán na 12 měsíců a co má obsahovat?" (cs), brief of 26.10.2026. Content: data/post-seo-plan-cs.ts.
// Informational: no prices, no CTA, no audit link, the closing block is one link to the landing page.
import Base from '../layouts/Base.astro';
import PostCta from '../components/PostCta.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { postSeoPlanSchemas } from '../lib/schema-post-seo-plan';
import { POST_SEO_PLAN_CS as C, POST_SEO_PLAN_PUBLISHED } from '../data/post-seo-plan-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = [lastModified(['src/views/PostSeoPlanCsPage.astro', 'src/data/post-seo-plan-cs.ts'], '2026-10-28'), POST_SEO_PLAN_PUBLISHED].sort().pop()!;
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-seo-plan-na-12-mesicu.png';
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
---
<Base {...pageProps('postSeoPlan', lang)} ogType="article" ogImage={OG} schema={postSeoPlanSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postSeoPlan.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel} <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
      <p class="lead">{C.lead}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.whatTitle}</h2>
      <p class="answer">{C.whatAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.partsTitle}</h2>
      <p class="answer">{C.partsAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.partsTable.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.partsTable.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p class="muted small">{C.partsNote}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.auditTitle}</h2>
      <p class="answer">{C.auditAnswerBefore}{' '}<a href={t('postSeoAudit')}>{C.auditLinkText}</a>{C.auditAnswerAfter}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.stagesTitle}</h2>
      <p class="answer">{C.stagesAnswer}</p>
      {C.stages.map((x) => <><h3>{x.h}</h3><p>{x.text}</p></>)}
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.prioTitle}</h2>
      <p class="answer">{C.prioAnswer}</p>
      <p>{C.prioLead}</p>
      <ul class="checks">{C.prio.map((x) => <li>{x}</li>)}</ul>
      <p class="muted small">{C.listNote}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.measureTitle}</h2>
      <p class="answer">{C.measureAnswer}</p>
      <p>{C.measureLead}</p>
      <ul class="checks">{C.measure.map((x) => <li>{x}</li>)}</ul>
      <p class="muted small">{C.listNote}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.diffTitle}</h2>
      <p class="answer">{C.diffAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.takeTitle}</h2>
      <p class="answer">{C.takeAnswer}</p>
      <p>{C.takeLead}</p>
      <ul class="checks">{C.take.map((x) => <li>{x}</li>)}</ul>
      <p class="muted small">{C.listNote}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3>{f.linkAfter ? <p>{f.a.split(f.linkAfter)[0]}<a href={t(f.linkKey)}>{f.linkAfter}</a>{f.a.split(f.linkAfter)[1]}</p> : <p>{f.a}</p>}</div>)}</div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.relatedTitle}</h2>
      <ul class="link-list">
        <li><a href={t('postChoose')}>{META.postChoose.cs.h1}</a></li>
      </ul>
      <p class="muted">{C.endBefore}{' '}<a href={t('consulting')}>{C.endLinkText}</a>.</p>
    </div>
  </section>


  <section class="section">
    <div class="container narrow">
      <PostCta lang={lang} postKey="postSeoPlan" />
    </div>
  </section>
</Base>
