---
// Blog article U2 "Proč web účetní kanceláře nepřináší poptávky?" (cs), brief of 26.10.2026. Content: data/post-accounting-noleads-cs.ts.
// Diagnostic, informational: no prices, no CTA, no audit link; the closing block is one link to the landing page.
import Base from '../layouts/Base.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { postAccountingNoLeadsSchemas } from '../lib/schema-post-accounting-noleads';
import { POST_ACCOUNTING_NOLEADS_CS as C, POST_ACCOUNTING_NOLEADS_PUBLISHED } from '../data/post-accounting-noleads-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = [lastModified(['src/views/PostAccountingNoLeadsCsPage.astro', 'src/data/post-accounting-noleads-cs.ts'], '2026-10-26'), POST_ACCOUNTING_NOLEADS_PUBLISHED].sort().pop()!;
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-proc-web-ucetni-kancelare-neprinasi-poptavky.png';
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
---
<Base {...pageProps('postAccountingNoLeads', lang)} ogType="article" ogImage={OG} schema={postAccountingNoLeadsSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postAccountingNoLeads.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel} <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
      <p class="lead">{C.leadBefore}{' '}<a href={t('postAccountingChannels')}>{C.leadLinkText}</a>.</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.findTitle}</h2>
      <p class="answer">{C.findAnswerBefore}{' '}<a href={t('postNotShown')}>{C.findLinkText}</a>{C.findAnswerAfter}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.whoTitle}</h2>
      <p class="answer">{C.whoAnswer}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.whatTitle}</h2>
      <p class="answer">{C.whatAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.contactTitle}</h2>
      <p class="answer">{C.contactAnswer}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.trustTitle}</h2>
      <p class="answer">{C.trustAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.wordsTitle}</h2>
      <p class="answer">{C.wordsAnswer}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.sourceTitle}</h2>
      <p class="answer">{C.sourceAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.startTitle}</h2>
      <p class="answer">{C.startAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.table.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p>{C.checklistLead}</p>
      <ul class="checks">{C.checklist.map((x) => <li>{x}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}</div>
      <p class="muted">{C.endText}{' '}<a href={t('nicheAccounting')}>{C.endLinkText}</a>. {C.endText2}</p>
    </div>
  </section>
</Base>
