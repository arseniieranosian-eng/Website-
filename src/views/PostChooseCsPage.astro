---
// Blog article "Audit zdarma, konzultace, nebo Start: co si vybrat jako první krok v SEO" (cs), brief of 21.10.2026. Content: data/post-choose-cs.ts.
// One button (the free audit, at the end); the services are plain text links. No prices.
import Base from '../layouts/Base.astro';
import IndexIllustration from '../components/IndexIllustration.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { postChooseSchemas } from '../lib/schema-post-choose';
import { POST_CHOOSE_CS as C } from '../data/post-choose-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = lastModified(['src/views/PostChooseCsPage.astro', 'src/data/post-choose-cs.ts', 'src/components/IndexIllustration.astro'], '2026-10-21');
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-audit-konzultace-nebo-start.png';
const cite = new URL(t('postChoose'), site).href;
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
---
<Base {...pageProps('postChoose', lang)} ogType="article" ogImage={OG} schema={postChooseSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postChoose.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
      <p class="lead">{C.lead}</p>
      <p>{C.forWhom}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.pickTitle}</h2>
      <p class="answer">{C.pickAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.pick.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.pick.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p class="muted small">{C.pickNote}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.freeTitle}</h2>
      <p class="answer">{C.freeAnswer}</p>
      <p>{C.freeNotLead}</p>
      <ul class="checks">{C.freeNot.map((x) => <li>{x}</li>)}</ul>
      <p>{C.freeLead} <a href={t('postSeoAudit')}>{C.freeLinkText}</a>.</p>
      <p><a class="link-arrow" href={t('audit')}>{C.freeAuditLink}</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.consTitle}</h2>
      <p class="answer">{C.consAnswer}</p>
      <p>{C.consText}</p>
      <p><a class="link-arrow" href={t('consulting')}>{C.consLinkText}</a></p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.startTitle}</h2>
      <p class="answer">{C.startAnswer}</p>
      <p>{C.startText}</p>
      <p><a class="link-arrow" href={t('start')}>{C.startLinkText}</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.laterTitle}</h2>
      <p class="answer">{C.laterAnswer}</p>
      <ul class="checks">{C.later.map((x) => <li>{x}</li>)}</ul>
      <p>{C.laterGeoLead} <a href={t('geo')}>{C.laterGeoLink}</a>.</p>
      <p><a class="link-arrow" href={t('fullSeo')}>{C.fullLinkText}</a> · <a class="link-arrow" href={t('maps')}>{C.mapsLinkText}</a></p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.mustTitle}</h2>
      <p class="answer">{C.mustAnswer}</p>
      <p>{C.mustText}</p>
      <figure class="quote-fig">
        <blockquote cite={cite}><p>{C.quote}</p></blockquote>
        <QuoteCaption lang={lang} />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.flowTitle}</h2>
      <p class="answer">{C.flowAnswer}</p>
      <figure class="post-figure"><IndexIllustration kind={C.flowFigure.kind} aria={C.flowFigure.aria} /><figcaption>{C.flowFigure.caption}</figcaption></figure>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.askTitle}</h2>
      <p class="answer">{C.askAnswer}</p>
      <ul class="checks">{C.ask.map((x) => <li>{x}</li>)}</ul>
      <p>{C.askFlags}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}</div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.endTitle}</h2>
      <p>{C.endText}</p>
      <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('audit')}>{C.cta}</a></div>
      <p>{C.alsoLead} <a href={t('consulting')}>{C.consLinkText}</a>, <a href={t('start')}>{C.startLinkText}</a>, <a href={t('fullSeo')}>{C.fullLinkText}</a>, <a href={t('maps')}>{C.mapsLinkText}</a>.</p>
      <p class="muted">{C.authorNote} <a href={t('about')}>{C.authorLinkText}</a>.</p>
    </div>
  </section>
</Base>
