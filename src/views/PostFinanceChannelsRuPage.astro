---
// Blog article F1 "Как получить клиентов финансовому консультанту в Чехии: обзор каналов" (ru), brief of 24.10.2026. Content: data/post-finance-channels-ru.ts.
import Base from '../layouts/Base.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { postFinanceChannelsSchemas } from '../lib/schema-post-finance-channels';
import { POST_FINANCE_CHANNELS_RU as C, POST_FINANCE_CHANNELS_PUBLISHED } from '../data/post-finance-channels-ru';

const lang = C.lang;
const site = Astro.site!;
const MOD = [lastModified(['src/views/PostFinanceChannelsRuPage.astro', 'src/data/post-finance-channels-ru.ts'], '2026-10-24'), POST_FINANCE_CHANNELS_PUBLISHED].sort().pop()!;
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${String(d).padStart(2, '0')}.${String(mo).padStart(2, '0')}.${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-kak-poluchit-klientov-finansovomu-konsultantu.png';
const cite = new URL(t('postFinanceChannels'), site).href;
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
---
<Base {...pageProps('postFinanceChannels', lang)} ogType="article" ogImage={OG} schema={postFinanceChannelsSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postFinanceChannels.ru.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
      <p class="lead">{C.lead}</p>
      <p class="muted small">{C.tocTitle}:</p>
      <ol class="toc">{C.toc.map((x) => <li><a href={`#${x.id}`}>{x.text}</a></li>)}</ol>
    </div>
  </section>

  <section class="section section--tight" id="kanaly">
    <div class="container narrow">
      <h2>{C.channelsTitle}</h2>
      <p class="answer">{C.channelsAnswer}</p>
      <div class="table-wrap">
        <table class="compare compare--4">
          <thead><tr>{C.channels.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.channels.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}{r[0] === 'Карты' && i === 1 && <>{' '}(<a href={t('maps')}>{C.channels.mapsLink}</a>)</>}</td>)}</tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--grey" id="rekomendacii">
    <div class="container narrow">
      <h2>{C.recTitle}</h2>
      <p class="answer">{C.recAnswer}</p>
      <p>{C.recText}{' '}<a href={t('reviews')}>{C.recLink}</a>.</p>
    </div>
  </section>

  <section class="section" id="socseti">
    <div class="container narrow">
      <h2>{C.socTitle}</h2>
      <p class="answer">{C.socAnswer}</p>
    </div>
  </section>

  <section class="section section--grey" id="reklama">
    <div class="container narrow">
      <h2>{C.adsTitle}</h2>
      <p class="answer">{C.adsAnswer}</p>
    </div>
  </section>

  <section class="section" id="sajt">
    <div class="container narrow">
      <h2>{C.siteTitle}</h2>
      <p class="answer">{C.siteAnswer}</p>
      <p>{C.siteObservation}</p>
      <p>{C.siteLead}{' '}<a href={t('nicheFinance')}>{C.siteLinkText}</a>. {C.siteAudit}{' '}<a href={t('audit')}>{C.siteAuditLink}</a>. {C.siteFormats}{' '}<a href={t('start')}>{C.siteStart}</a>{' '}{C.siteOr}{' '}<a href={t('fullSeo')}>{C.siteFull}</a>.</p>
      <figure class="quote-fig">
        <blockquote cite={cite}><p>{C.quote}</p></blockquote>
        <QuoteCaption lang={lang} />
      </figure>
    </div>
  </section>

  <section class="section section--grey" id="vybor">
    <div class="container narrow">
      <h2>{C.chooseTitle}</h2>
      <p class="answer">{C.chooseAnswer}</p>
      <p>{C.chooseLead}</p>
      <ul class="checks">{C.choose.map((x) => <li>{x}</li>)}</ul>
    </div>
  </section>

  <section class="section" id="start">
    <div class="container narrow">
      <h2>{C.startTitle}</h2>
      <p class="answer">{C.startAnswer}</p>
      <ol class="steps">{C.start.map((x) => <li><span>{x}</span></li>)}</ol>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p>{f.links && <p class="small">{f.links.map((l, i) => <>{i > 0 && ' · '}<a class="link-arrow" href={t(l.page)}>{l.text}</a></>)}</p>}</div>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.endTitle}</h2>
      <p>{C.endText}</p>
      <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('audit')}>{C.cta}</a></div>
      <p>{C.endNote}{' '}<a href={t('consulting')}>{C.endConsultingLink}</a>.</p>
    </div>
  </section>
</Base>
