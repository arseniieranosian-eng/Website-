---
// Blog article "Jak získat pacienty pro zubní ordinaci: přehled kanálů" (cs), brief B6 of 07.11.2026. Content: data/post-dental-channels-cs.ts.
// Informational: the only body link is the one to the FAQ article (rule F); the author's quote (rule J) is a plain blockquote without Quotation markup; the closing block has ONE button (rule H).
import Base from '../layouts/Base.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { postDentalChannelsSchemas } from '../lib/schema-post-dental-channels';
import { POST_DENTAL_CHANNELS_CS as C, POST_DENTAL_CHANNELS_PUBLISHED } from '../data/post-dental-channels-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = [lastModified(['src/views/PostDentalChannelsCsPage.astro', 'src/data/post-dental-channels-cs.ts'], '2026-11-07'), POST_DENTAL_CHANNELS_PUBLISHED].sort().pop()!;
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-jak-ziskat-pacienty-pro-zubni-ordinaci.png';
const cite = new URL(path('postDentalChannels', lang), site).href;
---
<Base {...pageProps('postDentalChannels', lang)} ogType="article" ogImage={OG} schema={postDentalChannelsSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postDentalChannels.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time> · {C.readLabel}: 5 {C.readUnit}</p>
      <p class="lead">{C.lead}</p>
    </div>
  </section>

  <section class="section section--tight" id="kanaly">
    <div class="container narrow">
      <h2>{C.channelsTitle}</h2>
      <p class="answer">{C.channelsAnswer}</p>
      <p class="muted small">{C.tableCaption}</p>
      <div class="table-wrap">
        <table class="compare compare--4">
          <thead><tr>{C.channels.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.channels.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--grey" id="doporuceni">
    <div class="container narrow">
      <h2>{C.recTitle}</h2>
      <p class="answer">{C.recAnswer}</p>
    </div>
  </section>

  <section class="section" id="web">
    <div class="container narrow">
      <h2>{C.webTitle}</h2>
      <p class="answer">{C.webAnswer}</p>
      <p>{C.webLink.before}{' '}<a href={t('postFaqDental')}>{C.webLink.text}</a>{C.webLink.after}</p>
    </div>
  </section>

  <section class="section section--grey" id="mapy">
    <div class="container narrow">
      <h2>{C.mapsTitle}</h2>
      <p class="answer">{C.mapsAnswer}</p>
    </div>
  </section>

  <section class="section" id="reklama">
    <div class="container narrow">
      <h2>{C.adsTitle}</h2>
      <p class="answer">{C.adsAnswer}</p>
      <figure class="quote-fig">
        <blockquote cite={cite}><p>{C.quote}</p></blockquote>
        <QuoteCaption lang={lang} />
      </figure>
    </div>
  </section>

  <section class="section section--grey" id="vyber">
    <div class="container narrow">
      <h2>{C.chooseTitle}</h2>
      <p class="answer">{C.chooseAnswer}</p>
    </div>
  </section>

  <section class="section" id="start">
    <div class="container narrow">
      <h2>{C.startTitle}</h2>
      <p class="answer">{C.startAnswer}</p>
      <ol class="steps">{C.start.map((x) => <li><span>{x}</span></li>)}</ol>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <p class="muted">{C.disclosure}</p>
      <div class="post-cta">
        <p class="post-cta__title">{C.endTitle}</p>
        <p class="post-cta__text">{C.endText}</p>
        <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('nicheDental')}>{C.endCta}</a></div>
      </div>
    </div>
  </section>
</Base>
