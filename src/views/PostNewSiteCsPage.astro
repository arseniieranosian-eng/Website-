---
// Blog article "Nový web a Google ho nevidí: jak dlouho trvá indexace a co udělat" (cs), brief of 21.10.2026. Content: data/post-newsite-cs.ts.
// One main CTA (free audit). Waiting time only "dny až týdny"; Seznam: one general sentence.
import Base from '../layouts/Base.astro';
import IndexIllustration from '../components/IndexIllustration.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { postNewSiteSchemas } from '../lib/schema-post-newsite';
import { POST_NEWSITE_CS as C } from '../data/post-newsite-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = lastModified(['src/views/PostNewSiteCsPage.astro', 'src/data/post-newsite-cs.ts', 'src/components/IndexIllustration.astro'], '2026-10-21');
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-novy-web-a-google-ho-nevidi.png';
const cite = new URL(t('postNewSite'), site).href;
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
---
<Base {...pageProps('postNewSite', lang)} ogType="article" ogImage={OG} schema={postNewSiteSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postNewSite.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
      <p class="lead">{C.lead}</p>
      <p>{C.forWhom}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.normalTitle}</h2>
      <p class="answer">{C.normalAnswer}</p>
      <p>{C.normalText}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.howLongTitle}</h2>
      <p class="answer">{C.howLongAnswer}</p>
      <p>{C.howLongLead} <a href="#po-spusteni">{C.howLongLinkText}</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.checkTitle}</h2>
      <p class="answer">{C.checkAnswer}</p>
      <p>{C.checkText} {C.checkLead} <a href={t('postIndexing')}>{C.checkLinkText}</a>.</p>
    </div>
  </section>

  <section class="section section--grey" id="po-spusteni">
    <div class="container narrow">
      <h2>{C.startTitle}</h2>
      <p class="answer">{C.startAnswer}</p>
      <ol class="steps">{C.steps.map((s) => <li><span>{s}</span></li>)}</ol>
      <p>{C.startText}</p>
      <figure class="post-figure"><IndexIllustration kind={C.figures[0].kind} aria={C.figures[0].aria} /><figcaption>{C.figures[0].caption}</figcaption></figure>
      <figure class="post-figure"><IndexIllustration kind={C.figures[1].kind} aria={C.figures[1].aria} /><figcaption>{C.figures[1].caption}</figcaption></figure>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.fasterTitle}</h2>
      <p class="answer">{C.fasterAnswer}</p>
      <ul class="checks">{C.faster.map((x) => <li>{x}</li>)}</ul>
      <p>{C.fasterText}</p>
      <figure class="quote-fig">
        <blockquote cite={cite}><p>{C.quote}</p></blockquote>
        <QuoteCaption lang={lang} />
      </figure>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.weeksTitle}</h2>
      <p class="answer">{C.weeksAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.weeks.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.weeks.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <figure class="post-figure"><IndexIllustration kind={C.figures[2].kind} aria={C.figures[2].aria} /><figcaption>{C.figures[2].caption}</figcaption></figure>
      <p>{C.weeksLead1} <a href={t('postDuplicates')}>{C.weeksLink1}</a>. {C.weeksLead2} <a href={t('postNotShown')}>{C.weeksLink2}</a>.</p>
      <p>{C.bridge}</p>
      <p>{C.border}</p>
      <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('audit')}>{C.cta}</a></div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.avoidTitle}</h2>
      <p class="answer">{C.avoidAnswer}</p>
      <ul class="checks">{C.avoid.map((x) => <li>{x}</li>)}</ul>
      <p>{C.avoidLead} <a href={t('postRedirects')}>{C.avoidLinkText}</a>.</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.seznamTitle}</h2>
      <p class="answer">{C.seznamAnswer}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}</div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.endTitle}</h2>
      <p>{C.endText}</p>
      <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('audit')}>{C.cta}</a></div>
      <p>{C.nextLead} <a class="link-arrow" href={t('postIndexing')}>{C.nextLinkText}</a></p>
      <p class="muted">{C.authorNote} <a href={t('about')}>{C.authorLinkText}</a>.</p>
    </div>
  </section>
</Base>
