---
// /ru/konsultacii/ (ru, brief of 19.10.2026) and /en/consulting/ (en, brief of 23.10.2026); the Czech page is ConsultingCsPage.
// Content lives in data/consulting-ru.ts and data/consulting-en.ts. Neither language has a video any more (removed on the author's instruction); the hero's right column is a decorative illustration.
import Base from '../layouts/Base.astro';
import CzechNote from '../components/CzechNote.astro';
import LogoStrip from '../components/LogoStrip.astro';
import ConsultHeroArt from '../components/ConsultHeroArt.astro';
import ServiceArt from '../components/ServiceArt.astro';
import LeadForm from '../components/LeadForm.astro';
import GeoNote from '../components/GeoNote.astro';
import ReviewCards from '../components/ReviewCards.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { consultingSchemas } from '../lib/schema-consulting';
import { fmtKc, fmtCzk, PRICES } from '../data/consulting-shared';
import { CONSULTING_RU } from '../data/consulting-ru';
import { reviewsWithFallback } from '../data/reviews';
import { serviceByKey } from '../data/services';

interface Props { lang: 'ru' | 'en' }
const { lang } = Astro.props;
const C = CONSULTING_RU;
const money = lang === 'en' ? fmtCzk : fmtKc;
const site = Astro.site!;

// Visible date and JSON-LD dateModified both come from git (see lib/lastmod.ts).
const MOD = lastModified(
  ['src/views/ConsultingPage.astro', 'src/data/consulting-ru.ts', 'src/data/consulting-shared.ts', 'src/data/reviews.ts'],
  '2026-10-19',
);
const [y, mo, d] = MOD.split('-').map(Number);
const modText = lang === 'ru' || lang === 'en' ? `${String(d).padStart(2, '0')}.${String(mo).padStart(2, '0')}.${y}` : `${d}. ${mo}. ${y}`;

// Russian page: prefer reviews that were written in Russian.
const reviews = reviewsWithFallback('consulting', 3, 3, lang === 'ru' ? 'ru' : undefined);
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const name = (k: keyof typeof META) => META[k][lang].name;
const others = [
  { key: 'audit', text: C.audit },
  { key: 'start', text: '' },
  { key: 'fullSeo', text: '' },
  { key: 'maps', text: '' },
] as const;
---
<Base {...pageProps('consulting', lang)} schema={consultingSchemas(site, C, { modified: MOD, reviews })}>
  <!-- HERO -->
  <section class="page-hero">
    <div class="container hero-art-split">
      <div>
        <h1>{C.h1}</h1>
        <p class="updated">{C.updatedLabel}: <time datetime={MOD}>{modText}</time>{C.durationLine && <> · {C.durationLine}</>}</p>
        <p class="lead">{C.lead}</p>
        <div class="btn-row">
          <a class="btn btn--primary btn--lg" href="#form">{C.heroPrimary}</a>
          <a class="btn btn--secondary btn--lg" href={t('audit')}>{C.heroAudit}</a>
        </div>
      </div>
      <ConsultHeroArt />
    </div>
  </section>

  <LogoStrip lang={lang} />

  <!-- PRICE -->
  <section class="section section--tight">
    <div class="container">
      <h2>{C.priceTitle}</h2>
      <p class="answer">{C.priceAnswer}</p>
      {C.priceNote && <p class="muted small price-note">{C.priceNote}</p>}
      <div class="grid grid-2 offers">
        {C.offers.map((o) => (
          <article class="card offer">
            <ServiceArt kind={o.id} size={96} />
            <h3>{o.name}</h3>
            <p class="price"><strong>{money(PRICES[o.id])}</strong> · {o.duration}</p>
            <p>{o.cardText}</p>
            <a class="btn btn--secondary" href="#form" data-prefill={o.prefill}>{o.cta}</a>
          </article>
        ))}
      </div>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr><th scope="col"><span class="sr-only">{C.table.corner}</span></th>{C.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>
            {C.table.rows.map(([label, a, b]) => <tr><th scope="row">{label}</th><td>{a}</td><td>{b}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- WHO IT IS FOR -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.forWhomTitle}</h2>
      {C.forWhomAnswer && <p class="answer">{C.forWhomAnswer}</p>}
      <ul class="checks">{C.forWhom.map((x) => <li>{x}</li>)}</ul>
      <p class="muted">{C.forWhomNote}</p>
    </div>
  </section>

  <!-- WHAT IS INCLUDED (en) -->
  {C.includesTitle && (
    <section class="section">
      <div class="container narrow">
        <h2>{C.includesTitle}</h2>
        <p class="answer">{C.includesAnswer}</p>
        <p><a class="link-arrow" href={t('geo')}>{C.includesGeoLink}</a></p>
      </div>
    </section>
  )}

  <!-- HOW IT WORKS -->
  <section class={C.includesTitle ? 'section section--grey' : 'section'}>
    <div class="container">
      <h2>{C.stepsTitle}</h2>
      {C.stepsAnswer && <p class="answer">{C.stepsAnswer}</p>}
      <ol class="steps steps--row">{C.steps.map((x) => <li>{x}</li>)}</ol>
      {C.examples && <h3 class="examples-title">{C.examplesTitle}</h3>}
      <div class="examples">
        {(C.examples ?? []).map((ex) => (
          <figure class="examples__group">
            <h4>{ex.title}</h4>
            <p class="muted">{ex.text}</p>
            <div class="examples__shots">{ex.images.map((im) => <img src={im.src} alt={im.alt} loading="lazy" decoding="async" />)}</div>
            {ex.caseLink && <p class="muted">{ex.caseLink.text}{' '}<a href={t('caseRazbor')}>{ex.caseLink.link}</a></p>}
          </figure>
        ))}
      </div>
      {C.examplesNote && <p class="muted small">{C.examplesNote}</p>}
    </div>
  </section>

  <!-- WHICH SEARCH MARKET (ru) -->
  {C.market && (
    <section class="section section--grey">
      <div class="container narrow">
        <h2>{C.marketTitle}</h2>
        <p>{C.market}</p>
      </div>
    </section>
  )}

  <!-- ONLINE / IN PERSON -->
  <section class={C.market ? 'section' : 'section section--grey'}>
    <div class="container narrow">
      <h2>{C.channelsTitle}</h2>
      <p class={lang === 'en' ? 'answer' : undefined}>{C.channels}</p>
    </div>
  </section>

  <!-- CONSULTING OR LONG-TERM -->
  <section class={C.market ? 'section section--grey' : 'section'}>
    <div class="container narrow">
      <h2>{C.longTermTitle}</h2>
      {C.longTermAnswer && <p class="answer">{C.longTermAnswer}</p>}
      {C.formatsTable && (
        <div class="table-wrap">
          <table class="compare">
            <thead><tr>{C.formatsTable.head.map((h) => <th scope="col">{h ? h : <span class="sr-only">Format</span>}</th>)}</tr></thead>
            <tbody>{C.formatsTable.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
          </table>
        </div>
      )}
      <p>{C.longTermIntro}</p>
      <ul class="link-list">
        <li><a href={t('start')}>{name('start')}</a></li>
        <li><a href={t('fullSeo')}>{name('fullSeo')}</a></li>
      </ul>
      {C.longTermGeo && <p>{C.longTermGeo.before}<a href={t('geo')}>{C.longTermGeo.link}</a>{C.longTermGeo.after}</p>}
    </div>
  </section>

  <!-- NOT INCLUDED (en) -->
  {C.notIncludedTitle && (
    <section class="section section--grey">
      <div class="container narrow">
        <h2>{C.notIncludedTitle}</h2>
        <p class="answer">{C.notIncludedAnswer}</p>
      </div>
    </section>
  )}

  <!-- CASE -->
  <section class={C.market ? 'section' : 'section section--grey'}>
    <div class="container narrow">
      <h2>{C.caseTitle}</h2>
      {C.caseLabel && <p class="eyebrow">{C.caseLabel}</p>}
      <p>{C.caseText}</p>
      <a class="link-arrow" href={t('caseKb')}>{C.caseLink}</a>
      {C.caseText2 && <p>{C.caseText2}</p>}
      {C.caseLink2 && <a class="link-arrow" href={t('caseTypo')}>{C.caseLink2}</a>}
      {C.caseLink3 && <p><a class="link-arrow" href={t('caseRazbor')}>{C.caseLink3}</a></p>}
    </div>
  </section>

  <!-- REVIEWS (shared data source) -->
  <section class={C.market ? 'section section--grey' : 'section'}>
    <div class="container">
      <div class="section-head"><h2>{C.reviewsTitle}</h2><a class="link-arrow" href={t('reviews')}>{C.reviewsLink}</a></div>
      <ReviewCards reviews={reviews} lang={lang} compact />
    </div>
  </section>

  <!-- FAQ: answers are visible, not hidden in tabs -->
  <section class={C.market ? 'section' : 'section section--grey'}>
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">
        {C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}
      </div>
      <p><a class="link-arrow" href={t('faq')}>{C.faqAll}</a></p>
    </div>
  </section>

  <!-- FORM -->
  <section class={C.market ? 'section section--grey' : 'section'} id="form">
    <div class="container narrow">
      <h2>{C.formTitle}</h2>
      <div class="card"><LeadForm lang={lang} id="service-consulting" service="consulting" /></div>
    </div>
  </section>

  <!-- OTHER SERVICES -->
  <section class={C.market ? 'section' : 'section section--grey'}>
    <div class="container">
      <div class="section-head"><h2>{C.otherTitle}</h2></div>
      <div class="grid grid-3">
        {others.map((o) => (
          <a class="card card--link" href={t(o.key)}>
            <h3>{name(o.key)}</h3>
            <p>{o.text || serviceByKey(o.key as 'start' | 'fullSeo' | 'maps').short[lang]}</p>
            <span class="link-arrow">{C.more}</span>
          </a>
        ))}
      </div>
      <GeoNote lang={lang} />
    </div>
  </section>
  <CzechNote lang={lang} pageKey={'consulting'} />
</Base>

<script>
  // The offer buttons scroll to the form (#form) and pre-fill the message with the chosen offer.
  document.querySelectorAll<HTMLAnchorElement>('a[data-prefill]').forEach((a) =>
    a.addEventListener('click', () => {
      const box = document.querySelector<HTMLTextAreaElement>('#lf-service-consulting-message');
      const own = [...document.querySelectorAll<HTMLAnchorElement>('a[data-prefill]')].map((x) => x.dataset.prefill);
      if (box && (box.value.trim() === '' || own.includes(box.value))) box.value = a.dataset.prefill ?? '';
    }),
  );
</script>
