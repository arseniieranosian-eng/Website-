---
// Blog article "Proč překladatelská agentura nemá poptávky z webu?" (cs), brief B of 22.10.2026. Content: data/post-noleads-cs.ts.
// Niche framing (no city). One main CTA (free audit). No author observations block (none supplied).
import Base from '../layouts/Base.astro';
import IndexIllustration from '../components/IndexIllustration.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { postNoLeadsSchemas } from '../lib/schema-post-noleads';
import { POST_NOLEADS_CS as C } from '../data/post-noleads-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = lastModified(['src/views/PostNoLeadsCsPage.astro', 'src/data/post-noleads-cs.ts', 'src/components/IndexIllustration.astro'], '2026-10-22');
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-proc-prekladatelska-agentura-nema-poptavky.png';
const cite = new URL(t('postNoLeads'), site).href;
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
---
<Base {...pageProps('postNoLeads', lang)} ogType="article" ogImage={OG} schema={postNoLeadsSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postNoLeads.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
      <p class="lead">{C.lead}</p>
      <p>{C.forWhom}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.tableTitle}</h2>
      <ol class="toc">{C.toc.map((x) => <li><a href={`#${x.id}`}>{x.text}</a></li>)}</ol>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.table.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p class="muted small">{C.tableNote}</p>
      <figure class="post-figure"><IndexIllustration kind={C.orderFigure.kind} aria={C.orderFigure.aria} /><figcaption>{C.orderFigure.caption}</figcaption></figure>
    </div>
  </section>

  <section class="section section--grey" id="sezonnost">
    <div class="container narrow">
      <h2>{C.seasonTitle}</h2>
      <p class="answer">{C.seasonAnswer}</p>
      <p>{C.seasonText} <a href={t('caseSeason')}>{C.seasonLinkText}</a>.</p>
    </div>
  </section>

  <section class="section" id="indexace">
    <div class="container narrow">
      <h2>{C.indexTitle}</h2>
      <p class="answer">{C.indexAnswer}</p>
      <p><a class="link-arrow" href={t('postIndexing')}>{C.indexLinkText}</a></p>
    </div>
  </section>

  <section class="section section--grey" id="duplicity">
    <div class="container narrow">
      <h2>{C.dupTitle}</h2>
      <p class="answer">{C.dupAnswer}</p>
      <p><a class="link-arrow" href={t('postDuplicates')}>{C.dupLinkText}</a></p>
    </div>
  </section>

  <section class="section" id="stranky">
    <div class="container narrow">
      <h2>{C.pagesTitle}</h2>
      <p class="answer">{C.pagesAnswer}</p>
      <ul class="checks">{C.pages.map((x) => <li>{x}</li>)}</ul>
      <p>{C.pairsLead}{' '}<a href={t('postPairs')}>{C.pairsLinkText}</a>.</p>
    </div>
  </section>

  <section class="section section--grey" id="firmy">
    <div class="container narrow">
      <h2>{C.b2bTitle}</h2>
      <p class="answer">{C.b2bAnswer}</p>
      <p>{C.b2bLead} <a href={t('postB2b')}>{C.b2bLinkText}</a>.</p>
    </div>
  </section>

  <section class="section" id="zmeny">
    <div class="container narrow">
      <h2>{C.changesTitle}</h2>
      <p class="answer">{C.changesAnswer}</p>
      <p><a class="link-arrow" href={t('postRedesign')}>{C.changesLinkText1}</a> · <a class="link-arrow" href={t('postRedirects')}>{C.changesLinkText2}</a></p>
      <figure class="quote-fig">
        <blockquote cite={cite}><p>{C.quote}</p></blockquote>
        <QuoteCaption lang={lang} />
      </figure>
    </div>
  </section>

  <section class="section section--grey" id="mapy">
    <div class="container narrow">
      <h2>{C.mapsTitle}</h2>
      <p class="answer">{C.mapsAnswer}</p>
    </div>
  </section>

  <section class="section" id="kontakt">
    <div class="container narrow">
      <h2>{C.contactTitle}</h2>
      <p class="answer">{C.contactAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.auditTitle}</h2>
      <p class="answer">{C.auditAnswer}</p>
      <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('audit')}>{C.cta}</a></div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.praguTitle}</h2>
      <p>{C.praguText}</p>
      <p><a class="link-arrow" href={t('nicheTranslation')}>{C.praguLinkText}</a></p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p>{f.links && <p>{f.links.map((l, i) => <>{i > 0 && ' · '}<a class="link-arrow" href={t(l.page)}>{l.text}</a></>)}</p>}</div>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.endTitle}</h2>
      <p>{C.endText}</p>
      <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('audit')}>{C.cta}</a></div>
      <p>{C.clientsLead} <a href={t('postClients')}>{C.clientsLinkText}</a>.</p>
      <p>{C.caseLead} <a href={t('caseHalf')}>{C.caseLinkText}</a>.</p>
      <p class="muted">{C.authorNote} <a href={t('about')}>{C.authorLinkText}</a>.</p>
    </div>
  </section>
</Base>
