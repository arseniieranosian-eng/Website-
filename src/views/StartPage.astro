---
// /ru/start-3-mesyaca/ built from the brief of 19.10.2026. Content: data/start-ru.ts, prices: data/start-shared.ts.
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import GeoNote from '../components/GeoNote.astro';
import ReviewCards from '../components/ReviewCards.astro';
import StartHeroArt from '../components/StartHeroArt.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { startSchemas } from '../lib/schema-start';
import { START_RU as C } from '../data/start-ru';
import { reviewsWithFallback } from '../data/reviews';
import { serviceByKey } from '../data/services';

const lang = C.lang;
const site = Astro.site!;

// Visible date and JSON-LD dateModified both come from git (see lib/lastmod.ts).
const MOD = lastModified(['src/views/StartPage.astro', 'src/data/start-ru.ts', 'src/data/start-shared.ts', 'src/data/reviews.ts'], '2026-10-19');
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${String(d).padStart(2, '0')}.${String(mo).padStart(2, '0')}.${y}`;

// 1-3 reviews tagged with this service; prefer those originally written in Russian.
const reviews = reviewsWithFallback('start', 3, 1, 'ru');
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const name = (k: keyof typeof META) => META[k][lang].name;
const others = [
  { key: 'audit', text: C.audit },
  { key: 'consulting', text: '' },
  { key: 'fullSeo', text: '' },
  { key: 'maps', text: '' },
] as const;
---
<Base {...pageProps('start', lang)} schema={startSchemas(site, C, { modified: MOD, reviews })}>
  <!-- HERO -->
  <section class="page-hero">
    <div class="container hero-art-split">
      <div>
        <p class="eyebrow">{C.slogan}</p>
        <h1>{C.h1}</h1>
        <p class="updated">{C.updatedLabel}: <time datetime={MOD}>{modText}</time></p>
        <p class="lead">{C.lead}</p>
        <p class="price-badge">{C.badge}</p>
        <div class="btn-row">
          <a class="btn btn--primary btn--lg" href="#form">{C.heroPrimary}</a>
          <a class="btn btn--secondary btn--lg" href={t('audit')}>{C.heroAudit}</a>
        </div>
      </div>
      <StartHeroArt />
    </div>
  </section>

  <!-- PRICE -->
  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.priceTitle}</h2>
      <p class="answer">{C.priceAnswer}</p>
      <p class="muted small">{C.priceNote}</p>
    </div>
  </section>

  <!-- WHAT IS INCLUDED -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.includesTitle}</h2>
      <ul class="checks">
        {C.includes.map((i) => {
          const l = i.link;
          if (!l) return <li>{i.text}</li>;
          const [before, after] = i.text.split(l.part);
          return <li><span>{before}<a href={t(l.page)}>{l.part}</a>{after}</span></li>;
        })}
      </ul>
    </div>
  </section>

  <!-- HOW THE WORK GOES -->
  <section class="section">
    <div class="container">
      <h2>{C.stagesTitle}</h2>
      <ol class="steps steps--row">{C.stages.map((st) => <li><span><strong>{st.name}:</strong> {st.text}</span></li>)}</ol>
      <p class="muted">{C.weekly}</p>
    </div>
  </section>

  <!-- RESULTS -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.resultsTitle}</h2>
      <p class="answer">{C.resultsAnswer}</p>
      <p>{C.resultsNote}</p>
    </div>
  </section>

  <!-- WHO IT IS FOR -->
  <section class="section">
    <div class="container narrow">
      <h2>{C.forWhomTitle}</h2>
      <ul class="checks">{C.forWhom.map((x) => <li>{x}</li>)}</ul>
    </div>
  </section>

  <!-- MAPS -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.mapsTitle}</h2>
      <p>{C.maps}</p>
      <p>{C.mapsOnly} <a href={t('maps')}>{name('maps')}</a></p>
    </div>
  </section>

  <!-- START OR FULL SEO -->
  <section class="section">
    <div class="container narrow">
      <h2>{C.compareTitle}</h2>
      <p>{C.compare.before}<a href={t('fullSeo')}>{C.compare.link}</a>{C.compare.after}</p>
      <p>{C.consultingNote.before}<a href={t('consulting')}>{C.consultingNote.link}</a>{C.consultingNote.after}</p>
    </div>
  </section>

  <!-- CASE -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.caseTitle}</h2>
      <p>{C.caseText}</p>
      <a class="link-arrow" href={t('caseKb')}>{C.caseLink}</a>
      <p>{C.caseText2}</p>
      <a class="link-arrow" href={t('caseTypo')}>{C.caseLink2}</a>
      <p>{C.caseText3}</p>
      <a class="link-arrow" href={t('caseEdu')}>{C.caseLink3}</a>
      <p>{C.caseText4}</p>
      <a class="link-arrow" href={t('caseSeason')}>{C.caseLink4}</a>
    </div>
  </section>

  <!-- REVIEWS (shared data source) -->
  <section class="section">
    <div class="container">
      <div class="section-head"><h2>{C.reviewsTitle}</h2><a class="link-arrow" href={t('reviews')}>{C.reviewsLink}</a></div>
      <ReviewCards reviews={reviews} lang={lang} compact />
    </div>
  </section>

  <!-- FAQ: answers are visible, not hidden in tabs -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">
        {C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}
      </div>
      <p><a class="link-arrow" href={t('faq')}>{C.faqAll}</a></p>
    </div>
  </section>

  <!-- FORM -->
  <section class="section" id="form">
    <div class="container narrow">
      <h2>{C.formTitle}</h2>
      <div class="card"><LeadForm lang={lang} id="service-start" service="start" /></div>
    </div>
  </section>

  <!-- OTHER SERVICES -->
  <section class="section section--grey">
    <div class="container">
      <div class="section-head"><h2>{C.otherTitle}</h2></div>
      <div class="grid grid-3">
        {others.map((o) => (
          <a class="card card--link" href={t(o.key)}>
            <h3>{name(o.key)}</h3>
            <p>{o.text || serviceByKey(o.key as 'consulting' | 'fullSeo' | 'maps').short[lang]}</p>
            <span class="link-arrow">{C.more}</span>
          </a>
        ))}
      </div>
      <GeoNote lang={lang} />
    </div>
  </section>
</Base>
