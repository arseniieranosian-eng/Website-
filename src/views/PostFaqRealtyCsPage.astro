---
// Blog article "Jak má vypadat FAQ na webu realitní kanceláře?" (cs), brief of 10.11.2026. Content: data/post-faq-realty-cs.ts. DRAFT: not linked from other pages, not in the blog index.
// Body links: only the three of the brief (H2 "Kam FAQ umístit", H2 "Co jsem viděl") plus the two visible sources in the FAQ answer (K4); the author's quote (rule J) is a plain blockquote without Quotation markup;
// the closing block has TWO buttons by city (the exception of rule H for real-estate agencies). The expert lines are shown only when EXPERT_CONFIRMED is true.
import Base from '../layouts/Base.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { postFaqRealtySchemas } from '../lib/schema-post-faq-realty';
import { POST_FAQ_REALTY_CS as C, POST_FAQ_REALTY_PUBLISHED, EXPERT_CONFIRMED } from '../data/post-faq-realty-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = [lastModified(['src/views/PostFaqRealtyCsPage.astro', 'src/data/post-faq-realty-cs.ts'], '2026-11-10'), POST_FAQ_REALTY_PUBLISHED].sort().pop()!;
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-faq-na-webu-realitni-kancelare.png';
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
const cite = new URL(path('postFaqRealty', lang), site).href;
const L_SERVICES = 'https://seo-eranosian.com/blog/proc-web-realitni-kancelare-neprinasi-poptavky/#sluzby';
const L_DISTRICT = 'https://seo-eranosian.com/blog/stranky-ctvrti-a-lokalit-realitni-kancelare/';
const L_SOURCE = 'https://seo-eranosian.com/blog/slabe-seo-konkurence-realitni-kancelare/';
// "{key}" in a FAQ answer is a link of that answer (`links`), the JSON-LD gets the same words without the markup
const faqParts = (f: { a: string; links?: Record<string, { text: string; href: string }> }) => f.a.split(/(\{\w+\})/).filter(Boolean).map((p) => {
  const m = p.match(/^\{(\w+)\}$/);
  return m && f.links?.[m[1]] ? f.links[m[1]] : { text: p };
});
---
<Base {...pageProps('postFaqRealty', lang)} ogType="article" ogImage={OG} schema={postFaqRealtySchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postFaqRealty.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
      {EXPERT_CONFIRMED && <p class="small muted">{C.reviewer.before}{' '}<a href={C.reviewer.href} target="_blank" rel="noopener">{C.reviewer.name}</a>{C.reviewer.after}</p>}
      <p class="lead">{C.lead}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.whatTitle}</h2>
      <p class="answer">{C.whatAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.whichTitle}</h2>
      <p class="answer">{C.whichAnswer}</p>
      <figure class="quote-fig">
        <blockquote cite={cite}><p>{C.quote}</p></blockquote>
        <QuoteCaption lang={lang} />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.approveTitle}</h2>
      <p class="answer">{C.approveAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.writeTitle}</h2>
      <p class="answer">{C.writeAnswer}</p>
      <ol class="steps">{C.writeSteps.map((s) => <li><span>{s}</span></li>)}</ol>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.whereTitle}</h2>
      <p class="answer">{C.whereAnswer}</p>
      <p>{C.whereLinks.before} <a href={L_SERVICES}>{C.whereLinks.services}</a> {C.whereLinks.middle} <a href={L_DISTRICT}>{C.whereLinks.district}</a>{C.whereLinks.after}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.seenTitle}</h2>
      <p class="answer">{C.seenAnswer.before} <a href={L_SOURCE}>{C.seenAnswer.link}</a>{C.seenAnswer.after}</p>
      <p>{C.seenMore}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.notTitle}</h2>
      <p class="answer">{C.notAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{faqParts(f).map((p: any) => p.href ? <a href={p.href} target="_blank" rel="noopener">{p.text}</a> : p.text)}</p></div>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <p class="muted">{C.mistake.before} <a href={t('contact')}>{C.mistake.link}</a></p>
      {EXPERT_CONFIRMED && <p class="muted expert-note">{C.expertNote}</p>}
      <p class="muted">{C.disclosure}</p>
      <div class="post-cta">
        <h2 class="post-cta__title">{C.endTitle}</h2>
        <p class="post-cta__text">{C.endText}</p>
        <div class="btn-row">
          <a class="btn btn--primary btn--lg" href={t('nicheRealty')}>{C.endPraha}</a>
          <a class="btn btn--primary btn--lg" href={t('nicheRealtyBrno')}>{C.endBrno}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
