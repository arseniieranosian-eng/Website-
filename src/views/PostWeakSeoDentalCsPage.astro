---
// Blog article "Co jsem zjistil ve výsledcích Googlu a Seznamu pro „stomatologie v Praze“" (cs; the slug slabe-seo-konkurence-zubni-ordinace stays), brief of 15.11.2026. Content: data/post-weak-seo-dental-cs.ts.
// Neutral observation (no names of sites, clinics, catalogues or portals). Body links: the three Google sources; the closing block has ONE button to the landing page of the niche (rule F: no links to Start, Full SEO,
// consultation, audit or maps in the body); the author's quote (rule J) is a plain blockquote without Quotation markup.
import Base from '../layouts/Base.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { postWeakSeoDentalSchemas } from '../lib/schema-post-weak-seo-dental';
import { POST_WEAK_SEO_DENTAL_CS as C, POST_WEAK_SEO_DENTAL_PUBLISHED } from '../data/post-weak-seo-dental-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = [lastModified(['src/views/PostWeakSeoDentalCsPage.astro', 'src/data/post-weak-seo-dental-cs.ts'], '2026-11-15'), POST_WEAK_SEO_DENTAL_PUBLISHED].sort().pop()!;
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-slabe-seo-konkurence-zubni-ordinace.png';
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
const cite = new URL(path('postWeakSeoDental', lang), site).href;
---
<Base {...pageProps('postWeakSeoDental', lang)} ogType="article" ogImage={OG} schema={postWeakSeoDentalSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postWeakSeoDental.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
      <p class="small muted">{C.updateNote}</p>
      <p class="lead">{C.summary}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.methodTitle}</h2>
      <p class="answer">{C.methodAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.aroundTitle}</h2>
      <p class="answer">{C.aroundAnswer}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.originTitle}</h2>
      <p class="answer">{C.originAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.findTitle}</h2>
      <p class="answer">{C.findAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.tableHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.tableRows.map((r) => <tr><th scope="row">{r[0]}</th>{r.slice(1).map((c) => <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p class="small muted">{C.tableNote}</p>
      <figure class="quote-fig">
        <blockquote cite={cite}><p>{C.quote}</p></blockquote>
        <QuoteCaption lang={lang} />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.notTitle}</h2>
      <p class="answer">{C.notAnswer}</p>
      <p class="small muted">{C.sourceLabel} {C.notSource.before}{' '}<a href={C.notSource.href} target="_blank" rel="noopener">{C.notSource.href}</a>{C.notSource.after}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.checkTitle}</h2>
      <p class="answer">{C.checkAnswer}</p>
      <ol class="steps">{C.checkSteps.map((s) => <li><span>{s}</span></li>)}</ol>
      <p class="small muted">{C.sourceLabel} <a href={C.checkSource.href} target="_blank" rel="noopener">{C.checkSource.href}</a>{C.checkSource.after}.</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}</div>
      <p class="small muted">{C.sourceLabel} <a href={C.faqAiSource.href} target="_blank" rel="noopener">{C.faqAiSource.href}</a> (aktualizováno 10. 12. 2025).</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <p class="muted">{C.disclosure}</p>
      <p class="muted">{C.mistake.before} <a href={t('contact')}>{C.mistake.link}</a></p>
      <div class="post-cta">
        <p class="post-cta__title">{C.endTitle}</p>
        <p class="post-cta__text">{C.endText}</p>
        <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('nicheDental')}>{C.endCta}</a></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.moreTitle}</h2>
      <RelatedPosts lang={lang} keys={['postDentalChannels', 'postFaqDental']} more={C.moreMore} />
    </div>
  </section>
</Base>
