---
// Blog article U3 "Má SEO smysl pro malou účetní kancelář?" (cs), brief of 26.10.2026. Content: data/post-accounting-small-cs.ts.
// Decision article, informational: no prices, no CTA, no audit link; the closing block is one link to the landing page.
import Base from '../layouts/Base.astro';
import PostCta from '../components/PostCta.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { postAccountingSmallSchemas } from '../lib/schema-post-accounting-small';
import { POST_ACCOUNTING_SMALL_CS as C, POST_ACCOUNTING_SMALL_PUBLISHED } from '../data/post-accounting-small-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = [lastModified(['src/views/PostAccountingSmallCsPage.astro', 'src/data/post-accounting-small-cs.ts'], '2026-10-26'), POST_ACCOUNTING_SMALL_PUBLISHED].sort().pop()!;
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-ma-seo-smysl-pro-malou-ucetni-kancelar.png';
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
---
<Base {...pageProps('postAccountingSmall', lang)} ogType="article" ogImage={OG} schema={postAccountingSmallSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postAccountingSmall.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel} <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
      <p class="lead">{C.leadBefore}{' '}<a href={t('postAccountingChannels')}>{C.leadLinkText}</a>.</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.whenTitle}</h2>
      <p class="answer">{C.whenAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.table.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p class="muted small">{C.tableNote}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.countTitle}</h2>
      <p class="answer">{C.countAnswer}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.longTitle}</h2>
      <p class="answer">{C.longAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.rivalsTitle}</h2>
      <p class="answer">{C.rivalsAnswer}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.goalsTitle}</h2>
      <p class="answer">{C.goalsAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.needTitle}</h2>
      <p class="answer">{C.needAnswerBefore}{' '}<a href={t('postAccountingNoLeads')}>{C.needLinkText}</a>.</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.otherTitle}</h2>
      <p class="answer">{C.otherAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.stepTitle}</h2>
      <p class="answer">{C.stepAnswer}</p>
      <h3>{C.checklistTitle}</h3>
      <ul class="checks">{C.checklist.map((x) => <li>{x}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3>{f.linkAfter ? <p>{f.a.split(f.linkAfter)[0]}<a href={t('postAds')}>{f.linkAfter}</a>{f.a.split(f.linkAfter)[1]}</p> : <p>{f.a}</p>}</div>)}</div>
      <p class="muted">{C.endText}{' '}<a href={t('nicheAccounting')}>{C.endLinkText}</a>. {C.endText2}</p>
    </div>
  </section>


  <section class="section">
    <div class="container narrow">
      <PostCta lang={lang} postKey="postAccountingSmall" />
    </div>
  </section>
</Base>
