---
// The main case study (cs), brief of 21.10.2026: "půl roku práce". Content: data/case-cs.ts. Charts are HTML/SVG with real text
// (only the language shares exist as data); no blog links; two quotes (the author's and the agency owner's).
import Base from '../layouts/Base.astro';
import QuoteAuthor from '../components/QuoteAuthor.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { caseCsSchemas } from '../lib/schema-case-cs';
import { CASE_CS as C } from '../data/case-cs';
import { serviceByKey } from '../data/services';

const lang = C.lang;
const site = Astro.site!;

// Visible date and JSON-LD dateModified both come from git (see lib/lastmod.ts).
const MOD = lastModified(['src/views/CaseCsPage.astro', 'src/data/case-cs.ts', 'src/data/case-summary.ts'], '2026-10-21');
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/pripadove-studie/og-seo-prekladatelska-agentura.png';
const cite = new URL(t('caseKb'), site).href;
const oq = C.ownerQuote;
const authorQuote = 'SEO není magie. Je to systém, a správně postavený systém funguje i mimo sezónu, v malých městech i tehdy, když začínáte od nuly.';

// Language-share bar chart (SVG with real text); bars scaled to the largest share
const max = Math.max(...C.langRows.map((r) => r.pct));
const BAR_H = 34, GAP = 16, LABEL_W = 130, W = 640, BAR_MAX = W - LABEL_W - 70;
const chartH = C.langRows.length * (BAR_H + GAP) + 8;
---
<Base {...pageProps('caseKb', lang)} ogType="article" ogImage={OG} schema={caseCsSchemas(site, C, { modified: MOD, authorQuote })}>
  <!-- HERO -->
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">{C.label}</p>
      <h1>{C.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time> · {C.project}</p>
      <p class="lead">{C.answer}</p>
      <dl class="stats stats--three">{C.cards.map((c) => <div><dt>{c.label}</dt><dd>{c.value}</dd></div>)}</dl>
      <p class="muted small">{C.dataNote}</p>
      <p><a class="link-arrow" href={t('caseSeason')}>{C.seasonLink}</a></p>
      <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('audit')}>{C.heroCta}</a></div>
    </div>
  </section>

  <!-- GOALS -->
  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.goalsTitle}</h2>
      <p class="answer">{C.goalsAnswer}</p>
      <ol class="checks">{C.goals.map((x) => <li>{x}</li>)}</ol>
    </div>
  </section>

  <!-- STARTING POINT -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.startTitle}</h2>
      <p class="answer">{C.startAnswer}</p>
      <ul class="checks">{C.startList.map((x) => <li>{x}</li>)}</ul>
      <p>{C.startText}</p>
    </div>
  </section>

  <!-- WHAT WAS BUILT -->
  <section class="section">
    <div class="container narrow">
      <h2>{C.builtTitle}</h2>
      <p class="answer">{C.builtAnswer}</p>
      <ul class="checks">{C.builtTypes.map((x) => <li>{x}</li>)}</ul>
      <ul class="checks">{C.builtSections.map((x) => <li>{x}</li>)}</ul>
      <p>{C.builtText}</p>
    </div>
  </section>

  <!-- RESULTS (owner's quote right after the first paragraph, then the table) -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.resTitle}</h2>
      <p class="answer">{C.resAnswer}</p>
      <figure class="owner-quote">
        <blockquote cite={cite}><p>{oq.text}</p></blockquote>
        <figcaption>
          <img src={oq.photo.src} width={oq.photo.width} height={oq.photo.height} alt={oq.photo.alt} loading="lazy" decoding="async" />
          <span>— <a href={oq.instagram} rel="me noopener nofollow" target="_blank">{oq.name}</a>, {oq.role}</span>
        </figcaption>
      </figure>
    </div>
    <div class="container">
      <div class="table-wrap">
        <table class="compare results-table">
          <thead><tr>{C.resTable.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.resTable.rows.map((r) => <tr>{r.map((c, i) => i === 1 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
    </div>
    <div class="container narrow">
      <p class="muted small">{C.resCaption}</p>
      <p>{C.seasonFormula} (<a href={t('caseSeason')}>{C.seasonFormulaLink}</a>)</p>
    </div>
  </section>

  <!-- WHO STARTED TO COME: language shares (percentages only) -->
  <section class="section">
    <div class="container narrow">
      <h2>{C.langTitle}</h2>
      <p class="answer">{C.langAnswer}</p>
      <h3>{C.langChartTitle}</h3>
      <svg class="lang-chart" viewBox={`0 0 ${W} ${chartH}`} role="img" aria-label={C.langAria} xmlns="http://www.w3.org/2000/svg">
        {C.langRows.map((r, i) => (
          <g transform={`translate(0 ${i * (BAR_H + GAP) + 4})`}>
            <text x="0" y={BAR_H / 2 + 6} class="lang-chart__label">{r.name}</text>
            <rect x={LABEL_W} y="0" width={Math.max(4, Math.round((r.pct / max) * BAR_MAX))} height={BAR_H} rx="6" class={i === 0 ? 'lang-chart__bar lang-chart__bar--main' : 'lang-chart__bar'} />
            <text x={LABEL_W + Math.max(4, Math.round((r.pct / max) * BAR_MAX)) + 10} y={BAR_H / 2 + 6} class="lang-chart__pct">{`${r.pct} %`}</text>
          </g>
        ))}
      </svg>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.langTableHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.langRows.map((r) => <tr><td>{r.rank}</td><th scope="row">{r.name}</th><td>{`${r.pct} %`}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="muted small">{C.langCaption}</p>
      <p>{C.langText}</p>
      <figure class="lang-shot">
        <img src={C.langImage.src} width={C.langImage.width} height={C.langImage.height} alt={C.langImage.alt} loading="lazy" decoding="async" />
        <figcaption class="muted small">{C.langImage.caption}</figcaption>
      </figure>
    </div>
  </section>

  <!-- CITIES -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.citiesTitle}</h2>
      <p class="answer">{C.citiesAnswer}</p>
      <ul class="checks">{C.cities.map((x) => <li>{x}</li>)}</ul>
      <p>{C.citiesText}</p>
    </div>
  </section>

  <!-- AI -->
  <section class="section">
    <div class="container narrow">
      <h2>{C.aiTitle}</h2>
      <p class="answer">{C.aiAnswer}</p>
      <p>{C.aiText}</p>
      <a class="link-arrow" href={t('geo')}>{C.aiLink}</a>
    </div>
  </section>

  <!-- SIX CONCLUSIONS -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.lessonTitle}</h2>
      <ol class="case-steps">{C.lesson.map((s) => <li><h3>{s.title}</h3><p>{s.text}</p></li>)}</ol>
    </div>
  </section>

  <!-- AUTHOR QUOTE (after the conclusions, before the FAQ) -->
  <section class="section section--tight">
    <div class="container narrow">
      <blockquote class="pullquote">
        <p>{authorQuote}</p>
        <QuoteAuthor />
      </blockquote>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p>{f.link && <p><a class="link-arrow" href={t(f.link)}>{f.linkText}</a></p>}</div>)}</div>
    </div>
  </section>

  <!-- RELATED SERVICES (no prices) -->
  <section class="section section--grey">
    <div class="container">
      <h2>{C.relatedTitle}</h2>
      <div class="grid grid-4">
        {C.related.map((k) => (
          <a class="card card--link" href={t(k)}>
            <h3>{META[k][lang].name}</h3>
            <p>{serviceByKey(k).short[lang]}</p>
            <span class="link-arrow">{C.more}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- SOFT CLOSE -->
  <section class="section">
    <div class="container narrow">
      <h2>{C.ctaTitle}</h2>
      <p>{C.ctaText}</p>
      <div class="btn-row">
        <a class="btn btn--primary btn--lg" href={t('audit')}>{C.ctaAudit}</a>
        <a class="btn btn--secondary btn--lg" href={t('contact')}>{C.ctaContact}</a>
      </div>
      {C.nextCases.map((n) => <p><a class="link-arrow" href={t(n.key)}>{n.text}</a></p>)}
    </div>
  </section>
</Base>
