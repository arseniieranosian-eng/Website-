---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CaseTeaser from '../components/CaseTeaser.astro';
import CtaBand from '../components/CtaBand.astro';
import { META } from '../i18n/meta';
import { type Lang } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { CASES } from '../data/cases';

interface Props { lang: Lang }
const { lang } = Astro.props;
const m = META.cases[lang];
const C = {
  cs: { lead: 'Konkrétní projekty: výchozí stav, co jsme udělali a jaké to mělo výsledky.', ctaTitle: 'Chcete podobné výsledky?', ctaText: 'Začněte bezplatným auditem vašeho webu.' },
  en: { lead: 'Real projects: the starting point, what we did and the results it brought.', ctaTitle: 'Want similar results?', ctaText: 'Start with a free audit of your website.' },
  ru: { lead: 'Реальные проекты: исходная ситуация, что мы сделали и какие получили результаты.', ctaTitle: 'Хотите такие же результаты?', ctaText: 'Начните с бесплатного аудита сайта.' },
}[lang];
---
<Base {...pageProps('cases', lang)}>
  <PageHero h1={m.h1} lead={C.lead} />
  <section class="section section--tight">
    <div class="container stack">{CASES.map((c) => <CaseTeaser lang={lang} caseKey={c.key} heading="h2" />)}</div>
  </section>
  <CtaBand lang={lang} title={C.ctaTitle} text={C.ctaText} />
</Base>
