---
// Blog article /en/blog/czech-and-english-website-versions-translation-agency/ (brief of 28.11.2026, content funnel, article A). Content: data/post-lang-versions-en.ts.
// Body links: the three Google documentation pages (sources) and the author's about / contact pages; the "Related articles" block has ONE card (article B); ONE button to the translation-agency page (rules F and H). No hreflang pair.
import Base from '../layouts/Base.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { postEnFunnelSchemas } from '../lib/schema-post-en-funnel';
import { POST_LANGVERSIONS_EN as C, POST_LANGVERSIONS_EN_PUBLISHED as PUB, POST_LANGVERSIONS_EN_MODIFIED as MOD, POST_LANGVERSIONS_EN_CHECKED as CHECKED, POST_LANGVERSIONS_EN_OBS as OBS } from '../data/post-lang-versions-en';

const lang = C.lang;
const site = Astro.site!;
const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d} ${MONTHS[mo - 1]} ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-czech-and-english-website-versions-translation-agency.png';
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
const cite = new URL(path('postLangVersionsEn', lang), site).href;
const obs = `On ${CHECKED} I checked the language versions of this site in the built pages and in the sitemap: ${OBS.addresses} addresses in ${OBS.languages} languages. Every address has a built page, and every version lists itself and the other versions. This is a check of one site on one day, not a rule for other sites.`;
---
<Base {...pageProps('postLangVersionsEn', lang)} ogType="article" ogImage={OG} schema={postEnFunnelSchemas(site, 'postLangVersionsEn', C, { published: PUB, modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postLangVersionsEn.en.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
      <p class="lead">{C.lead}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.urls.title}</h2>
      <p class="answer">{C.urls.answer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.hreflang.title}</h2>
      <p class="answer">{C.hreflang.answer}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.guarantee.title}</h2>
      <p class="answer">{C.guarantee.answer}</p>
      <figure class="quote-fig">
        <blockquote cite={cite}><p>{C.quote}</p></blockquote>
        <QuoteCaption lang={lang} />
      </figure>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.dup.title}</h2>
      <p class="answer">{C.dup.answer}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.x.title}</h2>
      <p class="answer">{C.x.answer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.check.title}</h2>
      <p>{C.check.intro}</p>
      <ol class="steps">{C.check.steps.map((s) => <li><span>{s}</span></li>)}</ol>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.obs.title}</h2>
      <p class="answer">{obs}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.prague.title}</h2>
      <p class="answer">{C.prague.answer}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.sources.title}</h2>
      <p class="small muted">{C.sources.line.replace('{checked}', CHECKED)}</p>
      <ul class="small muted">{C.sources.items.map((s) => <li>{s.text}: <a href={s.href} target="_blank" rel="noopener">{s.href}</a></li>)}</ul>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.moreTitle}</h2>
      <p class="muted">{C.moreLead}</p>
      <RelatedPosts lang={lang} keys={['postNoEnquiriesEn']} more={C.moreMore} />
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <p class="muted">{C.disclosure}</p>
      <div class="post-cta">
        <p class="post-cta__title">{C.endTitle}</p>
        <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('nicheTranslation')}>{C.endCta}</a></div>
      </div>
      <p class="muted">{C.mistake.before} <a href={t('contact')}>{C.mistake.link}</a></p>
    </div>
  </section>
</Base>
