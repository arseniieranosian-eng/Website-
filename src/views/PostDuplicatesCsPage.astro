---
// Blog article "Duplicitní obsah: co to je, jak ho poznat a jak ho vyřešit" (cs), brief of 21.10.2026. Content: data/post-duplicates-cs.ts.
// One main CTA (free audit). Links to funnel articles 2 (redesign) and 3 are added when they exist.
import Base from '../layouts/Base.astro';
import IndexIllustration from '../components/IndexIllustration.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { postDuplicatesSchemas } from '../lib/schema-post-duplicates';
import { POST_DUPLICATES_CS as C } from '../data/post-duplicates-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = lastModified(['src/views/PostDuplicatesCsPage.astro', 'src/data/post-duplicates-cs.ts', 'src/components/IndexIllustration.astro'], '2026-10-21');
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-duplicitni-obsah.png';
const cite = new URL(t('postDuplicates'), site).href;
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
---
<Base {...pageProps('postDuplicates', lang)} ogType="article" ogImage={OG} schema={postDuplicatesSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postDuplicates.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
      <p class="lead">{C.lead}</p>
      <p>{C.forWhom}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.whatTitle}</h2>
      <p class="answer">{C.whatAnswer}</p>
      <p>{C.whatText}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.causesTitle}</h2>
      <p class="answer">{C.causesAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.causes.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.causes.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p class="post-table-note">{C.causesNote}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.harmTitle}</h2>
      <p class="answer">{C.harmAnswer}</p>
      <ul class="checks">{C.harm.map((x) => <li>{x}</li>)}</ul>
      <p>{C.harmText} {C.harmIndexLead} <a href={t('postIndexing')}>{C.harmIndexLinkText}</a>.</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.spotTitle}</h2>
      <p class="answer">{C.spotAnswer}</p>
      <ol class="steps">{C.spotSteps.map((s) => <li><span>{s}</span></li>)}</ol>
      {C.figures.map((f) => <figure class="post-figure"><IndexIllustration kind={f.kind} aria={f.aria} /><figcaption>{f.caption}</figcaption></figure>)}
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.fixTitle}</h2>
      <p class="answer">{C.fixAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.fix.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.fix.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p>{C.fixText}</p>
      <p>{C.redirectLead} <a href={t('postRedirects')}>{C.redirectLinkText}</a>.</p>
      <p>{C.redesignLead} <a href={t('postRedesign')}>{C.redesignLinkText}</a>.</p>
      <figure class="quote-fig">
        <blockquote cite={cite}><p>{C.quote}</p></blockquote>
        <QuoteCaption lang={lang} />
      </figure>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.fearTitle}</h2>
      <p class="answer">{C.fearAnswer}</p>
      <p>{C.fearText}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.indexTitle}</h2>
      <p class="answer">{C.indexAnswer}</p>
      <p>{C.indexLead1} <a href={t('postNotShown')}>{C.indexLink1}</a>. {C.indexLead2} <a href={t('postIndexing')}>{C.indexLink2}</a>.</p>
      <p>{C.bridge}</p>
      <p>{C.border}</p>
      <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('audit')}>{C.cta}</a></div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.endTitle}</h2>
      <p>{C.endText}</p>
      <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('audit')}>{C.cta}</a></div>
      <p>{C.nextLead} <a class="link-arrow" href={t('postSeoAudit')}>{C.nextLinkText}</a></p>
      <p>{C.chooseLead} <a class="link-arrow" href={t('postChoose')}>{C.chooseLinkText}</a></p>
      <p class="muted">{C.authorNote} <a href={t('about')}>{C.authorLinkText}</a>.</p>
    </div>
  </section>
</Base>
