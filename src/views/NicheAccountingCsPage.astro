---
// Niche landing page "SEO pro účetní kanceláře v Praze" (cs), brief of 23.10.2026. Content: data/niche-accounting-cs.ts. Own structure (not the template of the translation /
// real-estate pages): query table, structure problem, checklist, GEO/AEO, formats table with links, honest experience block, FAQ. No prices, no quote, no video.
import Base from '../layouts/Base.astro';
import ServiceArt from '../components/ServiceArt.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { nicheAccountingSchemas } from '../lib/schema-niche-accounting';
import { NICHE_ACCOUNTING_CS as C } from '../data/niche-accounting-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = lastModified(['src/views/NicheAccountingCsPage.astro', 'src/data/niche-accounting-cs.ts'], '2026-10-23');
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
---
<Base {...pageProps('nicheAccounting', lang)} schema={nicheAccountingSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <h1>{META.nicheAccounting.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time></p>
      <p class="lead">{C.lead}</p>
      <div class="btn-row">
        <a class="btn btn--primary btn--lg" href={t('audit')}>{C.heroAudit}</a>
        <a class="btn btn--secondary btn--lg" href={t('consulting')}>{C.heroConsulting}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.coopTitle}</h2>
      <p class="answer">{C.coopAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.steps.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.steps.rows.map((r) => <tr><th scope="row"><span class="svc-name"><ServiceArt kind={r.page} />{r.name}</span></th><td>{r.text}</td><td><a href={t(r.page)}>{r.link}</a></td></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.priceTitle}</h2>
      <p class="answer">{C.priceAnswer}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.expTitle}</h2>
      <p class="answer">{C.expAnswer}</p>
      <p><a class="link-arrow" href={t('caseHalf')}>{C.expLink}</a></p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.obsTitle}</h2>
      <p class="answer">{C.obsAnswer}</p>
      <ul class="checks">{C.obsList.map((x: string) => <li>{x}</li>)}</ul>
      <p>{C.obsText}</p>
      <p class="muted small">{C.obsNote}</p>
      <p><a class="link-arrow" href={t('consulting')}>{C.obsLink}</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.fitTitle}</h2>
      <p class="answer">{C.fitAnswer}</p>
      <p>{C.fitText}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.articlesTitle}</h2>
      <RelatedPosts lang={lang} keys={['postAccountingChannels', 'postAccountingNoLeads', 'postAccountingSmall', 'postAccountingLocal', 'postAccountingPages']} more={C.articlesMore} />
    </div>
  </section>

  <section class="section section--dark cta-band">
    <div class="container cta-inner">
      <div>
        <h2>{C.endTitle}</h2>
        <p>{C.endText}</p>
        <p><a href={t('consulting')}>{C.endConsulting}</a></p>
        <p class="small">{C.updatedLabel}: <time datetime={MOD}>{modText}</time></p>
      </div>
      <div class="btn-row">
        <a class="btn btn--primary btn--lg" href={t('audit')}>{C.endCta}</a>
      </div>
    </div>
  </section>
</Base>
