---
// Blog article A "Jak získat klienty pro překladatelskou agenturu: přehled kanálů" (cs), brief of 22.10.2026. Content: data/post-clients-cs.ts.
// Niche framing; closing block towards the Prague landing. No author observations block (none supplied).
import Base from '../layouts/Base.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { postClientsSchemas } from '../lib/schema-post-clients';
import { POST_CLIENTS_CS as C } from '../data/post-clients-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = lastModified(['src/views/PostClientsCsPage.astro', 'src/data/post-clients-cs.ts'], '2026-10-22');
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-jak-ziskat-klienty-pro-prekladatelskou-agenturu.png';
const cite = new URL(t('postClients'), site).href;
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
---
<Base {...pageProps('postClients', lang)} ogType="article" ogImage={OG} schema={postClientsSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postClients.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
      <p class="lead">{C.lead}</p>
      <p>{C.forWhom}</p>
      <p class="muted small">{C.tocTitle}:</p>
      <ol class="toc">{C.toc.map((x) => <li><a href={`#${x.id}`}>{x.text}</a></li>)}</ol>
    </div>
  </section>

  <section class="section section--tight" id="kanaly">
    <div class="container narrow">
      <h2>{C.channelsTitle}</h2>
      <p class="answer">{C.channelsAnswer}</p>
    </div>
    <div class="container">
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.channels.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.channels.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
    </div>
    <div class="container narrow">
      <p>{C.channelsText}</p>
      <p class="muted small">{C.channelsNote}</p>
    </div>
  </section>

  <section class="section section--grey" id="vyber">
    <div class="container narrow">
      <h2>{C.pickTitle}</h2>
      <p class="answer">{C.pickAnswer}</p>
      <ul class="checks">{C.pick.map((x) => <li>{x}</li>)}</ul>
      <p>{C.pickLead} <a href={t('postNoLeads')}>{C.pickLinkText}</a>. {C.pickB2bLead} <a href={t('postB2b')}>{C.pickB2bLinkText}</a>.</p>
    </div>
  </section>

  <section class="section" id="reklama">
    <div class="container narrow">
      <h2>{C.adsTitle}</h2>
      <p class="answer">{C.adsAnswer}</p>
      <p>{C.adsText} <a href={t('postAds')}>{C.adsLinkText}</a>.</p>
      <figure class="quote-fig">
        <blockquote cite={cite}><p>{C.quote}</p></blockquote>
        <QuoteCaption lang={lang} />
      </figure>
    </div>
  </section>

  <section class="section section--grey" id="web">
    <div class="container narrow">
      <h2>{C.webTitle}</h2>
      <p class="answer">{C.webAnswer}</p>
      <ul class="checks">{C.web.map((x) => <li>{x}</li>)}</ul>
      <p><a class="link-arrow" href={t('postNoLeads')}>{C.webLinkText}</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.auditTitle}</h2>
      <p class="answer">{C.auditAnswer}</p>
      <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('audit')}>{C.cta}</a></div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.praguTitle}</h2>
      <p>{C.praguText}</p>
      <p><a class="link-arrow" href={t('nicheTranslation')}>{C.praguLinkText}</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p>{f.links && <p>{f.links.map((l, i) => <>{i > 0 && ' · '}<a class="link-arrow" href={t(l.page)}>{l.text}</a></>)}</p>}</div>)}</div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.endTitle}</h2>
      <p>{C.endText}</p>
      <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('audit')}>{C.cta}</a></div>
      <p>{C.caseLead} <a href={t('caseHalf')}>{C.caseLinkText}</a>.</p>
      <p class="muted">{C.authorNote} <a href={t('about')}>{C.authorLinkText}</a>.</p>
    </div>
  </section>
</Base>
