---
// Blog article D "Potřebuje překladatelská agentura stránku pro každý jazykový pár?" (cs), brief of 22.10.2026. Content: data/post-pairs-cs.ts.
// Niche framing; closing block towards the Prague landing. No author observations block (none supplied).
import Base from '../layouts/Base.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { postPairsSchemas } from '../lib/schema-post-pairs';
import { POST_PAIRS_CS as C } from '../data/post-pairs-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = lastModified(['src/views/PostPairsCsPage.astro', 'src/data/post-pairs-cs.ts'], '2026-10-22');
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-stranka-pro-kazdy-jazykovy-par.png';
const cite = new URL(t('postPairs'), site).href;
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
---
<Base {...pageProps('postPairs', lang)} ogType="article" ogImage={OG} schema={postPairsSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postPairs.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
      <p class="lead">{C.lead}</p>
      <p>{C.forWhom}</p>
      <p class="muted small">{C.tocTitle}:</p>
      <ol class="toc">{C.toc.map((x) => <li><a href={`#${x.id}`}>{x.text}</a></li>)}</ol>
    </div>
  </section>

  <section class="section section--tight" id="rozdil">
    <div class="container narrow">
      <h2>{C.diffTitle}</h2>
      <p class="answer">{C.diffAnswer}</p>
      <p>{C.diffText}</p>
    </div>
  </section>

  <section class="section section--grey" id="smysl">
    <div class="container narrow">
      <h2>{C.smysl.title}</h2>
      <p class="answer">{C.smysl.answer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.smysl.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.smysl.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p class="muted small">{C.smysl.note}</p>
      <figure class="quote-fig">
        <blockquote cite={cite}><p>{C.quote}</p></blockquote>
        <QuoteCaption lang={lang} />
      </figure>
    </div>
  </section>

  <section class="section" id="poptavka">
    <div class="container narrow">
      <h2>{C.demandTitle}</h2>
      <p class="answer">{C.demandAnswer}</p>
      <p>{C.demandText}{' '}<a href={t('postClients')}>{C.demandLinkText}</a>.</p>
    </div>
  </section>

  <section class="section section--grey" id="obsah">
    <div class="container narrow">
      <h2>{C.contentTitle}</h2>
      <p class="answer">{C.contentAnswer}</p>
      <ul class="checks">{C.content.map((x) => <li>{x}</li>)}</ul>
      <p>{C.contentText}{' '}<a href={t('postB2b')}>{C.contentLinkText}</a>.</p>
    </div>
  </section>

  <section class="section" id="sablona">
    <div class="container narrow">
      <h2>{C.templateTitle}</h2>
      <p class="answer">{C.templateAnswer}</p>
      <p>{C.templateLead}{' '}<a href={t('postDuplicates')}>{C.templateLinkText}</a>.</p>
    </div>
  </section>

  <section class="section section--grey" id="ostatni">
    <div class="container narrow">
      <h2>{C.otherTitle}</h2>
      <p class="answer">{C.otherAnswer}</p>
      <p>{C.otherLead}{' '}<a href={t('postNoLeads')}>{C.otherLinkText}</a>.</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.auditTitle}</h2>
      <p class="answer">{C.auditAnswer}</p>
      <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('audit')}>{C.cta}</a></div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.praguTitle}</h2>
      <p>{C.praguText}</p>
      <p><a class="link-arrow" href={t('nicheTranslation')}>{C.praguLinkText}</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p>{f.link && <p class="small"><a class="link-arrow" href={t(f.link)}>{f.linkText}</a></p>}</div>)}</div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.endTitle}</h2>
      <p>{C.endText}</p>
      <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('audit')}>{C.cta}</a></div>
      <p>{C.caseLead} <a href={t('caseHalf')}>{C.caseLinkText}</a>.</p>
      <p class="muted">{C.authorNote} <a href={t('about')}>{C.authorLinkText}</a>.</p>
    </div>
  </section>
</Base>
