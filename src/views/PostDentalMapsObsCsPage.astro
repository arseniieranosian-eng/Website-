---
// Blog article "Co jsem zjistil v kartách Google Maps a Mapy.com pro „stomatologie v Praze“" (cs), brief of 21.11.2026 (series "maps", pilot dentistry). Content: data/post-dental-maps-obs-cs.ts.
// Neutral observation (no names, no ratings, no counts of reviews, no comparison "better / worse"). Body links: the Google / Firmy.cz sources (visible, with the check date), ONE link to the article about the profile (inside H2-6),
// the closing block has ONE button to /lokalni-seo-mapy/ and ONE text link to the landing page of the niche (rule F: no links to audit, consultation, Start, Full SEO in the body); the quote (rule J) is a plain blockquote.
import Base from '../layouts/Base.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { postDentalMapsObsSchemas } from '../lib/schema-post-dental-maps-obs';
import { POST_MAPS_OBS_CS as C, POST_MAPS_OBS_MODIFIED } from '../data/post-dental-maps-obs-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = POST_MAPS_OBS_MODIFIED; // set by hand, not from git
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-stomatologie-v-mapach-co-jsem-zjistil.png';
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
const cite = new URL(path('postDentalMapsObs', lang), site).href;
---
<Base {...pageProps('postDentalMapsObs', lang)} ogType="article" ogImage={OG} schema={postDentalMapsObsSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postDentalMapsObs.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
      <p class="lead">{C.summary}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.methodTitle}</h2>
      <p class="answer">{C.methodAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.originTitle}</h2>
      <p class="answer">{C.originAnswer}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.findTitle}</h2>
      <p class="answer">{C.findAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.tableHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.tableRows.map((r) => <tr><th scope="row">{r[0]}</th>{r.slice(1).map((c) => <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p class="small muted">{C.tableNote}</p>
      <p class="small muted">{C.methodLine}</p>
      <figure class="stack-chart stack-chart--long">
        <div class="stack-chart__rows" role="img" aria-label={`${C.chartCaption} ` + C.chartRows.map((r) => `${r.label}: ` + r.values.map((n, i) => `${C.chartLegend[i]} ${n}`).join(', ')).join('; ') + '.'}>
          {C.chartRows.map((r) => (
            <div class="stack-chart__row" aria-hidden="true">
              <span class="stack-chart__label">{r.label}</span>
              <span class="stack-chart__bar">{r.values.map((n, i) => n > 0 && <span class={`stack-chart__seg stack-chart__seg--${i + 1}`} style={`flex: ${n} 1 0`}>{n}</span>)}</span>
            </div>
          ))}
        </div>
        <ul class="stack-chart__legend" aria-hidden="true">{C.chartLegend.map((l, i) => <li><span class={`stack-chart__swatch stack-chart__seg--${i + 1}`}></span>{l}</li>)}</ul>
        <figcaption class="small muted">{C.chartCaption}</figcaption>
      </figure>
      <figure class="quote-fig">
        <blockquote cite={cite}><p>{C.quote}</p></blockquote>
        <QuoteCaption lang={lang} />
      </figure>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.rankTitle}</h2>
      <p class="answer">{C.rankAnswer}</p>
      <p class="small muted">{C.sourcesLabel}</p>
      <ul class="small muted">{C.rankSources.map((s) => <li>{s.text}: <a href={s.href} target="_blank" rel="noopener">{s.href}</a></li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.notTitle}</h2>
      <p class="answer">{C.notAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.checkTitle}</h2>
      <p class="answer">{C.checkAnswer.before}<a href={t('postDentalProfile')}>{C.checkAnswer.link}</a>{C.checkAnswer.after}</p>
      <ol class="steps">{C.checkSteps.map((s) => <li><span>{s}</span></li>)}</ol>
      <p class="small muted">{C.sourcesLabel}</p>
      <ul class="small muted">{C.checkSources.map((s) => <li>{s.text}: <a href={s.href} target="_blank" rel="noopener">{s.href}</a></li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}</div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <p class="muted">{C.disclosure}</p>
      <p class="muted">{C.mistake.before} <a href={t('contact')}>{C.mistake.link}</a></p>
      <div class="post-cta">
        <p class="post-cta__title">{C.endTitle}</p>
        <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('maps')}>{C.endCta}</a></div>
        <p class="post-cta__text">{C.endLink.before} <a href={t('nicheDental')}>{C.endLink.text}</a>{C.endLink.after}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.moreTitle}</h2>
      <RelatedPosts lang={lang} keys={['postWeakSeoDental', 'postDentalChannels']} more={C.moreMore} />
    </div>
  </section>
</Base>
