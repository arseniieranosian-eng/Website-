---
// Blog article "Proč jsou ve vyhledávání vpředu i počítačové herny se slabým SEO?" (cs), brief C3 of 07.11.2026 (published 08.11.2026). Content: data/post-weak-seo-gaming-cs.ts.
// Informational: no body links except the two visible Google sources (K4); the author's quote (rule J) is a plain blockquote without Quotation
// markup; the closing block has ONE button (rule H).
import Base from '../layouts/Base.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { postWeakSeoGamingSchemas } from '../lib/schema-post-weak-seo-gaming';
import { POST_WEAK_SEO_GAMING_CS as C, POST_WEAK_SEO_GAMING_PUBLISHED } from '../data/post-weak-seo-gaming-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = [lastModified(['src/views/PostWeakSeoGamingCsPage.astro', 'src/data/post-weak-seo-gaming-cs.ts'], '2026-11-08'), POST_WEAK_SEO_GAMING_PUBLISHED].sort().pop()!;
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-slabe-seo-konkurence-pocitacove-herny.png';
const cite = new URL(path('postWeakSeoGaming', lang), site).href;
---
<Base {...pageProps('postWeakSeoGaming', lang)} ogType="article" ogImage={OG} schema={postWeakSeoGamingSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postWeakSeoGaming.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time> · {C.readLabel}: 4 {C.readUnit}</p>
      <p class="lead">{C.lead}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.seenTitle}</h2>
      <p class="answer">{C.seenAnswer}</p>
      <p>{C.seenMore}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.sitesTitle}</h2>
      <p class="answer">{C.sitesAnswer}</p>
      <p>{C.sitesMore}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.ratedTitle}</h2>
      <p class="answer">{C.ratedAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.whyTitle}</h2>
      <p class="answer">{C.whyAnswer}</p>
      <p>{C.whyMore}</p>
      <p class="small muted">{C.sourceLabel} {C.whySource.before}{' '}<a href={C.whySource.href} target="_blank" rel="noopener">{C.whySource.href}</a>{C.whySource.after}</p>
      <figure class="quote-fig">
        <blockquote cite={cite}><p>{C.quote}</p></blockquote>
        <QuoteCaption lang={lang} />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.aiTitle}</h2>
      <p class="answer">{C.aiAnswer}</p>
      <p class="small muted">{C.sourceLabel} {C.aiSource.before}{' '}<a href={C.aiSource.href} target="_blank" rel="noopener">{C.aiSource.href}</a>{C.aiSource.after}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.checkTitle}</h2>
      <p class="answer">{C.checkAnswer}</p>
      <p>{C.checkMore}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}</div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <p class="muted">{C.disclosure}</p>
      <div class="post-cta">
        <p class="post-cta__title">{C.endTitle}</p>
        <p class="post-cta__text">{C.endText}</p>
        <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('nicheGaming')}>{C.endCta}</a></div>
      </div>
    </div>
  </section>
</Base>
