---
// /ru/besplatnyj-audit/ built from the brief of 19.10.2026. Content: data/audit-ru.ts.
// The sample-presentation video block appears only when AUDIT_VIDEO is set (see data/audit-ru.ts).
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import ReviewCards from '../components/ReviewCards.astro';
import { META } from '../i18n/meta';
import { path, servicesHref } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { auditSchemas } from '../lib/schema-audit-ru';
import { AUDIT_RU as C, AUDIT_VIDEO as V } from '../data/audit-ru';
import { REVIEWS } from '../data/reviews';
import { serviceByKey } from '../data/services';

const lang = C.lang;
const site = Astro.site!;

// Visible date and JSON-LD dateModified both come from git (see lib/lastmod.ts).
const MOD = lastModified(['src/views/AuditRuPage.astro', 'src/data/audit-ru.ts', 'src/data/consulting-shared.ts', 'src/data/start-shared.ts', 'src/data/reviews.ts'], '2026-10-19');
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${String(d).padStart(2, '0')}.${String(mo).padStart(2, '0')}.${y}`;

// 1-2 fresh reviews from the shared source. The consultation review is about a different service and format
// ("1,5 часа"), so it is not used here; Russian originals first, then the newest.
const reviews = REVIEWS.filter((r) => !r.sample && !r.services.includes('consulting'))
  .sort((a, b) => Number(b.origin === 'ru') - Number(a.origin === 'ru') || (b.date ?? '').localeCompare(a.date ?? ''))
  .slice(0, 2);
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const name = (k: keyof typeof META) => META[k][lang].name;
const others = [
  { key: 'consulting', text: '' },
  { key: 'start', text: '' },
  { key: 'fullSeo', text: '' },
  { key: 'maps', text: '' },
  { key: 'geo', text: C.geo },
] as const;
---
<Base {...pageProps('audit', lang)} schema={auditSchemas(site, C, V, { modified: MOD, reviews })}>
  <!-- HERO -->
  <section class="page-hero">
    <div class="container">
      <h1>{C.h1}</h1>
      <p class="updated">{C.updatedLabel}: <time datetime={MOD}>{modText}</time></p>
      <p class="lead">{C.lead}</p>
      <p class="price-badge">{C.badge}</p>
      <div class="btn-row">
        <a class="btn btn--primary btn--lg" href="#form">{C.heroPrimary}</a>
      </div>
    </div>
  </section>

  <!-- WHAT IS CHECKED -->
  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.checksTitle}</h2>
      <p class="answer">{C.checksAnswer}</p>
      <ul class="checks">{C.checks.map((c) => <li>{c.text}</li>)}</ul>
    </div>
  </section>

  <!-- WHAT IS NOT INCLUDED -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.notTitle}</h2>
      <p class="answer">{C.notAnswer}</p>
      <ul class="checks">
        {C.not.map((n) => (
          <li><span>{n.label} {n.links.map((l, i) => <>{i > 0 && n.sep}<a href={t(l.page)}>{l.text}</a></>)}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section">
    <div class="container narrow">
      <h2>{C.stagesTitle}</h2>
      <ol class="steps">{C.stages.map((s) => <li><span>{s}</span></li>)}</ol>
    </div>
  </section>

  <!-- WHAT YOU GET (+ sample video when available) -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.getTitle}</h2>
      <p class="answer">{C.getAnswer}</p>
      {V && (
        <>
          <h3>{C.videoTitle}</h3>
          <figure class="audit-video">
            <video controls preload="metadata" poster={V.poster} width={V.width} height={V.height}>
              <source src={V.src} type="video/mp4" />
            </video>
            <figcaption class="muted small">{C.videoCaption}</figcaption>
          </figure>
          <p>{C.videoDescription}</p>
          <p>{C.videoText}</p>
        </>
      )}
    </div>
  </section>

  <!-- AUDIT, CONSULTATION OR START -->
  <section class="section">
    <div class="container">
      <h2>{C.compareTitle}</h2>
      <p class="answer">{C.compareAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr><th scope="col"><span class="sr-only">{C.table.corner}</span></th>{C.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>
            {C.table.rows.map(([label, ...cells]) => <tr><th scope="row">{label}</th>{cells.map((c) => <td>{c}</td>)}</tr>)}
          </tbody>
        </table>
      </div>
      <ul class="link-list">
        <li><a href={t('consulting')}>{C.compareLinks.consulting}</a></li>
        <li><a href={t('start')}>{C.compareLinks.start}</a></li>
      </ul>
    </div>
  </section>

  <!-- REVIEWS (shared data source) -->
  <section class="section section--grey">
    <div class="container">
      <div class="section-head"><h2>{C.reviewsTitle}</h2><a class="link-arrow" href={t('reviews')}>{C.reviewsLink}</a></div>
      <ReviewCards reviews={reviews} lang={lang} compact />
    </div>
  </section>

  <!-- FAQ: answers are visible, not hidden in tabs -->
  <section class="section">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">
        {C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}
      </div>
      <p><a class="link-arrow" href={t('faq')}>{C.faqAll}</a></p>
    </div>
  </section>

  <!-- FORM -->
  <section class="section section--grey" id="form">
    <div class="container narrow">
      <h2>{C.formTitle}</h2>
      <div class="card"><LeadForm lang={lang} id="audit-ru" service="audit" websiteRequired /></div>
    </div>
  </section>

  <!-- OTHER SERVICES -->
  <section class="section">
    <div class="container">
      <div class="section-head"><h2>{C.otherTitle}</h2><a class="link-arrow" href={servicesHref(lang)}>{C.otherAll}</a></div>
      <div class="grid grid-3">
        {others.map((o) => (
          <a class="card card--link" href={t(o.key)}>
            <h3>{name(o.key)}</h3>
            <p>{o.text || serviceByKey(o.key as 'consulting' | 'start' | 'fullSeo' | 'maps').short[lang]}</p>
            <span class="link-arrow">{C.more}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
