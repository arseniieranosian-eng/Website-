---
// Blog article N5 "Nabídky nemovitostí a SEO: indexace, duplicity filtrů, prodané nabídky" (cs), brief of 23.10.2026. Content: data/post-realty-listings-cs.ts.
// Principles only (no observations); the quote is shown only when QUOTE_CONFIRMED is true; the Google documentation is cited with its checking date.
import Base from '../layouts/Base.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { postRealtyListingsSchemas } from '../lib/schema-post-realty-listings';
import { POST_REALTY_LISTINGS_CS as C, QUOTE_CONFIRMED, DOCS_CHECKED } from '../data/post-realty-listings-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = lastModified(['src/views/PostRealtyListingsCsPage.astro', 'src/data/post-realty-listings-cs.ts'], '2026-10-22');
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-nabidky-nemovitosti-seo.png';
const cite = new URL(t('postRealtyListings'), site).href;
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
---
<Base {...pageProps('postRealtyListings', lang)} ogType="article" ogImage={OG} schema={postRealtyListingsSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postRealtyListings.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
      <p class="lead">{C.lead}</p>
      <p>{C.forWhom}</p>
      <p class="muted small">{C.tocTitle}:</p>
      <ol class="toc">{C.toc.map((x) => <li><a href={`#${x.id}`}>{x.text}</a></li>)}</ol>
    </div>
  </section>

  <section class="section section--tight" id="slozite">
    <div class="container narrow">
      <h2>{C.hardTitle}</h2>
      <p class="answer">{C.hardAnswer}</p>
    </div>
  </section>

  <section class="section section--grey" id="indexace">
    <div class="container narrow">
      <h2>{C.indexTitle}</h2>
      <p class="answer">{C.indexAnswer}</p>
      <p>{C.indexLead}{' '}<a href={t('postNotShown')}>{C.indexLinkText}</a> {C.indexAuditLead}{' '}<a href={t('audit')}>{C.indexAuditLinkText}</a>.</p>
    </div>
  </section>

  <section class="section" id="filtry">
    <div class="container narrow">
      <h2>{C.filtersTitle}</h2>
      <p class="answer">{C.filtersAnswer}</p>
      {C.filtersText.map((p) => <p>{p}</p>)}
      <p>{C.filtersLead}{' '}<a href={t('postDuplicates')}>{C.filtersLinkText}</a>.</p>
    </div>
  </section>

  <section class="section section--grey" id="prodane">
    <div class="container narrow">
      <h2>{C.soldTitle}</h2>
      <p class="answer">{C.soldAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.sold.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.sold.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p class="muted small">{C.soldNote}</p>
      <p>{C.soldLead}{' '}<a href={t('postRedirects')}>{C.soldLinkText}</a>.</p>
    </div>
  </section>

  <section class="section" id="portaly">
    <div class="container narrow">
      <h2>{C.portalsTitle}</h2>
      <p class="answer">{C.portalsAnswer}</p>
    </div>
  </section>

  <section class="section section--grey" id="kontrola">
    <div class="container narrow">
      <h2>{C.checkTitle}</h2>
      <p class="answer">{C.checkAnswer}</p>
      <ol class="checks">{C.check.map((x) => <li>{x}</li>)}</ol>
      <p>{C.checkLead}{' '}<a href={t('nicheRealty')}>{C.checkLinkText}</a>.</p>
    </div>
  </section>

  <section class="section" id="audit">
    <div class="container narrow">
      <h2>{C.auditTitle}</h2>
      <p class="answer">{C.auditAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.audit.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.audit.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p>{C.auditLead}{' '}<a href={t('audit')}>{C.auditLinkText}</a>. {C.auditConsultingLead}{' '}<a href={t('consulting')}>{C.auditConsultingLinkText}</a>{' '}{C.auditStartLead}{' '}<a href={t('start')}>{C.auditStartLinkText}</a>.</p>
      {QUOTE_CONFIRMED && (
        <figure class="quote-fig">
          <blockquote cite={cite}><p>{C.quote}</p></blockquote>
          <QuoteCaption lang={lang} />
        </figure>
      )}
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p>{f.links && <p class="small">{f.links.map((l, i) => <>{i > 0 && ' · '}<a class="link-arrow" href={t(l.page)}>{l.text}</a></>)}</p>}</div>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.sourcesTitle}</h2>
      <p>{C.sourcesLead} {DOCS_CHECKED}.</p>
      <ul class="link-list">{C.sources.map((s) => <li><a href={s.href} rel="noopener" target="_blank">{s.text}</a></li>)}</ul>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.endTitle}</h2>
      <p>{C.endText}</p>
      <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('audit')}>{C.cta}</a></div>
      <p>{C.endConsulting}{' '}<a href={t('consulting')}>{C.endConsultingLink}</a>.</p>
      <p>{C.checkLead}{' '}<a href={t('nicheRealty')}>{C.checkLinkText}</a>.</p>
      <p class="muted">{C.authorNote} <a href={t('about')}>{C.authorLinkText}</a>.</p>
    </div>
  </section>
</Base>
