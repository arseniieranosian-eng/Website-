---
// Blog article "Jednorázová úprava webu, nebo průběžné SEO: v čem se liší?" (cs), brief of 23.11.2026 (comparative series, article 1). Content: data/post-one-time-cs.ts.
// A comparison of ways of working (not of companies): no names, no outside prices, no promises. Body links: the two articles in the list of steps (audit-konzultace-nebo-start, seo-plan-na-12-mesicu); rule F: no links to the service pages;
// ONE button to /konzultace/ at the end; the author's quote (rule J) is a plain blockquote without Quotation markup; prices in the table are not marked up.
import Base from '../layouts/Base.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { postOneTimeSchemas } from '../lib/schema-post-one-time';
import { POST_ONETIME_CS as C, POST_ONETIME_MODIFIED } from '../data/post-one-time-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = POST_ONETIME_MODIFIED; // set by hand, not from git
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-jednorazove-seo-nebo-prubezne.png';
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
const cite = new URL(path('postOneTime', lang), site).href;
---
<Base {...pageProps('postOneTime', lang)} ogType="article" ogImage={OG} schema={postOneTimeSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postOneTime.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
      <p class="lead">{C.lead}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.diffTitle}</h2>
      <p class="answer">{C.diffAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.onceTitle}</h2>
      <p class="answer">{C.onceAnswer}</p>
      <ul class="checks">{C.onceList.map((x) => <li>{x}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.ongoingTitle}</h2>
      <p class="answer">{C.ongoingAnswer}</p>
      <ul class="checks">{C.ongoingList.map((x) => <li>{x}</li>)}</ul>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.priceTitle}</h2>
      <p class="answer">{C.priceAnswer}</p>
    </div>
    <div class="container">
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.tableHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.tableRows.map((r) => <tr><th scope="row">{r[0]}</th>{r.slice(1).map((c) => <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
    </div>
    <div class="container narrow">
      <p class="small muted">{C.tableNote}</p>
      <figure class="quote-fig">
        <blockquote cite={cite}><p>{C.quote}</p></blockquote>
        <QuoteCaption lang={lang} />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.decideTitle}</h2>
      <p class="answer">{C.decideAnswer}</p>
      <ol class="steps">{C.decideSteps.map((s) => <li><span>{'link' in s ? <>{s.before}<a href={t(s.key)}>{s.link}</a>{s.after}</> : s.text}</span></li>)}</ol>
      <p>{C.decideNote}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <p class="muted">{C.disclosure}</p>
      <p class="muted">{C.mistake.before} <a href={t('contact')}>{C.mistake.link}</a></p>
      <div class="post-cta">
        <p class="post-cta__title">{C.endTitle}</p>
        <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('consulting')}>{C.endCta}</a></div>
      </div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.moreTitle}</h2>
      <p class="muted">{C.moreLead}</p>
      <RelatedPosts lang={lang} keys={['postAds', 'postSelectSpecialist', 'postSeoAudit']} more={C.moreMore} />
    </div>
  </section>
</Base>
