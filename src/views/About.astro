---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import AuthorMedia from '../components/AuthorMedia.astro';
import CaseTeaser from '../components/CaseTeaser.astro';
import CtaBand from '../components/CtaBand.astro';
import { META } from '../i18n/meta';
import { path, servicesHref, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { pageProps } from '../lib/page';
import { ids } from '../lib/schema';
import { SITE } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const m = META.about[lang];

const TOOLS = ['Ahrefs', 'SEMrush', 'Screaming Frog', 'Google Analytics 4', 'Google Search Console', 'Looker Studio'];

const C = {
  cs: {
    lead: 'Za 3 roky jsem zvýšil organickou návštěvnost až o +777 % meziročně a na každém projektu dosáhl růstu 55–60 %.',
    intro: [
      'Většina rad o SEO ho redukuje na seznam úkolů: audity, klíčová slova, zpětné odkazy. Já v něm vidím systém, který mění vyhledávání v tržby.',
      'Nezačínám seznamem klíčových slov, ale obchodním modelem. Dřív než sáhnu na první stránku, chci rozumět tomu, jak firma vydělává, kdo jsou její skuteční zákazníci a co brání tomu, aby je přivedlo vyhledávání. Technické SEO, obsahová strategie, lokální SEO i strukturovaná data slouží jediné otázce: jak se z organického vyhledávání stanou tržby.',
    ],
    resultsTitle: 'Co to znamená v praxi',
    results: [
      ['KB PŘEKLADY', 'Za první 4 měsíce 8× více poptávek – přesně v termínu dohodnutém s klientem – a přes léto dalších 24×. Růst se potvrdil nezávisle na sezónní poptávce a web získal citace v Google AI Overview po boku oficiálních vládních zdrojů.'],
      ['Tiskárna', 'Z 1 200 na 10 500 návštěv měsíčně (+777 % meziročně) díky technickým opravám, obsahové strategii a soustavné on-page práci.'],
      ['Všechny projekty', 'Průměrný růst návštěvnosti 55–60 %.'],
      ['Vícejazyčné SEO', 'Strategie pro češtinu, ruštinu, ukrajinštinu a angličtinu. Obsah nepřekládám, ale přizpůsobuji tomu, co každé publikum skutečně hledá.'],
    ],
    toolsTitle: 'Nástroje',
    where: 'Sídlím v Praze a pracuji s klienty z evropských i amerických trhů.',
    alt: 'Arsenii Eranosian, SEO specialista v Praze',
    ctaTitle: 'Je SEO na vaší roadmapě? Pojďme to probrat',
    ctaText: 'Začneme bezplatným auditem a krátkým callem.',
  },
  en: {
    lead: 'Over 3 years I have scaled organic traffic by up to +777% YoY and delivered 55–60% growth on every project I have taken on.',
    intro: [
      'Most SEO advice treats SEO as a list of tasks: audits, keywords, backlinks. I treat it as a system for turning search into revenue.',
      'I start with the business model, not the keyword list. Before touching a single page, I want to understand how the business makes money, who its real customers are and what is stopping search from bringing them in. Technical SEO, content strategy, local SEO and structured data all serve that one question: how does organic search turn into revenue.',
    ],
    resultsTitle: 'What that looks like in practice',
    results: [
      ['KB PŘEKLADY', 'Leads grew 8× within the first 4 months – right on the timeline set with the client at the start – and a further 24× through the summer. The growth was confirmed independent of seasonal demand, and the site earned citations inside Google’s AI Overview alongside official government sources.'],
      ['Print shop', 'From 1,200 to 10,500 monthly visits (+777% YoY) through technical fixes, content strategy and sustained on-page work.'],
      ['Every project', '55–60% average traffic growth.'],
      ['Multilingual SEO', 'Strategies built and localised across Czech, Russian, Ukrainian and English: not just translating content, but adapting it to what each audience actually searches for.'],
    ],
    toolsTitle: 'Toolkit',
    where: 'Based in Prague, I work with clients across European and American markets.',
    alt: 'Arsenii Eranosian, SEO specialist in Prague',
    ctaTitle: 'Is SEO on your roadmap? Let’s talk',
    ctaText: 'We start with a free audit and a short call.',
  },
  ru: {
    lead: 'За 3 года я вырастил органический трафик до +777% год к году и обеспечил рост 55–60% на каждом проекте.',
    intro: [
      'Большинство советов по SEO сводят его к списку задач: аудиты, ключевые слова, обратные ссылки. Я отношусь к SEO как к системе, которая превращает поиск в выручку.',
      'Я начинаю с бизнес-модели, а не со списка ключевых слов. Прежде чем трогать хотя бы одну страницу, мне важно понять, как бизнес зарабатывает, кто его реальные клиенты и что мешает поиску приводить их. Техническое SEO, контент-стратегия, локальное SEO и структурированные данные — всё служит одному вопросу: как органический поиск превращается в выручку.',
    ],
    resultsTitle: 'Как это выглядит на практике',
    results: [
      ['KB PŘEKLADY', 'За первые 4 месяца количество заявок выросло в 8 раз — точно в срок, согласованный с клиентом в начале работы, — а за лето ещё в 24 раза. Рост подтверждён независимо от сезонного спроса, а сайт получил цитирование в Google AI Overview наряду с официальными государственными источниками.'],
      ['Типография', 'С 1 200 до 10 500 визитов в месяц (+777% год к году) за счёт технических исправлений, контент-стратегии и системной on-page работы.'],
      ['Все проекты', 'Средний рост трафика 55–60%.'],
      ['Мультиязычное SEO', 'Стратегии на чешском, русском, украинском и английском: я не просто перевожу контент, а адаптирую его под то, что каждая аудитория реально ищет.'],
    ],
    toolsTitle: 'Инструменты',
    where: 'Живу в Праге, работаю с клиентами из европейских и американских рынков.',
    alt: 'Arsenii Eranosian, SEO-специалист в Праге',
    ctaTitle: 'SEO в ваших планах? Давайте обсудим',
    ctaText: 'Начнём с бесплатного аудита и короткого созвона.',
  },
}[lang];

const profile = {
  '@type': 'ProfilePage',
  url: new URL(path('about', lang), Astro.site).href,
  mainEntity: { '@id': ids(Astro.site!).person },
};
---
<Base {...pageProps('about', lang)} schema={[profile]}>
  <PageHero h1={m.h1} lead={C.lead} />
  <section class="section section--tight">
    <div class="container split">
      <AuthorMedia alt={C.alt} eager />
      <div>
        {C.intro.map((p) => <p>{p}</p>)}
        <p class="muted">{C.where}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={path('audit', lang)}>{ui.ctaAuditLong}</a>
          <a class="btn btn--secondary" href={servicesHref(lang)}>{ui.allServices}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container">
      <h2>{C.resultsTitle}</h2>
      <div class="grid grid-2">
        {C.results.map(([h, p]) => (
          <div class="card">
            <h3>{h}</h3>
            <p class="muted">{p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.toolsTitle}</h2>
      <ul class="chips">{TOOLS.map((x) => <li>{x}</li>)}</ul>
      <p><a class="link-arrow" href={path('reviews', lang)}>{ui.allReviews}</a> · <a class="link-arrow" href={SITE.socials[0].url} rel="me noopener" target="_blank">LinkedIn</a></p>
    </div>
  </section>

  <section class="section section--grey"><div class="container"><CaseTeaser lang={lang} heading="h2" /></div></section>
  <CtaBand lang={lang} title={C.ctaTitle} text={C.ctaText} />
</Base>
