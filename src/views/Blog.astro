---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PostCard from '../components/PostCard.astro';
import { META } from '../i18n/meta';
import { DEFAULT_LANG, LANGS, ROUTES, path, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { pageProps } from '../lib/page';
import { postsByLang } from '../lib/blog';
import { dedicatedPosts } from '../data/blog-posts';
import { formatDate } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const m = META.blog[lang];
const posts = await postsByLang(lang);
const own = dedicatedPosts(lang);
const hasAny = async (l: Lang) => (await postsByLang(l)).length + dedicatedPosts(l).length > 0;

// A language version of the blog is indexable (and in hreflang) only once it has posts.
const withPosts = (await Promise.all(LANGS.map(async (l) => ((await hasAny(l)) ? l : null)))).filter((l): l is Lang => !!l);
const alternates = Object.fromEntries(withPosts.map((l) => [l, ROUTES.blog[l]]));
const empty = posts.length + own.length === 0;
const czechHasPosts = withPosts.includes(DEFAULT_LANG);

const C = {
  cs: { lead: 'Návody a postřehy z praxe: SEO, GEO/AEO, lokální SEO a vyhledávání v Google, Seznamu a AI.', emptyTitle: 'Články zatím připravuji', emptyText: 'Brzy tu najdete praktické články o SEO, GEO/AEO a lokálním vyhledávání. Mezitím se podívejte na služby nebo si nechte udělat bezplatný audit.' },
  en: { lead: 'Guides and lessons from practice: SEO, GEO/AEO, local SEO and search in Google, Seznam and AI.', emptyTitle: 'Articles are coming soon', emptyText: 'Practical articles on SEO, GEO/AEO and local search will appear here soon. Meanwhile, have a look at the services or get a free audit.' },
  ru: { lead: 'Практические статьи: SEO, GEO/AEO, локальное SEO и поиск в Google, Seznam и нейросетях.', emptyTitle: 'Статьи скоро появятся', emptyText: 'Здесь скоро появятся практические статьи об SEO, GEO/AEO и локальном поиске. А пока посмотрите услуги или закажите бесплатный аудит.' },
}[lang];
---
<Base {...pageProps('blog', lang)} alternates={alternates} langFallback={ROUTES.blog} noindex={empty}>
  <PageHero h1={m.h1} lead={C.lead} />
  <section class="section section--tight">
    <div class="container">
      {empty ? (
        <div class="card empty-state">
          <h2>{C.emptyTitle}</h2>
          <p class="muted">{C.emptyText}</p>
          <div class="btn-row">
            <a class="btn btn--primary" href={path('audit', lang)}>{ui.ctaAuditLong}</a>
          </div>
        </div>
      ) : (
        <div class="grid grid-3">
          {own.map((p) => (
            <a class="card card--link post-card" href={ROUTES[p.key][lang]}>
              {p.image && <img class="post-card-img" src={p.image.src} width={p.image.width} height={p.image.height} alt={p.image.alt} loading="lazy" decoding="async" />}
              <time class="post-card-date" datetime={p.date}>{formatDate(new Date(p.date), lang)}</time>
              <h2>{p.title}</h2>
              <p>{p.description}</p>
              <span class="link-arrow">{ui.readMore}</span>
            </a>
          ))}
          {posts.map((p) => <PostCard post={p} lang={lang} heading="h2" />)}
        </div>
      )}
      {lang !== DEFAULT_LANG && czechHasPosts && (
        <p class="note">{ui.blogOtherLang} <a href={path('blog', DEFAULT_LANG)} hreflang={DEFAULT_LANG}>{ui.blogOtherLangLink}</a></p>
      )}
    </div>
  </section>
</Base>
