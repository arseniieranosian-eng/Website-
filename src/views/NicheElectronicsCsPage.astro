---
// Niche landing page "SEO a GEO/AEO pro obchody s elektronikou" (cs), brief of 25.10.2026. Content: data/niche-electronics-cs.ts. Own structure: page types, what I do, for whom, audit scope table and
// technical checklist (+ a text link to the audit example), the maps block, the objection block (ads; no quote without written consent), cooperation with prices (single sources), FAQ.
import Base from '../layouts/Base.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { nicheElectronicsSchemas } from '../lib/schema-niche-electronics';
import { NICHE_ELECTRONICS_CS as C, NICHE_ELECTRONICS_PUBLISHED } from '../data/niche-electronics-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = [lastModified(['src/views/NicheElectronicsCsPage.astro', 'src/data/niche-electronics-cs.ts', 'src/data/consulting-shared.ts', 'src/data/start-shared.ts', 'src/data/fullseo-shared.ts'], '2026-10-25'), NICHE_ELECTRONICS_PUBLISHED].sort().pop()!;
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
---
<Base {...pageProps('nicheElectronics', lang)} schema={nicheElectronicsSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <h1>{META.nicheElectronics.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time></p>
      <p class="lead">{C.lead}</p>
      <p>{C.proofLead}{' '}<a href={t('caseHalf')}>{C.proofLink}</a>{C.proofTail}</p>
      <div class="btn-row">
        <a class="btn btn--primary btn--lg" href={t('audit')}>{C.heroAudit}</a>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.diffTitle}</h2>
      <p class="answer">{C.diffAnswer}</p>
      <p>{C.diffLead}</p>
      <ul class="checks">{C.diff.map((x) => <li>{x}</li>)}</ul>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.doTitle}</h2>
      <p class="answer">{C.doAnswer}</p>
      <ul class="checks">{C.do.map((x) => <li>{x}</li>)}</ul>
      <p>{C.doLead}{' '}{C.doLinks.map((l, i) => <>{i > 0 && ' · '}<a href={t(l.page)}>{l.text}</a></>)}. {C.doGeoLead}{' '}<a href={t('geo')}>{C.doGeoLink}</a>.</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.forTitle}</h2>
      <p class="answer">{C.forAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.auditTitle}</h2>
      <p class="answer">{C.auditAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.audit.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.audit.rows.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p>{C.auditNote}</p>
      <p>{C.auditChecksLead}</p>
      <ul class="checks">{C.auditChecks.map((x) => <li>{x}</li>)}</ul>
      <p>{C.auditLead}{' '}<a href={t('audit')}>{C.auditLink}</a>. {C.auditExampleLead}{' '}<a href={t('audit') + '#vystup-auditu'}>{C.auditExampleLink}</a>. {C.auditExampleNote}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.mapsTitle}</h2>
      <p class="answer">{C.mapsAnswer}</p>
      <p>{C.mapsLead}{' '}<a href={t('maps')}>{C.mapsLink}</a>.</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.adsTitle}</h2>
      <p class="answer">{C.adsAnswer}</p>
      <figure class="owner-quote">
        <blockquote cite={new URL(t('nicheElectronics'), site).href}><p>{C.adsQuote.text}</p></blockquote>
        <figcaption>
          <img src={C.adsQuote.photo.src} width={C.adsQuote.photo.width} height={C.adsQuote.photo.height} alt={C.adsQuote.photo.alt} loading="lazy" decoding="async" />
          <span>— <a href={C.adsQuote.instagram} rel="me noopener nofollow" target="_blank">{C.adsQuote.name}</a>, {C.adsQuote.role}, {C.adsQuote.city}</span>
        </figcaption>
      </figure>
      <p class="muted small">{C.adsQuote.disclosure}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.coopTitle}</h2>
      <p class="answer">{C.coopAnswer}</p>
      <p>{C.coopLinks.map((l, i) => <>{i > 0 && ' · '}<a class="link-arrow" href={t(l.page)}>{l.text}</a></>)}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}</div>
    </div>
  </section>

  <section class="section section--dark cta-band">
    <div class="container cta-inner">
      <div>
        <h2>{C.endTitle}</h2>
        <p>{C.endText}</p>
        <p class="small">{C.updatedLabel}: <time datetime={MOD}>{modText}</time></p>
      </div>
      <div class="btn-row">
        <a class="btn btn--primary btn--lg" href={t('audit')}>{C.endCta}</a>
      </div>
    </div>
  </section>
</Base>
