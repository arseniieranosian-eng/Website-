---
// Blog article "Co jsem zjistil na webech obchodů s elektronikou v Praze" (cs), brief of 13.11.2026. Content: data/post-electronics-obs-cs.ts.
// Body links: the three Google sources (visible dates) and the one related article; the CTA has ONE button to the landing page /seo-pro-obchody-s-elektronikou/ (no prices, no capacity phrase here). The author's quote
// (rule J) is a plain blockquote without Quotation markup. No site, chain, catalogue, portal or map service is named.
import Base from '../layouts/Base.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { postElectronicsObsSchemas } from '../lib/schema-post-electronics-obs';
import { POST_ELECTRONICS_OBS_CS as C, POST_ELECTRONICS_OBS_PUBLISHED } from '../data/post-electronics-obs-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = [lastModified(['src/views/PostElectronicsObsCsPage.astro', 'src/data/post-electronics-obs-cs.ts'], '2026-11-13'), POST_ELECTRONICS_OBS_PUBLISHED].sort().pop()!;
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-obchody-s-elektronikou-praha-co-jsem-zjistil.png';
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
const cite = new URL(path('postElectronicsObs', lang), site).href;
---
<Base {...pageProps('postElectronicsObs', lang)} ogType="article" ogImage={OG} schema={postElectronicsObsSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postElectronicsObs.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container narrow">
      <div class="summary-box"><p class="lead">{C.summary}</p></div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.methodTitle}</h2>
      <p class="answer">{C.methodAnswer}</p>
      <p>{C.methodAbove}</p>
      <p>{C.methodListLead}</p>
      <ul class="checks">{C.methodList.map((x) => <li>{x}</li>)}</ul>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.typesTitle}</h2>
      <p class="answer">{C.typesAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.typesHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.typesRows.map((r) => <tr><th scope="row">{r[0]}</th>{r.slice(1).map((c) => <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.commonTitle}</h2>
      <p class="answer">{C.commonAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.commonHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.commonRows.map((r) => <tr><th scope="row">{r[0]}</th>{r.slice(1).map((c) => <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p>{C.commonNote}</p>
      <figure class="quote-fig">
        <blockquote cite={cite}><p>{C.quote}</p></blockquote>
        <QuoteCaption lang={lang} />
      </figure>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.weakTitle}</h2>
      <p class="answer">{C.weakAnswer}</p>
      <p class="small muted">{C.sourceLabel} {C.weakSource.before}{' '}<a href={C.weakSource.href} target="_blank" rel="noopener">{C.weakSource.href}</a>{C.weakSource.after}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.checkTitle}</h2>
      <p class="answer">{C.checkAnswer}</p>
      <ol class="steps">{C.checkSteps.map((s) => <li><span>{s}</span></li>)}</ol>
      <p class="small muted">{C.checkSourcesLabel} {C.checkSources.map((s, i) => <>{i > 0 && '; '}<a href={s.href} target="_blank" rel="noopener">{s.href}</a>{s.after}</>)}.</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <p>{C.relatedLead} <a href={t('postDupEshop')}>{META.postDupEshop.cs.h1}</a></p>
      <p class="muted">{C.disclosure}</p>
      <div class="post-cta">
        <p class="post-cta__text">{C.endText}</p>
        <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('nicheElectronics')}>{C.endCta}</a></div>
      </div>
      <p class="muted">{C.mistake}</p>
    </div>
  </section>
</Base>
