---
// Niche landing page "SEO pro překladatelské agentury v Praze" (cs), brief of 22.10.2026. Content: data/niche-translation-cs.ts (+ niche-shared.ts).
// Main CTA: the free audit. No blog links. The video block appears only when NICHE_VIDEO is set (see the data file).
import Base from '../layouts/Base.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { nicheTranslationSchemas } from '../lib/schema-niche-translation';
import { NICHE_CS as C, NICHE_VIDEO as V } from '../data/niche-translation-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = lastModified(['src/views/NicheTranslationCsPage.astro', 'src/data/niche-translation-cs.ts', 'src/data/niche-shared.ts', 'src/data/case-summary.ts'], '2026-10-22');
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const cite = new URL(t('nicheTranslation'), site).href;
const tc = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
---
<Base {...pageProps('nicheTranslation', lang)} schema={nicheTranslationSchemas(site, C, { modified: MOD })}>
  <!-- HERO -->
  <section class="page-hero">
    <div class="container narrow">
      <h1>{META.nicheTranslation.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time></p>
      <p class="lead">{C.lead}</p>
      <div class="btn-row">
        <a class="btn btn--primary btn--lg" href={t('audit')}>{C.heroAudit}</a>
        {V && <a class="link-arrow" href="#rozbor-webu">{C.heroVideoLink}</a>}
      </div>
    </div>
  </section>

  <!-- WHY SEO -->
  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.whyTitle}</h2>
      <p class="answer">{C.whyAnswer}</p>
      <ul class="checks">{C.why.map((x) => <li>{x}</li>)}</ul>
      <p>{C.whyText}</p>
    </div>
  </section>

  <!-- WHAT I DO + author quote -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.doTitle}</h2>
      <p class="answer">{C.doAnswer}</p>
      <p>{C.doIntro}</p>
      {C.do.map((x) => <><h3>{x.h}</h3><p>{x.text}</p></>)}
      <figure class="quote-fig" style="margin-top: 28px">
        <blockquote cite={cite}><p>{C.quote}</p></blockquote>
        <QuoteCaption lang={lang} />
      </figure>
    </div>
  </section>

  <!-- VIDEO: market review (only when the video, chapters and transcript exist) -->
  {V && (
    <section class="section" id="rozbor-webu">
      <div class="container narrow">
        <h2>{C.videoTitle}</h2>
        <p class="answer">{V.intro}</p>
        <figure class="audit-video">
          <video controls preload="none" poster={V.poster} width={V.width} height={V.height}><source src={V.src} type="video/mp4" /></video>
          <figcaption class="muted small">{C.videoRecordedLabel}: {V.recorded}</figcaption>
        </figure>
        <h3>{C.videoChaptersTitle}</h3>
        <ol class="steps">{V.chapters.map((c) => <li><span>{tc(c.start)} · {c.title}</span></li>)}</ol>
        <h3>{C.videoObsTitle}</h3>
        <ul class="checks">{V.observations.map((x) => <li>{x}</li>)}</ul>
        <details><summary>{C.videoTranscriptTitle}</summary><p>{V.transcript}</p></details>
        <p class="muted small">{V.contact}</p>
      </div>
    </section>
  )}

  <!-- CASE -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.caseTitle}</h2>
      <p class="answer">{C.caseAnswer}</p>
      <p class="card">{C.caseFormula}</p>
      <p class="muted small">{C.caseNote}</p>
      <p><a class="link-arrow" href={t('caseHalf')}>{C.caseLink}</a></p>
    </div>
  </section>

  <!-- HOW I WORK -->
  <section class="section">
    <div class="container narrow">
      <h2>{C.coopTitle}</h2>
      <p class="answer">{C.coopAnswer}</p>
      <ol class="steps">{C.coopSteps.map((s) => <li><span>{s}</span></li>)}</ol>
    </div>
  </section>

  <!-- FREE AUDIT -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.auditTitle}</h2>
      <p class="answer">{C.auditAnswer}</p>
      <p>{C.auditNotLead}</p>
      <ul class="checks">{C.auditNot.map((x) => <li>{x}</li>)}</ul>
      <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('audit')}>{C.auditCta}</a></div>
    </div>
  </section>

  <!-- FORMATS (no prices) -->
  <section class="section">
    <div class="container narrow">
      <h2>{C.formatsTitle}</h2>
      <p class="answer">{C.formatsAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.formats.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.formats.rows.map((r) => <tr><th scope="row"><a href={t(r.page)}>{r.label}</a></th><td>{r.who}</td><td>{r.what}</td></tr>)}</tbody>
        </table>
      </div>
      <p>{C.formatsNote}</p>
    </div>
  </section>

  <!-- REVIEWS (shared source: only a link while there are no reviews from translation agencies) -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.reviewsTitle}</h2>
      <p class="answer">{C.reviewsAnswer}</p>
      <p><a class="link-arrow" href={t('reviews')}>{C.reviewsLink}</a></p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}</div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section section--dark cta-band">
    <div class="container cta-inner">
      <div>
        <h2>{C.endTitle}</h2>
        <p>{C.endText}</p>
        <p class="small">{C.updatedLabel}: <time datetime={MOD}>{modText}</time></p>
      </div>
      <div class="btn-row">
        <a class="btn btn--primary btn--lg" href={t('audit')}>{C.endCta}</a>
        <a class="btn btn--ghost-light btn--lg" href={t('contact')}>{C.endContact}</a>
      </div>
    </div>
  </section>
</Base>
