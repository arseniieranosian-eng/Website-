---
// /ru/full-seo/ built from the brief of 19.10.2026. Content: data/fullseo-ru.ts, price: data/fullseo-shared.ts.
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import ReviewCards from '../components/ReviewCards.astro';
import { META } from '../i18n/meta';
import { path, servicesHref } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { fullSeoSchemas } from '../lib/schema-fullseo';
import { FULLSEO_RU as C } from '../data/fullseo-ru';
import { reviewsWithFallback } from '../data/reviews';
import { serviceByKey } from '../data/services';

const lang = C.lang;
const site = Astro.site!;

// Visible date and JSON-LD dateModified both come from git (see lib/lastmod.ts).
const MOD = lastModified(['src/views/FullSeoPage.astro', 'src/data/fullseo-ru.ts', 'src/data/fullseo-shared.ts', 'src/data/start-shared.ts', 'src/data/reviews.ts'], '2026-10-19');
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${String(d).padStart(2, '0')}.${String(mo).padStart(2, '0')}.${y}`;

// 1-3 reviews tagged with this service; prefer those originally written in Russian.
const reviews = reviewsWithFallback('fullSeo', 3, 1, 'ru');
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const name = (k: keyof typeof META) => META[k][lang].name;
const others = [
  { key: 'audit', text: C.audit },
  { key: 'consulting', text: '' },
  { key: 'start', text: '' },
  { key: 'maps', text: '' },
] as const;
---
<Base {...pageProps('fullSeo', lang)} schema={fullSeoSchemas(site, C, { modified: MOD, reviews })}>
  <!-- HERO -->
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">{C.packageName}</p>
      <h1>{C.h1}</h1>
      <p class="updated">{C.updatedLabel}: <time datetime={MOD}>{modText}</time></p>
      <p class="lead">{C.lead}</p>
      <p class="price-badge">{C.badge}</p>
      <div class="btn-row">
        <a class="btn btn--primary btn--lg" href="#form">{C.heroPrimary}</a>
        <a class="btn btn--secondary btn--lg" href={t('audit')}>{C.heroAudit}</a>
      </div>
    </div>
  </section>

  <!-- PRICE -->
  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.priceTitle}</h2>
      <p class="answer">{C.priceAnswer}</p>
      <p class="muted small">{C.priceNote}</p>
    </div>
  </section>

  <!-- WHAT IS INCLUDED: three groups -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.includesTitle}</h2>
      {C.groups.map((g) => (
        <div class="include-group">
          <h3>{g.title}</h3>
          <ul class="checks">
            {g.items.map((i) => {
              const l = i.link;
              if (!l) return <li>{i.text}</li>;
              const [before, after] = i.text.split(l.part);
              return <li><span>{before}<a href={t(l.page)}>{l.part}</a>{after}</span></li>;
            })}
          </ul>
        </div>
      ))}
      <p class="muted">{C.contentExample}</p>
    </div>
  </section>

  <!-- HOW THE WORK GOES -->
  <section class="section">
    <div class="container">
      <h2>{C.stagesTitle}</h2>
      <ol class="steps steps--row">{C.stages.map((st) => <li>{st.text}</li>)}</ol>
    </div>
  </section>

  <!-- RESULTS -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.resultsTitle}</h2>
      <p class="answer">{C.resultsAnswer}</p>
      <p>{C.resultsNote}</p>
    </div>
  </section>

  <!-- WHO IT IS FOR -->
  <section class="section">
    <div class="container narrow">
      <h2>{C.forWhomTitle}</h2>
      <ul class="checks">{C.forWhom.map((x) => <li>{x}</li>)}</ul>
    </div>
  </section>

  <!-- MAPS -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.mapsTitle}</h2>
      <p>{C.mapsBefore}<a href={t('start')}>{C.mapsStartLink}</a>{C.mapsAfter}</p>
      <p>{C.mapsOnly} <a href={t('maps')}>{name('maps')}</a></p>
    </div>
  </section>

  <!-- FULL SEO OR START -->
  <section class="section">
    <div class="container narrow">
      <h2>{C.compareTitle}</h2>
      <p>{C.compare.before}<a href={t('start')}>{C.compare.startLink}</a>{C.compare.after}</p>
      <p>{C.consultingNote.before}<a href={t('consulting')}>{C.consultingNote.link}</a>{C.consultingNote.after}</p>
    </div>
  </section>

  <!-- CASE -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.caseTitle}</h2>
      <p>{C.caseText}</p>
      <a class="link-arrow" href={t('caseKb')}>{C.caseLink}</a>
    </div>
  </section>

  <!-- REVIEWS (shared data source) -->
  <section class="section">
    <div class="container">
      <div class="section-head"><h2>{C.reviewsTitle}</h2><a class="link-arrow" href={t('reviews')}>{C.reviewsLink}</a></div>
      <ReviewCards reviews={reviews} lang={lang} compact />
    </div>
  </section>

  <!-- FAQ: answers are visible, not hidden in tabs -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">
        {C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}
      </div>
      <p><a class="link-arrow" href={t('faq')}>{C.faqAll}</a></p>
    </div>
  </section>

  <!-- FORM -->
  <section class="section" id="form">
    <div class="container narrow">
      <h2>{C.formTitle}</h2>
      <div class="card"><LeadForm lang={lang} id="service-fullseo" service="fullSeo" /></div>
    </div>
  </section>

  <!-- OTHER SERVICES -->
  <section class="section section--grey">
    <div class="container">
      <div class="section-head"><h2>{C.otherTitle}</h2><a class="link-arrow" href={servicesHref(lang)}>{C.otherAll}</a></div>
      <div class="grid grid-3">
        {others.map((o) => (
          <a class="card card--link" href={t(o.key)}>
            <h3>{name(o.key)}</h3>
            <p>{o.text || serviceByKey(o.key as 'consulting' | 'start' | 'maps').short[lang]}</p>
            <span class="link-arrow">{C.more}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
