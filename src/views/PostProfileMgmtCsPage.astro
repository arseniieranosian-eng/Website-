---
// Blog article "Jednorázové nastavení profilů, nebo průběžná správa v mapách?" (cs), brief of 23.11.2026 (comparative series, article 3). Content: data/post-profile-mgmt-cs.ts.
// A comparison of ways of working with profiles (not of contractors): no names, no outside prices, no promises. Body links: five help sources, ONE link to the profile article (inside H2-6), the policy source; the closing block has ONE button to /lokalni-seo-mapy/ and no text link (rule F).
import Base from '../layouts/Base.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { postProfileMgmtSchemas } from '../lib/schema-post-profile-mgmt';
import { POST_PROFMGMT_CS as C, POST_PROFMGMT_MODIFIED } from '../data/post-profile-mgmt-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = POST_PROFMGMT_MODIFIED; // set by hand, not from git
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-jednorazove-nastaveni-profilu-nebo-sprava-map.png';
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
const cite = new URL(path('postProfileMgmt', lang), site).href;
---
<Base {...pageProps('postProfileMgmt', lang)} ogType="article" ogImage={OG} schema={postProfileMgmtSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postProfileMgmt.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
      <p class="lead">{C.lead}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.diffTitle}</h2>
      <p class="answer">{C.diffAnswer}</p>
    </div>
    <div class="container">
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.tableHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.tableRows.map((r) => <tr><th scope="row">{r[0]}</th>{r.slice(1).map((c) => <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
    </div>
    <div class="container narrow">
      <p class="small muted">{C.tableNote}</p>
      <figure class="quote-fig">
        <blockquote cite={cite}><p>{C.quote}</p></blockquote>
        <QuoteCaption lang={lang} />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.onceTitle}</h2>
      <p class="answer">{C.onceAnswer}</p>
      <ul class="checks">{C.onceList.map((s) => <li>{s}</li>)}</ul>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.ongoingTitle}</h2>
      <p class="answer">{C.ongoingAnswer}</p>
      <ul class="checks">{C.ongoingList.map((s) => <li>{s}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.helpTitle}</h2>
      <p class="answer">{C.helpAnswer}</p>
      <ul class="checks">{C.helpList.map((s) => <li>{s}</li>)}</ul>
      <p class="small muted">{C.sourcesLabel}</p>
      <ul class="small muted">{C.helpSources.map((s) => <li>{s.text}: <a href={s.href} target="_blank" rel="noopener">{s.href}</a></li>)}</ul>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.priceTitle}</h2>
      <p class="answer">{C.priceAnswer}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.rightTitle}</h2>
      <p class="answer">{C.rightAnswer.before}<a href={t('postDentalProfile')}>{C.rightAnswer.link}</a>{C.rightAnswer.after}</p>
      <ol class="steps">{C.rightSteps.map((s) => <li><span>{s}</span></li>)}</ol>
      <p class="small muted">{C.rightSource.before} <a href={C.rightSource.href} target="_blank" rel="noopener">{C.rightSource.href}</a>{C.rightSource.after}</p>
      <p>{C.rightNote}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.notTitle}</h2>
      <p class="answer">{C.notAnswer}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}</div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <p class="muted">{C.disclosure}</p>
      <p class="muted">{C.mistake.before} <a href={t('contact')}>{C.mistake.link}</a></p>
      <div class="post-cta">
        <p class="post-cta__title">{C.endTitle}</p>
        <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('maps')}>{C.endCta}</a></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.moreTitle}</h2>
      <p class="muted">{C.moreLead}</p>
      <RelatedPosts lang={lang} keys={['postOneTime', 'postAccountingLocal', 'postDentalWebMaps']} more={C.moreMore} />
    </div>
  </section>
</Base>
