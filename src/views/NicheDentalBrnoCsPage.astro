---
// Niche landing page "SEO pro zubní ordinace Brno" (cs), brief of 27.11.2026. DRAFT: built only when NICHE_READY.nicheDentalBrno is true (routes.ts; false = not built). Structure of the Prague page; texts: data/niche-dental-brno-cs.ts.
// Block 4 (observation of the Brno results) is rendered only when the author's data exist (NICHE_DENTAL_BRNO_OBS); no quote, no video, no Review / Offer markup.
import Base from '../layouts/Base.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { nicheDentalBrnoSchemas } from '../lib/schema-niche-dental-brno';
import { NICHE_DENTAL_BRNO_CS as C, NICHE_DENTAL_BRNO_OBS as OBS, NICHE_DENTAL_BRNO_PUBLISHED } from '../data/niche-dental-brno-cs';
// Sections alternate white / grey; block 4 (when the data exist) shifts the ones after it.
const b = (n: number) => (n % 2 ? 'section section--grey' : 'section');

const lang = C.lang;
const site = Astro.site!;
const MOD = NICHE_DENTAL_BRNO_PUBLISHED; // set by hand by the author (draft date = the date of the brief)
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
// "{key|text}" in an answer becomes a link to the page `key`.
const parts = (s: string) => s.split(/(\{[a-zA-Z]+\|[^}]+\})/).filter(Boolean).map((p) => {
  const m = p.match(/^\{([a-zA-Z]+)\|([^}]+)\}$/);
  return m ? { href: t(m[1] as Parameters<typeof path>[0]), text: m[2] } : { text: p };
});
---
<Base {...pageProps('nicheDentalBrno', lang)} schema={nicheDentalBrnoSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <h1>{META.nicheDentalBrno.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time></p>
      <p>{C.proof}</p>
      <div class="summary-box"><p class="lead">{C.lead}</p></div>
      <div class="btn-row">
        <a class="btn btn--primary btn--lg" href={t('audit')}>{C.heroAudit}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.coopTitle}</h2>
      <figure class="case-figure">
        <img src="/images/niche-dental-spoluprace.webp" width="1200" height="675" alt="Ilustrace: zubní ordinace, vyhledávání Google a AI, mapa s profilem ordinace a graf" loading="lazy" decoding="async" />
      </figure>
      <p class="answer">{parts(C.coopAnswer).map((p) => p.href ? <a href={p.href}>{p.text}</a> : p.text)}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.priceTitle}</h2>
      <p class="answer">{C.priceAnswer}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.expTitle}</h2>
      <p class="answer">{C.expAnswer}</p>
    </div>
  </section>

  {OBS && (
    <section class="section section--grey">
      <div class="container narrow">
        <h2>{OBS.title}</h2>
        <p class="answer">{OBS.answer}</p>
        <ul class="checks">{OBS.list.map((x) => <li>{x}</li>)}</ul>
        <p class="muted small">{OBS.method}</p>
      </div>
    </section>
  )}

  <section class={b(OBS ? 0 : 1)}>
    <div class="container narrow">
      <h2>{C.brnoTitle}</h2>
      <p class="answer">{C.brnoAnswer}</p>
    </div>
  </section>

  <section class={b(OBS ? 1 : 0)}>
    <div class="container narrow">
      <h2>{C.doTitle}</h2>
      <p class="answer">{C.doAnswer}</p>
    </div>
  </section>

  <section class={b(OBS ? 0 : 1)} id="znamylekar">
    <div class="container narrow">
      <h2>{C.zlTitle}</h2>
      <p class="answer">{C.zlAnswer}</p>
      <figure class="case-figure">
        <img src="/images/niche-dental-znamylekar.webp" width="1176" height="545" alt="Úvodní stránka portálu ZnamyLekar.cz s vyhledáváním lékařů" loading="lazy" decoding="async" />
      </figure>
      <p>{C.zlData}</p>
      <p>{C.zlFull}</p>
      <p>{C.zlDoctor}</p>
    </div>
  </section>

  <section class={b(OBS ? 1 : 0)}>
    <div class="container narrow">
      <h2>{C.fitTitle}</h2>
      <p class="answer">{C.fitAnswer}</p>
    </div>
  </section>

  <section class={b(OBS ? 0 : 1)}>
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}</div>
      <p class="muted">{C.disclosure}</p>
      <p class="muted">{C.mistake.before} <a href={t('contact')}>{C.mistake.link}</a></p>
    </div>
  </section>

  <section class={b(OBS ? 1 : 0)}>
    <div class="container narrow">
      <h2>Další články</h2>
      <RelatedPosts lang={lang} keys={['postDentalWebMaps', 'postDentalProfile', 'postProfileMgmt', 'postFaqDental', 'postDentalChannels', 'postWeakSeoDental']} more="Číst článek" />
    </div>
  </section>

  <section class="section section--dark cta-band">
    <div class="container cta-inner">
      <div>
        <h2>{C.endTitle}</h2>
        <p>{C.endText}</p>
      </div>
      <div class="btn-row">
        <a class="btn btn--primary btn--lg" href={t('audit')}>{C.endCta}</a>
      </div>
    </div>
  </section>
</Base>
