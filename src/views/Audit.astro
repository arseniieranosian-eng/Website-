---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import LeadForm from '../components/LeadForm.astro';
import FaqList from '../components/FaqList.astro';
import ReviewCards from '../components/ReviewCards.astro';
import CaseTeaser from '../components/CaseTeaser.astro';
import Icon from '../components/Icon.astro';
import { META } from '../i18n/meta';
import { path, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { pageProps } from '../lib/page';
import { faqFor } from '../data/faq';
import { featuredReviews } from '../data/reviews';
import { faqSchema } from '../lib/schema';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const m = META.audit[lang];
const faq = faqFor('audit');

const C = {
  cs: {
    lead: 'Pošlete mi adresu webu. Do 24 hodin dostanete stručný report s tím, co vás brzdí a co opravit jako první. Zdarma a bez závazků.',
    whatTitle: 'Co zkontroluji',
    what: [
      ['Technické SEO', 'Indexace, rychlost, Core Web Vitals, mobilní verze, chyby a duplicity.'],
      ['Klíčová slova', 'Na co se zobrazujete, na co byste měli a kde jsou největší příležitosti.'],
      ['Konkurence', 'Kdo vás předbíhá ve výsledcích a proč.'],
      ['Mapy a lokální SEO', 'Profil na Google Maps a Mapy.com, recenze, firemní údaje.'],
      ['Viditelnost v AI', 'Zda vás zmiňují ChatGPT, Gemini a Google AI Overviews.'],
    ],
    howTitle: 'Jak to probíhá',
    how: ['Vyplníte formulář', 'Projdu web a připravím report', 'Do 24 hodin dostanete report, bez callu', 'Rozhodnete se, zda pokračovat'],
    formTitle: 'Požádat o bezplatný audit',
  },
  en: {
    lead: 'Send me your website address. Within 24 hours you get a short presentation with the main technical errors. Free, no call and no obligation.',
    whatTitle: 'What the free audit checks',
    what: [
      ['Indexing', 'Pages Google cannot or will not index.'],
      ['Duplicates', 'Duplicate pages and content, repeated headings and meta descriptions.'],
      ['Other technical errors', 'Technical problems of the site that affect how it shows up in search.'],
    ],
    howTitle: 'How it works',
    how: ['You fill in the form with your website address', 'I review the site and prepare a presentation', 'Within 24 hours you get it, no call', 'You decide whether to continue'],
    formTitle: 'Request a free audit',
  },
  ru: {
    lead: 'Пришлите адрес сайта. В течение 24 часов вы получите краткий отчёт: что мешает росту и что исправить в первую очередь. Бесплатно и без обязательств.',
    whatTitle: 'Что я проверяю',
    what: [
      ['Техническое SEO', 'Индексация, скорость, Core Web Vitals, мобильная версия, ошибки и дубли.'],
      ['Ключевые слова', 'По каким запросам вы видны, по каким должны быть и где главные точки роста.'],
      ['Конкуренты', 'Кто обходит вас в выдаче и почему.'],
      ['Карты и локальное SEO', 'Профиль в Google Maps и Mapy.com, отзывы, данные компании.'],
      ['Видимость в нейросетях', 'Упоминают ли вас ChatGPT, Gemini и Google AI Overviews.'],
    ],
    howTitle: 'Как это работает',
    how: ['Вы заполняете форму', 'Я изучаю сайт и готовлю отчёт', 'В течение 24 часов получаете отчёт, без созвона', 'Вы решаете, продолжать ли работу'],
    formTitle: 'Заказать бесплатный аудит',
  },
}[lang];
---
<Base {...pageProps('audit', lang)} schema={[faqSchema(faq, lang)]}>
  <PageHero h1={m.h1} lead={C.lead} />
  <section class="section section--tight">
    <div class="container split split--form">
      <div>
        <h2>{C.whatTitle}</h2>
        <ul class="feature-list">
          {C.what.map(([h, p]) => <li><Icon name="check" /><div><strong>{h}</strong><p>{p}</p></div></li>)}
        </ul>
        <h2>{C.howTitle}</h2>
        <ol class="steps">{C.how.map((s) => <li>{s}</li>)}</ol>
      </div>
      <div class="card sticky-form" id="form">
        <LeadForm lang={lang} id="audit-page" title={C.formTitle} />
      </div>
    </div>
  </section>
  <section class="section section--grey">
    <div class="container">
      <div class="section-head"><h2>{ui.reviewsTitle}</h2><a class="link-arrow" href={path('reviews', lang)}>{ui.allReviews}</a></div>
      <ReviewCards reviews={featuredReviews(3)} lang={lang} compact />
    </div>
  </section>
  <section class="section">
    <div class="container"><CaseTeaser lang={lang} heading="h2" /></div>
  </section>
  {lang === 'en' && (
    <section class="section section--tight">
      <div class="container narrow">
        <h2>Want a review with a 12-month plan?</h2>
        <p>The free audit checks only technical errors. If you want a website review with growth points and a 12-month plan, see the paid <a href={path('consulting', lang)}>SEO consulting in Prague</a>.</p>
      </div>
    </section>
  )}
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{ui.faqTitle}</h2>
      <FaqList items={faq} lang={lang} />
      <p><a class="link-arrow" href={path('faq', lang)}>{ui.allFaq}</a></p>
    </div>
  </section>
</Base>
