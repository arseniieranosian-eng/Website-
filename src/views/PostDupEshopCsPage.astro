---
// Blog article "Jak vznikají duplicitní stránky v e-shopu s tiskovými produkty?" (cs), brief A2 of 04.11.2026. Content: data/post-dup-eshop-cs.ts.
// Informational: no links in the body; the author's quote (rule J) is a plain blockquote without Quotation markup; the closing block has ONE button (to the free audit).
import Base from '../layouts/Base.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { postDupEshopSchemas } from '../lib/schema-post-dup-eshop';
import { POST_DUP_ESHOP_CS as C, POST_DUP_ESHOP_PUBLISHED } from '../data/post-dup-eshop-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = [lastModified(['src/views/PostDupEshopCsPage.astro', 'src/data/post-dup-eshop-cs.ts'], '2026-11-04'), POST_DUP_ESHOP_PUBLISHED].sort().pop()!;
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-duplicitni-stranky-eshop-tisk-varianty.png';
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
const cite = new URL(path('postDupEshop', lang), site).href;
---
<Base {...pageProps('postDupEshop', lang)} ogType="article" ogImage={OG} schema={postDupEshopSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postDupEshop.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
      <p class="lead">{C.lead} {C.leadLink.before}<a href={t('postDuplicates')}>{C.leadLink.text}</a>{C.leadLink.after}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.originTitle}</h2>
      <p class="answer">{C.originAnswer}</p>
      <p class="small muted">{C.sourceLabel} <a href={C.originSource.href} rel="noopener">{C.originSource.text}</a></p>
      <figure class="quote-fig">
        <blockquote cite={cite}><p>{C.quote}</p></blockquote>
        <QuoteCaption lang={lang} />
      </figure>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.ownTitle}</h2>
      <p class="answer">{C.ownAnswer}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.filtersTitle}</h2>
      <p class="answer">{C.filtersAnswer}</p>
      <p class="small muted">{C.sourceLabel} <a href={C.filtersSource.href} rel="noopener">{C.filtersSource.text}</a></p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.canonTitle}</h2>
      <p class="answer">{C.canonAnswer}</p>
      <p class="small muted">{C.sourceLabel} <a href={C.canonSource.href} rel="noopener">{C.canonSource.text}</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.checkTitle}</h2>
      <p class="answer">{C.checkAnswer}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}</div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <p class="muted">{C.disclosure}</p>
      <div class="post-cta">
        <p class="post-cta__title">{C.endTitle}</p>
        <p class="post-cta__text">{C.endText}</p>
        <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('nicheTypography')}>{C.endCta}</a></div>
      </div>
    </div>
  </section>
</Base>
