---
// Blog article "SEO a reklama: proč reklama funguje lépe na optimalizovaném webu" (cs), brief of 21.10.2026. Content: data/post-ads-cs.ts.
// Main CTA: SEO start na 3 měsíce (+ consultation); the free audit is only a soft text link, not a button.
import Base from '../layouts/Base.astro';
import IndexIllustration from '../components/IndexIllustration.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { postAdsSchemas } from '../lib/schema-post-ads';
import { POST_ADS_CS as C } from '../data/post-ads-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = lastModified(['src/views/PostAdsCsPage.astro', 'src/data/post-ads-cs.ts', 'src/components/IndexIllustration.astro'], '2026-10-21');
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-seo-a-reklama.png';
const cite = new URL(t('postAds'), site).href;
const q2 = C.quote2Person;
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
---
<Base {...pageProps('postAds', lang)} ogType="article" ogImage={OG} schema={postAdsSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postAds.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
      <p class="lead">{C.lead}</p>
      <p>{C.forWhom}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.diffTitle}</h2>
      <p class="answer">{C.diffAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.diff.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.diff.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p>{C.diffText} {C.diffLead} <a href={t('geo')}>{C.diffLinkText}</a>.</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.costTitle}</h2>
      <p class="answer">{C.costAnswer}</p>
      <p>{C.costText}</p>
      <figure class="quote-fig">
        <blockquote cite={cite}><p>{C.quote1}</p></blockquote>
        <QuoteCaption lang={lang} />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.helpTitle}</h2>
      <p class="answer">{C.helpAnswer}</p>
      <ul class="checks">{C.help.map((x) => <li>{x}</li>)}</ul>
      <p>{C.helpText}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.badTitle}</h2>
      <p class="answer">{C.badAnswer}</p>
      <ul class="checks">{C.bad.map((x) => <li>{x}</li>)}</ul>
      <p>{C.badText}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.orderTitle}</h2>
      <p class="answer">{C.orderAnswer}</p>
      <figure class="post-figure"><IndexIllustration kind="flow" aria={C.figure.aria} /><figcaption>{C.figure.caption}</figcaption></figure>
      <ol class="steps">{C.orderSteps.map((s) => <li><span>{s}</span></li>)}</ol>
      <p>{C.bridgeA} <a href={t('start')}>{C.bridgeStartLink}</a>. {C.bridgeB} <a href={t('consulting')}>{C.bridgeConsultLink}</a>.</p>
      <p>{C.softLead} <a href={t('audit')}>{C.softLinkText}</a>.</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.firstTitle}</h2>
      <p class="answer">{C.firstAnswer}</p>
      <p>{C.firstText}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.readyTitle}</h2>
      <p class="answer">{C.readyAnswer}</p>
      <figure class="owner-quote">
        <blockquote cite={cite}><p>{C.quote2}</p></blockquote>
        <figcaption>
          <img src={q2.photo.src} width={q2.photo.width} height={q2.photo.height} alt={q2.photo.alt} loading="lazy" decoding="async" />
          <span>— <a href={q2.instagram} rel="me noopener nofollow" target="_blank">{q2.name}</a>, {q2.role}</span></figcaption>
      </figure>
      <ol class="steps">{C.ready.map((s) => <li><span>{s}</span></li>)}</ol>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.endTitle}</h2>
      <p>{C.endText}</p>
      <div class="btn-row">
        <a class="btn btn--primary btn--lg" href={t('start')}>{C.ctaStart}</a>
        <a class="btn btn--secondary btn--lg" href={t('consulting')}>{C.ctaConsult}</a>
      </div>
      <p class="muted">{C.authorNote} <a href={t('about')}>{C.authorLinkText}</a>.</p>
    </div>
  </section>
</Base>
