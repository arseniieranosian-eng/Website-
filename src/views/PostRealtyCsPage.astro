---
// Blog article N1 "Jak získat klienty pro realitní kancelář: přehled kanálů" (cs), brief of 23.10.2026. Content: data/post-realty-cs.ts.
// Hub of the real-estate funnel; the quote is shown only when QUOTE_CONFIRMED is true; no portal names, no figures.
import Base from '../layouts/Base.astro';
import PostCta from '../components/PostCta.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { postRealtySchemas } from '../lib/schema-post-realty';
import { POST_REALTY_CS as C, QUOTE_CONFIRMED } from '../data/post-realty-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = lastModified(['src/views/PostRealtyCsPage.astro', 'src/data/post-realty-cs.ts'], '2026-10-22');
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-jak-ziskat-klienty-realitni-kancelar.png';
const cite = new URL(t('postRealty'), site).href;
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
---
<Base {...pageProps('postRealty', lang)} ogType="article" ogImage={OG} schema={postRealtySchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postRealty.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
      <p class="lead">{C.lead}</p>
      <p>{C.forWhom}</p>
      <p class="muted small">{C.tocTitle}:</p>
      <ol class="toc">{C.toc.map((x) => <li><a href={`#${x.id}`}>{x.text}</a></li>)}</ol>
    </div>
  </section>

  <section class="section section--tight" id="kanaly">
    <div class="container narrow">
      <h2>{C.channelsTitle}</h2>
      <p class="answer">{C.channelsAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.channels.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.channels.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p class="muted small">{C.channelsNote}</p>
    </div>
  </section>

  <section class="section section--grey" id="portaly">
    <div class="container narrow">
      <h2>{C.portalsTitle}</h2>
      <p class="answer">{C.portalsAnswer}</p>
    </div>
  </section>

  <section class="section" id="web">
    <div class="container narrow">
      <h2>{C.webTitle}</h2>
      <p class="answer">{C.webAnswer}</p>
      <p>{C.webPortalsLead}{' '}<a href={t('postRealtyPortals')}>{C.webPortalsLinkText}</a>. {C.webLead}{' '}<a href={t('postRealtyNoLeads')}>{C.webLinkText}</a>.</p>
    </div>
  </section>

  <section class="section section--grey" id="doporuceni">
    <div class="container narrow">
      <h2>{C.refTitle}</h2>
      <p class="answer">{C.refAnswer}</p>
      <p>{C.refLead}{' '}<a href={t('maps')}>{C.refLinkText}</a>.</p>
    </div>
  </section>

  <section class="section" id="reklama">
    <div class="container narrow">
      <h2>{C.adsTitle}</h2>
      <p class="answer">{C.adsAnswer}</p>
    </div>
  </section>

  <section class="section section--grey" id="seo">
    <div class="container narrow">
      <h2>{C.seoTitle}</h2>
      <p class="answer">{C.seoAnswer}</p>
      <p>{C.seoLead}{' '}<a href={t('nicheRealty')}>{C.seoLinkText}</a>. {C.seoAuditLead}{' '}<a href={t('audit')}>{C.seoAuditLinkText}</a>.</p>
      <p>{C.seoSmallLead}{' '}<a href={t('postRealtySmall')}>{C.seoSmallLinkText}</a>.</p>
    </div>
  </section>

  <section class="section" id="velikost">
    <div class="container narrow">
      <h2>{C.sizeTitle}</h2>
      <p class="answer">{C.sizeAnswer}</p>
      <p>{C.sizeLead}</p>
      <ul class="checks">{C.size.map((x) => <li>{x}</li>)}</ul>
    </div>
  </section>

  <section class="section section--grey" id="zacit">
    <div class="container narrow">
      <h2>{C.startTitle}</h2>
      <p class="answer">{C.startAnswer}</p>
      <ol class="steps">{C.startSteps.map((x) => <li><span>{x}</span></li>)}</ol>
      {QUOTE_CONFIRMED && (
        <figure class="quote-fig">
          <blockquote cite={cite}><p>{C.quote}</p></blockquote>
          <QuoteCaption lang={lang} />
        </figure>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p>{f.links && <p class="small">{f.links.map((l, i) => <>{i > 0 && ' · '}<a class="link-arrow" href={t(l.page)}>{l.text}</a></>)}</p>}</div>)}</div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.endTitle}</h2>
      <p>{C.endText}</p>
      <PostCta lang={lang} postKey="postRealty" />
      <p>{C.endConsulting}{' '}<a href={t('consulting')}>{C.endConsultingLink}</a>.</p>
      <p>{C.landingLead}{' '}<a href={t('nicheRealty')}>{C.seoLinkText}</a>.</p>
      <p class="muted">{C.authorNote} <a href={t('about')}>{C.authorLinkText}</a>.</p>
    </div>
  </section>

</Base>
