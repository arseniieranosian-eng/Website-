---
// /sluzby/konzultace/ in Czech — built from the brief of 19.10.2026. en/ru use the generic Service template.
import Base from '../layouts/Base.astro';
import AuthorMedia from '../components/AuthorMedia.astro';
import LeadForm from '../components/LeadForm.astro';
import ReviewCards from '../components/ReviewCards.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified, csDate } from '../lib/lastmod';
import { consultingSchemas } from '../lib/schema-consulting';
import { CONSULTING as C, OFFERS } from '../data/consulting';
import { reviewsWithFallback } from '../data/reviews';
import { serviceByKey } from '../data/services';

const lang = 'cs' as const;
const site = Astro.site!;
const MOD = lastModified(['src/views/ConsultingCs.astro', 'src/data/consulting.ts', 'src/data/reviews.ts'], '2026-10-19');
const reviews = reviewsWithFallback('consulting', 3, 3);
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const name = (k: keyof typeof META) => META[k][lang].name;
const others = [
  { key: 'audit', text: C.audit },
  { key: 'start', text: '' },
  { key: 'fullSeo', text: '' },
  { key: 'maps', text: '' },
  { key: 'geo', text: C.geo },
] as const;
---
<Base {...pageProps('consulting', lang)} schema={consultingSchemas(site, { modified: MOD, reviews })}>
  <!-- 3.1 HERO -->
  <section class="page-hero">
    <div class="container hero-split">
      <div>
        <h1>{C.h1}</h1>
        <p class="updated">Aktualizováno: <time datetime={MOD}>{csDate(MOD)}</time></p>
        <p class="lead">{C.lead}</p>
        <div class="btn-row">
          <a class="btn btn--primary btn--lg" href="#form">Domluvit konzultaci</a>
          <a class="btn btn--secondary btn--lg" href={t('audit')}>Audit zdarma</a>
        </div>
      </div>
      <figure class="hero-video">
        <AuthorMedia alt={C.video.alt} variant="video" />
        <figcaption class="muted small">{C.video.caption}</figcaption>
      </figure>
    </div>
  </section>

  <!-- 3.2 KOLIK STOJÍ -->
  <section class="section section--tight">
    <div class="container">
      <h2>{C.priceTitle}</h2>
      <p class="answer">{C.priceAnswer}</p>
      <div class="grid grid-2 offers">
        {OFFERS.map((o) => (
          <article class="card offer">
            <h3>{o.name}</h3>
            <p class="price"><strong>{String(o.price).replace(/\B(?=(\d{3})+(?!\d))/g, ' ')} Kč</strong> · {o.duration}</p>
            <p>{o.cardText}</p>
            <a class="btn btn--secondary" href="#form" data-prefill={o.prefill}>{o.cta}</a>
          </article>
        ))}
      </div>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.table.head.map((h, i) => <th scope="col">{i === 0 ? <span class="sr-only">Parametr</span> : h}</th>)}</tr></thead>
          <tbody>
            {C.table.rows.map(([label, a, b]) => <tr><th scope="row">{label}</th><td>{a}</td><td>{b}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 3.3 PRO KOHO -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.forWhomTitle}</h2>
      <ul class="checks">{C.forWhom.map((x) => <li>{x}</li>)}</ul>
      <p class="muted">{C.forWhomNote}</p>
    </div>
  </section>

  <!-- 3.4 JAK PROBÍHÁ -->
  <section class="section">
    <div class="container">
      <h2>{C.stepsTitle}</h2>
      <ol class="steps steps--row">{C.steps.map((x) => <li>{x}</li>)}</ol>
    </div>
  </section>

  <!-- 3.5 ONLINE / OSOBNĚ -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.channelsTitle}</h2>
      <p>{C.channels}</p>
    </div>
  </section>

  <!-- 3.6 KONZULTACE, NEBO DLOUHODOBÁ SPOLUPRÁCE -->
  <section class="section">
    <div class="container narrow">
      <h2>{C.longTermTitle}</h2>
      <p>{C.longTermIntro}</p>
      <ul class="link-list">
        <li><a href={t('start')}>{name('start')}</a></li>
        <li><a href={t('fullSeo')}>{name('fullSeo')}</a></li>
      </ul>
      <p>{C.longTermGeo.before}<a href={t('geo')}>{C.longTermGeo.link}</a>{C.longTermGeo.after}</p>
    </div>
  </section>

  <!-- 3.7 DŮKAZ -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.caseTitle}</h2>
      <p>{C.caseText}</p>
      <a class="link-arrow" href={t('caseKb')}>{C.caseLink}</a>
    </div>
  </section>

  <!-- 3.8 RECENZE (sdílený zdroj dat) -->
  <section class="section">
    <div class="container">
      <div class="section-head"><h2>{C.reviewsTitle}</h2><a class="link-arrow" href={t('reviews')}>{C.reviewsLink}</a></div>
      <ReviewCards reviews={reviews} lang={lang} compact />
    </div>
  </section>

  <!-- 3.9 FAQ: odpovědi viditelné, ne ve skrytých záložkách -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">
        {C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}
      </div>
      <p><a class="link-arrow" href={t('faq')}>{C.faqAll}</a></p>
    </div>
  </section>

  <!-- 3.10 FORMULÁŘ -->
  <section class="section" id="form">
    <div class="container narrow">
      <h2>{C.formTitle}</h2>
      <div class="card"><LeadForm lang={lang} id="service-consulting" service="consulting" /></div>
    </div>
  </section>

  <!-- 3.11 DALŠÍ SLUŽBY -->
  <section class="section section--grey">
    <div class="container">
      <div class="section-head"><h2>{C.otherTitle}</h2><a class="link-arrow" href={t('services')}>{C.otherAll}</a></div>
      <div class="grid grid-3">
        {others.map((o) => (
          <a class="card card--link" href={t(o.key)}>
            <h3>{name(o.key)}</h3>
            <p>{o.text || serviceByKey(o.key as 'start' | 'fullSeo' | 'maps').short.cs}</p>
            <span class="link-arrow">Více</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  // The offer buttons scroll to the form (#form) and pre-fill the message with the chosen offer.
  document.querySelectorAll<HTMLAnchorElement>('a[data-prefill]').forEach((a) =>
    a.addEventListener('click', () => {
      const box = document.querySelector<HTMLTextAreaElement>('#lf-service-consulting-message');
      if (box && (box.value.trim() === '' || box.value.startsWith('Mám zájem o:'))) box.value = a.dataset.prefill ?? '';
    }),
  );
</script>
