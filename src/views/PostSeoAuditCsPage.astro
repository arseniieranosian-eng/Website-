---
// Blog article "Co je SEO audit a co by měl obsahovat" (cs), brief of 21.10.2026. Content: data/post-seo-audit-cs.ts.
// One main CTA (free audit). "SEO audit zdarma" stays with /audit-zdarma/. Links to funnel articles 5 and 10 are added when they exist.
import Base from '../layouts/Base.astro';
import IndexIllustration from '../components/IndexIllustration.astro';
import QuoteCaption from '../components/QuoteCaption.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { postSeoAuditSchemas } from '../lib/schema-post-seo-audit';
import { POST_SEO_AUDIT_CS as C } from '../data/post-seo-audit-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = lastModified(['src/views/PostSeoAuditCsPage.astro', 'src/data/post-seo-audit-cs.ts', 'src/components/IndexIllustration.astro'], '2026-10-21');
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-co-je-seo-audit.png';
const cite = new URL(t('postSeoAudit'), site).href;
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
---
<Base {...pageProps('postSeoAudit', lang)} ogType="article" ogImage={OG} schema={postSeoAuditSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postSeoAudit.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
      <p class="lead">{C.lead}</p>
      <p>{C.forWhom}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.whatTitle}</h2>
      <p class="answer">{C.whatAnswer}</p>
      <p>{C.whatText}</p>
      <p>{C.whatLinkLead} <a href={t('geo')}>{C.whatLinkText}</a>.</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.partsTitle}</h2>
      <p class="answer">{C.partsAnswer}</p>
      <ul class="checks">{C.parts.map((x) => <li>{x}</li>)}</ul>
      <figure class="post-figure"><IndexIllustration kind="parts" aria={C.figure.aria} /><figcaption>{C.figure.caption}</figcaption></figure>
      <p>{C.partsLinkLead} <a href={t('postIndexing')}>{C.partsLinkText}</a>.</p>
      <p>{C.partsDupLead} <a href={t('postDuplicates')}>{C.partsDupLinkText}</a>.</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.typesTitle}</h2>
      <p class="answer">{C.typesAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.types.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>
            {C.types.rows.map((r) => (
              <tr>
                <th scope="row">{r.type}</th>
                <td>{r.checks}</td>
                <td>{r.who}</td>
                <td>{r.get}{r.get && <br />}{r.links.map((l, i) => <>{i > 0 && ' nebo '}<a href={t(l.page)}>{l.text}</a></>)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.freeTitle}</h2>
      <p class="answer">{C.freeAnswer}</p>
      <ul class="checks">{C.freeList.map((x) => <li>{x}</li>)}</ul>
      <p>{C.freeText}</p>
      <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('audit')}>{C.cta}</a></div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.notTitle}</h2>
      <p class="answer">{C.notAnswer}</p>
      <ul class="checks">{C.notList.map((x) => <li>{x}</li>)}</ul>
      <p>{C.notText}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.resultTitle}</h2>
      <p class="answer">{C.resultAnswer}</p>
      <p>{C.resultText}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.moreTitle}</h2>
      <p class="answer">{C.moreAnswer}</p>
      <ul class="checks">
        {C.more.map((m) => <li><span>{m.text} <a href={t(m.link.page)}>{m.link.text}</a>{'link2' in m && m.link2 && <>, <a href={t(m.link2.page)}>{m.link2.text}</a></>}</span></li>)}
      </ul>
      <p>{C.moreChooseLead} <a href={t('postChoose')}>{C.moreChooseLinkText}</a>.</p>
      <p>{C.moreRedesignLead} <a href={t('postRedesign')}>{C.moreRedesignLinkText}</a>.</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.goodTitle}</h2>
      <p class="answer">{C.goodAnswer}</p>
      <div class="grid grid-2">
        <div class="card"><h3>{C.goodHead}</h3><ul class="checks">{C.good.map((x) => <li>{x}</li>)}</ul></div>
        <div class="card"><h3>{C.badHead}</h3><ul class="checks">{C.bad.map((x) => <li>{x}</li>)}</ul></div>
      </div>
      <div style="margin-top: 28px"></div>
      <figure class="quote-fig">
        <blockquote cite={cite}><p>{C.quote}</p></blockquote>
        <QuoteCaption lang={lang} />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}</div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.endTitle}</h2>
      <p>{C.endText}</p>
      <div class="btn-row"><a class="btn btn--primary btn--lg" href={t('audit')}>{C.cta}</a></div>
      <p>{C.nextLead} <a class="link-arrow" href={t('postNotShown')}>{C.nextLinkText}</a></p>
      <p>{C.chooseLead} <a class="link-arrow" href={t('postChoose')}>{C.chooseLinkText}</a></p>
      <p class="muted">{C.authorNote} <a href={t('about')}>{C.authorLinkText}</a>.</p>
    </div>
  </section>
</Base>
