---
// Blog article U6 "Jak dlouho trvá SEO pro účetní kancelář?" (cs), brief of 26.10.2026. Content: data/post-accounting-time-cs.ts.
// Informational: no prices, no CTA, no audit link, the closing block is one link to the landing page.
import Base from '../layouts/Base.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { postAccountingTimeSchemas } from '../lib/schema-post-accounting-time';
import { POST_ACCOUNTING_TIME_CS as C, POST_ACCOUNTING_TIME_PUBLISHED } from '../data/post-accounting-time-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = [lastModified(['src/views/PostAccountingTimeCsPage.astro', 'src/data/post-accounting-time-cs.ts'], '2026-10-28'), POST_ACCOUNTING_TIME_PUBLISHED].sort().pop()!;
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const OG = '/images/blog/og-jak-dlouho-trva-seo-pro-ucetni-kancelar.png';
const words = JSON.stringify(C).replace(/"[a-zA-Z0-9]+":/g, ' ').split(/\s+/).length;
const minutes = Math.max(3, Math.ceil(words / 200));
---
<Base {...pageProps('postAccountingTime', lang)} ogType="article" ogImage={OG} schema={postAccountingTimeSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <img class="post-cover" src={C.cover.src} width={C.cover.width} height={C.cover.height} alt={C.cover.alt} decoding="async" fetchpriority="high" />
      <h1>{META.postAccountingTime.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel} <time datetime={MOD}>{modText}</time> · {C.readLabel}: {minutes} {C.readUnit}</p>
      <p class="lead">{C.leadBefore}{' '}<a href={t('postAccountingSmall')}>{C.leadLinkText}</a></p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.whyTitle}</h2>
      <p class="answer">{C.whyAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.factorsTitle}</h2>
      <p class="answer">{C.factorsAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.factorsTable.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.factorsTable.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p class="muted small">{C.tableNote}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.soonTitle}</h2>
      <p class="answer">{C.soonAnswer}</p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr>{C.soonTable.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{C.soonTable.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.stagesTitle}</h2>
      <p class="answer">{C.stagesAnswer}</p>
      {C.stages.map((x) => <><h3>{x.h}</h3><p>{x.text}</p></>)}
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.measureTitle}</h2>
      <p class="answer">{C.measureAnswerBefore}{' '}<a href={t('postAccountingNoLeads')}>{C.measureLinkText}</a>.</p>
      <p>{C.measureLead}</p>
      <ul class="checks">{C.measure.map((x) => <li>{x}</li>)}</ul>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.lateTitle}</h2>
      <p class="answer">{C.lateAnswer}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.changeTitle}</h2>
      <p class="answer">{C.changeAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.waitTitle}</h2>
      <p class="answer">{C.waitAnswer}</p>
      <p>{C.waitLead}</p>
      <ul class="checks">{C.wait.map((x) => <li>{x}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3>{f.linkAfter ? <p>{f.a.split(f.linkAfter)[0]}<a href={t(f.linkKey)}>{f.linkAfter}</a>{f.a.split(f.linkAfter)[1]}</p> : <p>{f.a}</p>}</div>)}</div>
      <p class="muted">{C.endText}{' '}<a href={t('nicheAccounting')}>{C.endLinkText}</a>. {C.endText2}</p>
    </div>
  </section>
</Base>
