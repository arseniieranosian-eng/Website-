---
// Niche landing page "SEO pro realitní kanceláře v Brně" (cs), brief of 31.10.2026. Built only when NICHE_READY.nicheRealtyBrno is true (routes.ts); needs B2 (data/niche-realty-brno-cs.ts).
// Own structure from the brief. No quote, no video, no Review / Offer markup.
import Base from '../layouts/Base.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { nicheRealtyBrnoSchemas } from '../lib/schema-niche-realty-brno';
import { NICHE_REALTY_BRNO_CS as C, NICHE_REALTY_BRNO_R3 as R3 } from '../data/niche-realty-brno-cs';

const lang = C.lang;
const site = Astro.site!;
const MOD = lastModified(['src/views/NicheRealtyBrnoCsPage.astro', 'src/data/niche-realty-brno-cs.ts'], '2026-10-31');
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
---
<Base {...pageProps('nicheRealtyBrno', lang)} schema={nicheRealtyBrnoSchemas(site, C, { modified: MOD })}>
  <section class="page-hero">
    <div class="container narrow">
      <h1>{META.nicheRealtyBrno.cs.h1}</h1>
      <p class="updated">{C.authorLabel}: <a href={t('about')}>{C.authorName}</a> · {C.updatedLabel}: <time datetime={MOD}>{modText}</time></p>
      <p>{C.proof} <a href={t('caseHalf')}>{C.proofLink}</a>.</p>
      <div class="summary-box"><p class="lead">{C.lead}</p></div>
      <div class="btn-row">
        <a class="btn btn--primary btn--lg" href={t('audit')}>{C.heroAudit}</a>
        <a class="btn btn--secondary btn--lg" href={t('consulting')}>{C.heroConsulting}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.seenTitle}</h2>
      <p class="answer">{C.seenAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.doTitle}</h2>
      <p class="answer">{C.doAnswer}</p>
      <p>{C.doMaps}{' '}<a href={t('maps')}>{C.doMapsLink}</a>.</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.districtsTitle}</h2>
      <p class="answer">{C.districtsAnswer}</p>
      {R3 && (
        <>
          <p>{R3.lead} <a href={R3.source.url} rel="noopener">{R3.source.label}</a>.</p>
          <ul class="checks districts-list">{R3.names.map((x) => <li>{x}</li>)}</ul>
        </>
      )}
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.expTitle}</h2>
      <p class="answer">{C.expAnswer}</p>
      <p><a class="link-arrow" href={t('caseRazbor')}>{C.expLink}</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.coopTitle}</h2>
      <p class="answer">{C.coopAnswer}</p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.auditTitle}</h2>
      <p class="answer">{C.auditAnswer}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.fitTitle}</h2>
      <p class="answer">{C.fitAnswer}</p>
      <p>{C.reviewsLead}{' '}<a href={t('reviews')}>{C.reviewsLink}</a></p>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">{C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{C.articlesTitle}</h2>
      <RelatedPosts lang={lang} keys={['postRealty', 'postRealtyNoLeads', 'postRealtySmall', 'postRealtyListings', 'postRealtyPortals', 'postRealtyDistricts', 'postRealtyLocal']} more={C.articlesMore} />
    </div>
  </section>

  <section class="section section--dark cta-band">
    <div class="container cta-inner">
      <div>
        <h2>{C.endTitle}</h2>
        <p>{C.endText}</p>
        <p><a href={t('consulting')}>{C.endConsulting}</a></p>
      </div>
      <div class="btn-row">
        <a class="btn btn--primary btn--lg" href={t('audit')}>{C.endCta}</a>
      </div>
    </div>
  </section>
</Base>
