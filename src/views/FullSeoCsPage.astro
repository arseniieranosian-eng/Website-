---
// /full-seo/ (cs) built from the brief of 20.10.2026. Content: data/fullseo-cs.ts, prices: data/fullseo-shared.ts.
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import GeoNote from '../components/GeoNote.astro';
import ReviewCards from '../components/ReviewCards.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { META } from '../i18n/meta';
import { path } from '../i18n/routes';
import { pageProps } from '../lib/page';
import { lastModified } from '../lib/lastmod';
import { fullSeoCsSchemas } from '../lib/schema-fullseo-cs';
import { FULLSEO_CS as C } from '../data/fullseo-cs';
import { reviewsWithFallback } from '../data/reviews';
import { serviceByKey } from '../data/services';

const lang = C.lang;
const site = Astro.site!;

// Visible date and JSON-LD dateModified both come from git (see lib/lastmod.ts).
const MOD = lastModified(['src/views/FullSeoCsPage.astro', 'src/data/fullseo-cs.ts', 'src/data/blog-posts.ts', 'src/components/RelatedPosts.astro', 'src/data/fullseo-shared.ts', 'src/data/start-cs.ts', 'src/data/start-shared.ts', 'src/data/maps-shared.ts', 'src/data/reviews.ts'], '2026-10-20');
const [y, mo, d] = MOD.split('-').map(Number);
const modText = `${d}. ${mo}. ${y}`;

// 1-3 reviews tagged "start"; if there are none, the freshest ones for other services.
const reviews = reviewsWithFallback('fullSeo', 3, 1);
const t = (k: Parameters<typeof path>[0]) => path(k, lang);
const name = (k: keyof typeof META) => META[k][lang].name;
const others = [
  { key: 'audit', text: C.audit },
  { key: 'consulting', text: '' },
  { key: 'start', text: '' },
  { key: 'maps', text: '' },
] as const;
import WhyTrustCs from '../components/WhyTrustCs.astro';
import QuoteFigure from '../components/QuoteFigure.astro';
---
<Base {...pageProps('fullSeo', lang)} schema={fullSeoCsSchemas(site, C, { modified: MOD, reviews })}>
  <!-- HERO -->
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">{C.label}</p>
      <h1>{C.h1}</h1>
      <p class="updated">{C.updatedLabel}: <time datetime={MOD}>{modText}</time></p>
      <p class="lead">{C.lead}</p>
      <p class="price-badge">{C.badge}</p>
      <div class="btn-row">
        <a class="btn btn--primary btn--lg" href="#form">{C.heroPrimary}</a>
        <a class="btn btn--secondary btn--lg" href={t('audit')}>{C.heroAudit}</a>
      </div>
    </div>
  </section>

  <!-- PRICE -->
  <section class="section section--tight">
    <div class="container narrow">
      <h2>{C.priceTitle}</h2>
      <p class="answer">{C.priceAnswer}</p>
    </div>
  </section>

  <!-- WHO IT IS FOR -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.forWhomTitle}</h2>
      <ul class="checks">{C.forWhom.map((x) => <li>{x}</li>)}</ul>
    </div>
  </section>

  <!-- WHAT IS INCLUDED: three groups -->
  <section class="section">
    <div class="container narrow">
      <h2>{C.includesTitle}</h2>
      {C.groups.map((g) => (
        <div class="include-group">
          <h3>{g.title}</h3>
          <ul class="checks">
            {g.items.map((i) => {
              const l = i.link;
              if (!l) return <li>{i.text}</li>;
              const [before, after] = i.text.split(l.part);
              return <li><span>{before}<a href={t(l.page)}>{l.part}</a>{after}</span></li>;
            })}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- MAPS IN THE PACKAGE -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.mapsTitle}</h2>
      <p>{C.maps.first}<a href={t('maps')}>{C.maps.link}</a>{C.maps.after}</p>
    </div>
  </section>

  <!-- HOW THE WORK GOES -->
  <section class="section">
    <div class="container">
      <h2>{C.stagesTitle}</h2>
      <ol class="steps steps--row">{C.stages.map((st) => <li><span>{st}</span></li>)}</ol>
    </div>
  </section>

  <QuoteFigure text={C.quote} cite={new URL(t('fullSeo'), site).href} lang={lang} />

  <!-- FIRST RESULTS -->
  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.resultsTitle}</h2>
      <p class="answer">{C.resultsAnswer}</p>
    </div>
  </section>

  <!-- NO GUARANTEE -->
  <section class="section">
    <div class="container narrow">
      <h2>{C.guaranteeTitle}</h2>
      <p class="answer">{C.guaranteeAnswer}</p>
    </div>
  </section>

  <!-- START OR FULL SEO -->
  <section class="section section--grey">
    <div class="container">
      <h2>{C.compareTitle}</h2>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr><th scope="col"><span class="sr-only">{C.table.corner}</span></th>{C.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>
            {C.table.rows.map(([label, a, b]) => <tr><th scope="row">{label}</th><td>{a}</td><td>{b}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p><a class="link-arrow" href={t('start')}>{C.startLink}</a></p>
      <p>{C.consultingNote.before}<a href={t('consulting')}>{C.consultingNote.link}</a>{C.consultingNote.after}</p>
      <p>{C.mapsNote.before}<a href={t('maps')}>{C.mapsNote.link}</a>{C.mapsNote.after}</p>
    </div>
  </section>

  <!-- CASE -->
  <section class="section">
    <div class="container narrow">
      <h2>{C.caseTitle}</h2>
      <p>{C.caseText}</p>
      <a class="link-arrow" href={t('caseKb')}>{C.caseLink}</a>
      <p>{C.caseText2}</p>
      <a class="link-arrow" href={t('caseTypo')}>{C.caseLink2}</a>
      <p>{C.caseText4}</p>
      <a class="link-arrow" href={t('caseSeason')}>{C.caseLink4}</a>
      <p>{C.caseText5}</p>
      <a class="link-arrow" href={t('caseHalf')}>{C.caseLink5}</a>
    </div>
  </section>

  <!-- REVIEWS (shared data source) -->
  <section class="section section--grey">
    <div class="container">
      <div class="section-head"><h2>{C.reviewsTitle}</h2><a class="link-arrow" href={t('reviews')}>{C.reviewsLink}</a></div>
      <ReviewCards reviews={reviews} lang={lang} compact />
    </div>
  </section>

  <!-- FAQ: answers are visible, not hidden in tabs -->
  <!-- RELATED ARTICLES -->
  <section class="section">
    <div class="container">
      <h2>{C.articlesTitle}</h2>
      <p>{C.articlesLead}</p>
      <RelatedPosts lang={lang} keys={[...C.articles]} more={C.articlesMore} />
    </div>
  </section>

  <section class="section section--grey">
    <div class="container narrow">
      <h2>{C.faqTitle}</h2>
      <div class="faq-open">
        {C.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}
      </div>
      <p><a class="link-arrow" href={t('faq')}>{C.faqAll}</a></p>
    </div>
  </section>

  <WhyTrustCs />

  <!-- FORM -->
  <section class="section section--grey" id="form">
    <div class="container narrow">
      <h2>{C.formTitle}</h2>
      <div class="card"><LeadForm lang={lang} id="service-fullseo" service="fullSeo" /></div>
    </div>
  </section>

  <!-- OTHER SERVICES -->
  <section class="section">
    <div class="container">
      <div class="section-head"><h2>{C.otherTitle}</h2></div>
      <div class="grid grid-3">
        {others.map((o) => (
          <a class="card card--link" href={t(o.key)}>
            <h3>{name(o.key)}</h3>
            <p>{o.text || serviceByKey(o.key as 'consulting' | 'start' | 'maps').short[lang]}</p>
            <span class="link-arrow">{C.more}</span>
          </a>
        ))}
      </div>
      <GeoNote lang={lang} />
    </div>
  </section>
</Base>
