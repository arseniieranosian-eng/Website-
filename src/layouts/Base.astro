---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageArt from '../components/PageArt.astro';
import { addToc, addServiceToc, isArticlePath, hasServiceToc, addBlogToc } from '../lib/toc';
import { experimental_AstroContainer as AstroContainer } from 'astro/container';
import { artFor, injectArt } from '../lib/page-art';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Analytics from '../components/Analytics.astro';
import LeadModal from '../components/LeadModal.astro';
import { DEFAULT_LANG, HTML_LANG, LANGS, OG_LOCALE, ROUTES, type Lang, type PageKey } from '../i18n/routes';
import { t } from '../i18n/ui';
import { SITE } from '../data/site';
import { baseGraph, breadcrumbSchema } from '../lib/schema';
import type { Crumb } from '../lib/page';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  alternates: Partial<Record<Lang, string>>;
  breadcrumbs: Crumb[] | null;
  noindex?: boolean;
  pageKey?: PageKey;
  schema?: (object | null)[];
  ogType?: 'website' | 'article' | 'profile';
  ogImage?: string; // absolute-path image for og:image (default: the site card)
  // Where the language switcher points when this page has no translation.
  langFallback?: Record<Lang, string>;
}

const { lang, title, description, path, alternates, breadcrumbs, noindex = false, pageKey, schema = [], ogType = 'website', ogImage = '/images/og-card.png', langFallback = ROUTES.home } = Astro.props;
const art = artFor(pageKey, lang);
// Decorative illustrations (lib/page-art.ts) are inserted under the headings (H2) of the page body, not in a separate row.
let body = await Astro.slots.render('default');
// Blog articles: ids on the H2 headings and the generated table of contents (src/lib/toc.ts, src/data/toc-ids.ts).
if (isArticlePath(path)) body = addToc(body, lang, pageKey);
else if (pageKey === 'blog') body = addBlogToc(body, lang);
else if (pageKey && hasServiceToc(pageKey)) body = addServiceToc(body, lang);
// K6 (brief of 03.11.2026, P2.2): the publication date is shown next to the update date, from the datePublished of the page's JSON-LD ("Zveřejněno · Aktualizováno").
const pubIso = (schema as any[]).filter(Boolean).map((n) => n.datePublished).find((d) => typeof d === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(d));
if (pubIso) {
  const [py, pm, pd] = pubIso.split('-').map(Number);
  const pubText = lang === 'cs' ? `${pd}. ${pm}. ${py}` : `${String(pd).padStart(2, '0')}.${String(pm).padStart(2, '0')}.${py}`;
  const pubLabel = { cs: 'Zveřejněno', en: 'Published', ru: 'Опубликовано', uk: 'Опубліковано' }[lang];
  body = body.replace(/(Aktualizováno|Обновлено|Updated|Оновлено): <time/, `${pubLabel}: <time datetime="${pubIso}">${pubText}</time> · $1: <time`);
}
if (art.length) {
  const container = await AstroContainer.create();
  const drawn = await Promise.all(art.map((k) => container.renderToString(PageArt, { props: { kind: k, lang } })));
  body = injectArt(body, drawn);
}
const site = Astro.site!;
const abs = (p: string) => new URL(p, site).href;
const canonical = abs(path);
const hreflangs = LANGS.filter((l) => alternates[l]).map((l) => ({ l, href: abs(alternates[l]!) }));
const xDefault = alternates[DEFAULT_LANG] ? abs(alternates[DEFAULT_LANG]!) : null;
const graph = [...baseGraph(site), ...(breadcrumbs ? [breadcrumbSchema(site, breadcrumbs, path)] : []), ...schema.filter(Boolean)];
// VideoObject markup is not used either (retro-audit P1 A, brief of 09.11.2026; the videos stay on the pages). Quotation and HowTo markup is not used on the site (brief of 03.11.2026, P1.1): the nodes and every reference to them are dropped here, in one place, whatever a page's schema builder emits.
const BANNED_TYPES = new Set(['Quotation', 'HowTo', 'VideoObject']);
const dead = new Set((graph as any[]).filter((n) => BANNED_TYPES.has(n['@type'])).map((n) => n['@id']).filter(Boolean));
const scrub = (x: any): any => {
  if (Array.isArray(x)) return x.filter((v) => !(v && typeof v === 'object' && Object.keys(v).length === 1 && dead.has(v['@id']))).map(scrub);
  if (x && typeof x === 'object') {
    const o: any = {};
    for (const [k, v] of Object.entries(x)) {
      if (v && typeof v === 'object' && !Array.isArray(v) && Object.keys(v as object).length === 1 && dead.has((v as any)['@id'])) continue;
      const sv = scrub(v);
      if (Array.isArray(sv) && sv.length === 0 && Array.isArray(v) && v.length > 0) continue;
      o[k] = sv;
    }
    return o;
  }
  return x;
};
const cleanGraph0 = scrub((graph as any[]).filter((n) => !BANNED_TYPES.has(n['@type'])));
// FAQPage is derived from the visible FAQ of the page (retro-audit P1 B, brief of 09.11.2026): the truth is the visible text. For every question of a FAQPage node the visible question and the visible answer
// are taken from the rendered body (a question with an answer below it in <h3>/<p>, <summary>/<p> or an answer-first <h2>/<p class="answer">); a question that is not visible on the page is left out;
// a page without any visible question has no FAQPage. This keeps the markup identical to the page whatever a page's schema builder passes.
// Euro estimates in brackets, e.g. "(≈ €600)" / "(approx. €80)", are visible on the service pages but must stay out of the JSON-LD (rule of the author, checked by check-consulting / check-fullseo): they are removed from the derived text.
const plain = (h: string, noEuro = false) => (noEuro ? h.replace(/\s*\((?:≈|approx\.?)\s*€[^)]*\)/g, '') : h).replace(/<[^>]+>/g, '').replace(/&nbsp;/g, '\u00a0').replace(/&quot;/g, '"').replace(/&#39;|&apos;/g, "'").replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&').replace(/[ \t\r\n]+/g, ' ').trim();
const qkey = (q: string) => q.replace(/\s+/g, ' ').trim();
const visibleQA = new Map<string, { q: string; a: string }>();
for (const rx of [/<h3[^>]*>((?:(?!<h3)[\s\S])*?)<\/h3>\s*<p>([\s\S]*?)<\/p>/g, /<summary[^>]*>((?:(?!<summary)[\s\S])*?)<\/summary>\s*(?:<div[^>]*>)?\s*<p>([\s\S]*?)<\/p>/g, /<h2[^>]*>((?:(?!<h2)[\s\S])*?)<\/h2>\s*(?:<[^>]*>\s*)*<p class="answer">([\s\S]*?)<\/p>/g]) {
  for (const m of body.matchAll(rx)) { const q = plain(m[1]); const a = plain(m[2], true); if (q && a && !visibleQA.has(qkey(q))) visibleQA.set(qkey(q), { q, a }); }
}
const cleanGraph = (cleanGraph0 as any[]).map((node: any) => {
  if (!node || node['@type'] !== 'FAQPage' || !Array.isArray(node.mainEntity)) return node;
  const me = node.mainEntity.map((e: any) => {
    const v = visibleQA.get(qkey(String(e?.name ?? '')));
    return v ? { ...e, name: v.q, acceptedAnswer: { ...(e.acceptedAnswer ?? { '@type': 'Answer' }), text: v.a } } : null;
  }).filter(Boolean);
  return me.length ? { ...node, mainEntity: me } : null;
}).filter(Boolean);
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': cleanGraph }).replace(/</g, '\\u003c');
const gsc = import.meta.env.PUBLIC_GSC_VERIFICATION;
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <!-- Safety net against mixed content: the browser upgrades any http:// sub-resource to https:// (the pages themselves are served over HTTPS only). -->
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {pageKey === 'home' && lang === 'cs' && <meta name="seznam-wmt" content="smOudwpeaYUPsXVuqqvEDh2HY4hbh3Pb" />}
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    {!noindex && hreflangs.length > 1 && hreflangs.map(({ l, href }) => <link rel="alternate" hreflang={l} href={href} />)}
    {!noindex && hreflangs.length > 1 && xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:image" content={abs(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.brand} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0B0B0F" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {gsc && <meta name="google-site-verification" content={gsc} />}
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip" href="#main">{t(lang).skip}</a>
    <Header lang={lang} pageKey={pageKey} alternates={alternates} langFallback={langFallback} />
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} lang={lang} />}
    <main id="main">
      <Fragment set:html={body} />
    </main>
    <Footer lang={lang} />
    {pageKey !== 'thanks' && <LeadModal lang={lang} />}
    <Analytics lang={lang} />
  </body>
</html>
