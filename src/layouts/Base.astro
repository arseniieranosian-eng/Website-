---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageArt from '../components/PageArt.astro';
import { experimental_AstroContainer as AstroContainer } from 'astro/container';
import { artFor, injectArt } from '../lib/page-art';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Analytics from '../components/Analytics.astro';
import LeadModal from '../components/LeadModal.astro';
import { DEFAULT_LANG, HTML_LANG, LANGS, OG_LOCALE, ROUTES, type Lang, type PageKey } from '../i18n/routes';
import { t } from '../i18n/ui';
import { SITE } from '../data/site';
import { baseGraph, breadcrumbSchema } from '../lib/schema';
import type { Crumb } from '../lib/page';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  alternates: Partial<Record<Lang, string>>;
  breadcrumbs: Crumb[] | null;
  noindex?: boolean;
  pageKey?: PageKey;
  schema?: (object | null)[];
  ogType?: 'website' | 'article' | 'profile';
  ogImage?: string; // absolute-path image for og:image (default: the site card)
  // Where the language switcher points when this page has no translation.
  langFallback?: Record<Lang, string>;
}

const { lang, title, description, path, alternates, breadcrumbs, noindex = false, pageKey, schema = [], ogType = 'website', ogImage = '/images/og-card.png', langFallback = ROUTES.home } = Astro.props;
const art = artFor(pageKey, lang);
// Decorative illustrations (lib/page-art.ts) are inserted under the headings (H2) of the page body, not in a separate row.
let body = await Astro.slots.render('default');
// K6 (brief of 03.11.2026, P2.2): the publication date is shown next to the update date, from the datePublished of the page's JSON-LD ("Zveřejněno · Aktualizováno").
const pubIso = (schema as any[]).filter(Boolean).map((n) => n.datePublished).find((d) => typeof d === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(d));
if (pubIso) {
  const [py, pm, pd] = pubIso.split('-').map(Number);
  const pubText = lang === 'cs' ? `${pd}. ${pm}. ${py}` : `${String(pd).padStart(2, '0')}.${String(pm).padStart(2, '0')}.${py}`;
  const pubLabel = { cs: 'Zveřejněno', en: 'Published', ru: 'Опубликовано', uk: 'Опубліковано' }[lang];
  body = body.replace(/(Aktualizováno|Обновлено|Updated|Оновлено): <time/, `${pubLabel}: <time datetime="${pubIso}">${pubText}</time> · $1: <time`);
}
if (art.length) {
  const container = await AstroContainer.create();
  const drawn = await Promise.all(art.map((k) => container.renderToString(PageArt, { props: { kind: k } })));
  body = injectArt(body, drawn);
}
const site = Astro.site!;
const abs = (p: string) => new URL(p, site).href;
const canonical = abs(path);
const hreflangs = LANGS.filter((l) => alternates[l]).map((l) => ({ l, href: abs(alternates[l]!) }));
const xDefault = alternates[DEFAULT_LANG] ? abs(alternates[DEFAULT_LANG]!) : null;
const graph = [...baseGraph(site), ...(breadcrumbs ? [breadcrumbSchema(site, breadcrumbs, path)] : []), ...schema.filter(Boolean)];
// Quotation and HowTo markup is not used on the site (brief of 03.11.2026, P1.1): the nodes and every reference to them are dropped here, in one place, whatever a page's schema builder emits.
const BANNED_TYPES = new Set(['Quotation', 'HowTo']);
const dead = new Set((graph as any[]).filter((n) => BANNED_TYPES.has(n['@type'])).map((n) => n['@id']).filter(Boolean));
const scrub = (x: any): any => {
  if (Array.isArray(x)) return x.filter((v) => !(v && typeof v === 'object' && Object.keys(v).length === 1 && dead.has(v['@id']))).map(scrub);
  if (x && typeof x === 'object') {
    const o: any = {};
    for (const [k, v] of Object.entries(x)) {
      if (v && typeof v === 'object' && !Array.isArray(v) && Object.keys(v as object).length === 1 && dead.has((v as any)['@id'])) continue;
      const sv = scrub(v);
      if (Array.isArray(sv) && sv.length === 0 && Array.isArray(v) && v.length > 0) continue;
      o[k] = sv;
    }
    return o;
  }
  return x;
};
const cleanGraph = scrub((graph as any[]).filter((n) => !BANNED_TYPES.has(n['@type'])));
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': cleanGraph }).replace(/</g, '\\u003c');
const gsc = import.meta.env.PUBLIC_GSC_VERIFICATION;
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <!-- Safety net against mixed content: the browser upgrades any http:// sub-resource to https:// (the pages themselves are served over HTTPS only). -->
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {pageKey === 'home' && lang === 'cs' && <meta name="seznam-wmt" content="smOudwpeaYUPsXVuqqvEDh2HY4hbh3Pb" />}
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    {!noindex && hreflangs.length > 1 && hreflangs.map(({ l, href }) => <link rel="alternate" hreflang={l} href={href} />)}
    {!noindex && hreflangs.length > 1 && xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:image" content={abs(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.brand} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0B0B0F" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {gsc && <meta name="google-site-verification" content={gsc} />}
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip" href="#main">{t(lang).skip}</a>
    <Header lang={lang} pageKey={pageKey} alternates={alternates} langFallback={langFallback} />
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} lang={lang} />}
    <main id="main">
      <Fragment set:html={body} />
    </main>
    <Footer lang={lang} />
    {pageKey !== 'thanks' && <LeadModal lang={lang} />}
    <Analytics lang={lang} />
  </body>
</html>
