---
// Every URL of the site is generated here from i18n/routes.ts and the blog collection.
import type { GetStaticPaths } from 'astro';
import { PAGE_KEYS, ROUTES, langsFor, SERVICE_KEYS, type Lang, type PageKey, type ServiceKey } from '../i18n/routes';
import { allPosts, postUrl, type Post } from '../lib/blog';
import Home from '../views/Home.astro';
import HomeCsPage from '../views/HomeCsPage.astro';
import HomeEnPage from '../views/HomeEnPage.astro';
import Audit from '../views/Audit.astro';
import AuditRuPage from '../views/AuditRuPage.astro';
import AuditCsPage from '../views/AuditCsPage.astro';
import Service from '../views/Service.astro';
import ConsultingPage from '../views/ConsultingPage.astro';
import ConsultingCsPage from '../views/ConsultingCsPage.astro';
import StartPage from '../views/StartPage.astro';
import StartCsPage from '../views/StartCsPage.astro';
import FullSeoPage from '../views/FullSeoPage.astro';
import FullSeoCsPage from '../views/FullSeoCsPage.astro';
import MapsPage from '../views/MapsPage.astro';
import MapsCsPage from '../views/MapsCsPage.astro';
import Geo from '../views/Geo.astro';
import GeoCsPage from '../views/GeoCsPage.astro';
import Cases from '../views/Cases.astro';
import Case from '../views/Case.astro';
import CaseCsPage from '../views/CaseCsPage.astro';
import CaseHalfCsPage from '../views/CaseHalfCsPage.astro';
import CaseHalfRuPage from '../views/CaseHalfRuPage.astro';
import CaseRazborRuPage from '../views/CaseRazborRuPage.astro';
import CaseTypoRuPage from '../views/CaseTypoRuPage.astro';
import CaseTypoCsPage from '../views/CaseTypoCsPage.astro';
import CaseEduRuPage from '../views/CaseEduRuPage.astro';
import CaseEduCsPage from '../views/CaseEduCsPage.astro';
import CaseSeasonRuPage from '../views/CaseSeasonRuPage.astro';
import CaseSeasonCsPage from '../views/CaseSeasonCsPage.astro';
import Reviews from '../views/Reviews.astro';
import PostIndexingCsPage from '../views/PostIndexingCsPage.astro';
import PostNotShownCsPage from '../views/PostNotShownCsPage.astro';
import PostSeoAuditCsPage from '../views/PostSeoAuditCsPage.astro';
import PostDuplicatesCsPage from '../views/PostDuplicatesCsPage.astro';
import PostRedesignCsPage from '../views/PostRedesignCsPage.astro';
import PostAdsCsPage from '../views/PostAdsCsPage.astro';
import PostRedirectsCsPage from '../views/PostRedirectsCsPage.astro';
import PostNewSiteCsPage from '../views/PostNewSiteCsPage.astro';
import PostChooseCsPage from '../views/PostChooseCsPage.astro';
import NicheTranslationCsPage from '../views/NicheTranslationCsPage.astro';
import NicheTranslationBrnoCsPage from '../views/NicheTranslationBrnoCsPage.astro';
import NicheTranslationPardubiceCsPage from '../views/NicheTranslationPardubiceCsPage.astro';
import NicheRealtyCsPage from '../views/NicheRealtyCsPage.astro';
import NicheRealtyRuPage from '../views/NicheRealtyRuPage.astro';
import PostAccountingChannelsCsPage from '../views/PostAccountingChannelsCsPage.astro';
import PostFinanceChannelsRuPage from '../views/PostFinanceChannelsRuPage.astro';
import NicheTranslationRuPage from '../views/NicheTranslationRuPage.astro';
import NicheElectronicsRuPage from '../views/NicheElectronicsRuPage.astro';
import NicheFitnessRuPage from '../views/NicheFitnessRuPage.astro';
import NicheElectronicsCsPage from '../views/NicheElectronicsCsPage.astro';
import NicheGamingRuPage from '../views/NicheGamingRuPage.astro';
import NicheGamingCsPage from '../views/NicheGamingCsPage.astro';
import NicheMachineryCsPage from '../views/NicheMachineryCsPage.astro';
import NicheTypographyCsPage from '../views/NicheTypographyCsPage.astro';
import NicheFinanceRuPage from '../views/NicheFinanceRuPage.astro';
import NicheAccountingCsPage from '../views/NicheAccountingCsPage.astro';
import PostNoLeadsCsPage from '../views/PostNoLeadsCsPage.astro';
import PostClientsCsPage from '../views/PostClientsCsPage.astro';
import PostB2bCsPage from '../views/PostB2bCsPage.astro';
import PostPairsCsPage from '../views/PostPairsCsPage.astro';
import PostRealtyCsPage from '../views/PostRealtyCsPage.astro';
import PostRealtyNoLeadsCsPage from '../views/PostRealtyNoLeadsCsPage.astro';
import PostRealtySmallCsPage from '../views/PostRealtySmallCsPage.astro';
import PostRealtyListingsCsPage from '../views/PostRealtyListingsCsPage.astro';
import PostRealtyLocalCsPage from '../views/PostRealtyLocalCsPage.astro';
import PostRealtyDistrictsCsPage from '../views/PostRealtyDistrictsCsPage.astro';
import PostRealtyPortalsCsPage from '../views/PostRealtyPortalsCsPage.astro';
import Blog from '../views/Blog.astro';
import PostView from '../views/Post.astro';
import Faq from '../views/Faq.astro';
import About from '../views/About.astro';
import AboutCsPage from '../views/AboutCsPage.astro';
import Contact from '../views/Contact.astro';
import Privacy from '../views/Privacy.astro';
import Thanks from '../views/Thanks.astro';

export const getStaticPaths = (async () => {
  // Must live inside getStaticPaths: it is hoisted out of the component scope.
  const toParam = (p: string) => p.replace(/^\/|\/$/g, '') || undefined;
  const pages = PAGE_KEYS.flatMap((key) =>
    langsFor(key).map((lang) => ({ params: { slug: toParam(ROUTES[key][lang]) }, props: { key, lang } })),
  );
  const posts = (await allPosts()).map((post) => ({ params: { slug: toParam(postUrl(post)) }, props: { post } }));
  return [...pages, ...posts];
}) satisfies GetStaticPaths;

type Props = { key: PageKey; lang: Lang; post?: undefined } | { post: Post; key?: undefined; lang?: undefined };
const props = Astro.props as Props;

const VIEWS: Record<Exclude<PageKey, ServiceKey>, any> = {
  caseTypo: null, caseEdu: null, caseSeason: null, caseHalf: null, caseRazbor: null, nicheTranslation: null, nicheBrno: null, nichePardubice: null, nicheRealty: null, nicheAccounting: null, nicheFinance: null, nicheTypography: null, nicheMachinery: null, nicheGaming: null, nicheElectronics: null, nicheFitness: null, postIndexing: null, postNotShown: null, postSeoAudit: null, postDuplicates: null, postRedesign: null, postAds: null, postRedirects: null, postNewSite: null, postChoose: null, postNoLeads: null, postClients: null, postB2b: null, postPairs: null, postRealty: null, postRealtyNoLeads: null, postRealtySmall: null, postRealtyListings: null, postRealtyPortals: null, postRealtyDistricts: null, postRealtyLocal: null, postFinanceChannels: null, postAccountingChannels: null,
  home: Home, audit: Audit, geo: Geo, cases: Cases, caseKb: Case, reviews: Reviews,
  blog: Blog, faq: Faq, about: About, contact: Contact, privacy: Privacy, thanks: Thanks,
};
const isService = (k: PageKey): k is ServiceKey => (SERVICE_KEYS as readonly string[]).includes(k);
const View = props.key && !isService(props.key) && !(props.key === 'home' && (props.lang === 'cs' || props.lang === 'en')) && !(props.key === 'about' && props.lang === 'cs') && !(props.key === 'audit' && (props.lang === 'ru' || props.lang === 'cs')) && !(props.key === 'geo' && props.lang === 'cs') && !(props.key === 'caseKb' && props.lang === 'cs') ? VIEWS[props.key] : null;
---
{props.post && <PostView post={props.post} />}
{props.key === 'home' && props.lang === 'cs' && <HomeCsPage />}
{props.key === 'home' && props.lang === 'en' && <HomeEnPage />}
{props.key === 'about' && props.lang === 'cs' && <AboutCsPage />}
{props.key === 'audit' && props.lang === 'cs' && <AuditCsPage />}
{props.key === 'audit' && props.lang === 'ru' && <AuditRuPage />}
{props.key === 'geo' && props.lang === 'cs' && <GeoCsPage />}
{props.key === 'caseKb' && props.lang === 'cs' && <CaseCsPage />}
{props.key === 'postIndexing' && props.lang === 'cs' && <PostIndexingCsPage />}
{props.key === 'postNotShown' && props.lang === 'cs' && <PostNotShownCsPage />}
{props.key === 'postSeoAudit' && props.lang === 'cs' && <PostSeoAuditCsPage />}
{props.key === 'postDuplicates' && props.lang === 'cs' && <PostDuplicatesCsPage />}
{props.key === 'postRedesign' && props.lang === 'cs' && <PostRedesignCsPage />}
{props.key === 'postAds' && props.lang === 'cs' && <PostAdsCsPage />}
{props.key === 'postRedirects' && props.lang === 'cs' && <PostRedirectsCsPage />}
{props.key === 'postNewSite' && props.lang === 'cs' && <PostNewSiteCsPage />}
{props.key === 'postChoose' && props.lang === 'cs' && <PostChooseCsPage />}
{props.key === 'postNoLeads' && props.lang === 'cs' && <PostNoLeadsCsPage />}
{props.key === 'postClients' && props.lang === 'cs' && <PostClientsCsPage />}
{props.key === 'postB2b' && props.lang === 'cs' && <PostB2bCsPage />}
{props.key === 'postPairs' && props.lang === 'cs' && <PostPairsCsPage />}
{props.key === 'postRealty' && props.lang === 'cs' && <PostRealtyCsPage />}
{props.key === 'postRealtyNoLeads' && props.lang === 'cs' && <PostRealtyNoLeadsCsPage />}
{props.key === 'postRealtySmall' && props.lang === 'cs' && <PostRealtySmallCsPage />}
{props.key === 'postRealtyListings' && props.lang === 'cs' && <PostRealtyListingsCsPage />}
{props.key === 'postRealtyPortals' && props.lang === 'cs' && <PostRealtyPortalsCsPage />}
{props.key === 'postRealtyDistricts' && props.lang === 'cs' && <PostRealtyDistrictsCsPage />}
{props.key === 'postRealtyLocal' && props.lang === 'cs' && <PostRealtyLocalCsPage />}
{props.key === 'caseHalf' && props.lang === 'cs' && <CaseHalfCsPage />}
{props.key === 'caseHalf' && props.lang === 'ru' && <CaseHalfRuPage />}
{props.key === 'caseRazbor' && props.lang === 'ru' && <CaseRazborRuPage />}
{props.key === 'nicheTranslation' && props.lang === 'cs' && <NicheTranslationCsPage />}
{props.key === 'nicheTranslation' && props.lang === 'ru' && <NicheTranslationRuPage />}
{props.key === 'nicheBrno' && props.lang === 'cs' && <NicheTranslationBrnoCsPage />}
{props.key === 'nichePardubice' && props.lang === 'cs' && <NicheTranslationPardubiceCsPage />}
{props.key === 'nicheRealty' && props.lang === 'cs' && <NicheRealtyCsPage />}
{props.key === 'nicheRealty' && props.lang === 'ru' && <NicheRealtyRuPage />}
{props.key === 'postAccountingChannels' && props.lang === 'cs' && <PostAccountingChannelsCsPage />}
{props.key === 'postFinanceChannels' && props.lang === 'ru' && <PostFinanceChannelsRuPage />}
{props.key === 'nicheFitness' && props.lang === 'ru' && <NicheFitnessRuPage />}
{props.key === 'nicheElectronics' && props.lang === 'cs' && <NicheElectronicsCsPage />}
{props.key === 'nicheElectronics' && props.lang === 'ru' && <NicheElectronicsRuPage />}
{props.key === 'nicheGaming' && props.lang === 'cs' && <NicheGamingCsPage />}
{props.key === 'nicheGaming' && props.lang === 'ru' && <NicheGamingRuPage />}
{props.key === 'nicheMachinery' && props.lang === 'cs' && <NicheMachineryCsPage />}
{props.key === 'nicheTypography' && props.lang === 'cs' && <NicheTypographyCsPage />}
{props.key === 'nicheFinance' && props.lang === 'ru' && <NicheFinanceRuPage />}
{props.key === 'nicheAccounting' && props.lang === 'cs' && <NicheAccountingCsPage />}
{props.key === 'caseTypo' && props.lang === 'cs' && <CaseTypoCsPage />}
{props.key === 'caseTypo' && props.lang === 'ru' && <CaseTypoRuPage />}
{props.key === 'caseEdu' && props.lang === 'cs' && <CaseEduCsPage />}
{props.key === 'caseEdu' && props.lang === 'ru' && <CaseEduRuPage />}
{props.key === 'caseSeason' && props.lang === 'cs' && <CaseSeasonCsPage />}
{props.key === 'caseSeason' && props.lang === 'ru' && <CaseSeasonRuPage />}
{props.key === 'consulting' && props.lang === 'cs' && <ConsultingCsPage />}
{props.key === 'consulting' && props.lang === 'ru' && <ConsultingPage lang="ru" />}
{props.key === 'consulting' && props.lang === 'en' && <ConsultingPage lang="en" />}
{props.key === 'start' && props.lang === 'cs' && <StartCsPage />}
{props.key === 'start' && props.lang === 'ru' && <StartPage />}
{props.key === 'fullSeo' && props.lang === 'cs' && <FullSeoCsPage />}
{props.key === 'fullSeo' && props.lang === 'ru' && <FullSeoPage />}
{props.key === 'maps' && props.lang === 'cs' && <MapsCsPage />}
{props.key === 'maps' && props.lang === 'ru' && <MapsPage />}
{props.key && isService(props.key) && !(props.key === 'consulting') && !(props.key === 'start' && (props.lang === 'ru' || props.lang === 'cs')) && !(props.key === 'fullSeo' && (props.lang === 'ru' || props.lang === 'cs')) && !(props.key === 'maps' && (props.lang === 'ru' || props.lang === 'cs')) && <Service lang={props.lang} service={props.key} />}
{View && <View lang={props.lang} />}
