---
// Every URL of the site is generated here from i18n/routes.ts and the blog collection.
import type { GetStaticPaths } from 'astro';
import { PAGE_KEYS, ROUTES, langsFor, SERVICE_KEYS, type Lang, type PageKey, type ServiceKey } from '../i18n/routes';
import { allPosts, postUrl, type Post } from '../lib/blog';
import Home from '../views/Home.astro';
import HomeCsPage from '../views/HomeCsPage.astro';
import Audit from '../views/Audit.astro';
import AuditRuPage from '../views/AuditRuPage.astro';
import AuditCsPage from '../views/AuditCsPage.astro';
import Service from '../views/Service.astro';
import ConsultingPage from '../views/ConsultingPage.astro';
import ConsultingCsPage from '../views/ConsultingCsPage.astro';
import StartPage from '../views/StartPage.astro';
import StartCsPage from '../views/StartCsPage.astro';
import FullSeoPage from '../views/FullSeoPage.astro';
import FullSeoCsPage from '../views/FullSeoCsPage.astro';
import MapsPage from '../views/MapsPage.astro';
import MapsCsPage from '../views/MapsCsPage.astro';
import Geo from '../views/Geo.astro';
import GeoCsPage from '../views/GeoCsPage.astro';
import Cases from '../views/Cases.astro';
import Case from '../views/Case.astro';
import CaseCsPage from '../views/CaseCsPage.astro';
import CaseHalfCsPage from '../views/CaseHalfCsPage.astro';
import CaseTypoRuPage from '../views/CaseTypoRuPage.astro';
import CaseTypoCsPage from '../views/CaseTypoCsPage.astro';
import CaseEduRuPage from '../views/CaseEduRuPage.astro';
import CaseEduCsPage from '../views/CaseEduCsPage.astro';
import CaseSeasonRuPage from '../views/CaseSeasonRuPage.astro';
import CaseSeasonCsPage from '../views/CaseSeasonCsPage.astro';
import Reviews from '../views/Reviews.astro';
import PostIndexingCsPage from '../views/PostIndexingCsPage.astro';
import Blog from '../views/Blog.astro';
import PostView from '../views/Post.astro';
import Faq from '../views/Faq.astro';
import About from '../views/About.astro';
import AboutCsPage from '../views/AboutCsPage.astro';
import Contact from '../views/Contact.astro';
import Privacy from '../views/Privacy.astro';
import Thanks from '../views/Thanks.astro';

export const getStaticPaths = (async () => {
  // Must live inside getStaticPaths: it is hoisted out of the component scope.
  const toParam = (p: string) => p.replace(/^\/|\/$/g, '') || undefined;
  const pages = PAGE_KEYS.flatMap((key) =>
    langsFor(key).map((lang) => ({ params: { slug: toParam(ROUTES[key][lang]) }, props: { key, lang } })),
  );
  const posts = (await allPosts()).map((post) => ({ params: { slug: toParam(postUrl(post)) }, props: { post } }));
  return [...pages, ...posts];
}) satisfies GetStaticPaths;

type Props = { key: PageKey; lang: Lang; post?: undefined } | { post: Post; key?: undefined; lang?: undefined };
const props = Astro.props as Props;

const VIEWS: Record<Exclude<PageKey, ServiceKey>, any> = {
  caseTypo: null, caseEdu: null, caseSeason: null, caseHalf: null, postIndexing: null,
  home: Home, audit: Audit, geo: Geo, cases: Cases, caseKb: Case, reviews: Reviews,
  blog: Blog, faq: Faq, about: About, contact: Contact, privacy: Privacy, thanks: Thanks,
};
const isService = (k: PageKey): k is ServiceKey => (SERVICE_KEYS as readonly string[]).includes(k);
const View = props.key && !isService(props.key) && !(props.key === 'home' && props.lang === 'cs') && !(props.key === 'about' && props.lang === 'cs') && !(props.key === 'audit' && (props.lang === 'ru' || props.lang === 'cs')) && !(props.key === 'geo' && props.lang === 'cs') && !(props.key === 'caseKb' && props.lang === 'cs') ? VIEWS[props.key] : null;
---
{props.post && <PostView post={props.post} />}
{props.key === 'home' && props.lang === 'cs' && <HomeCsPage />}
{props.key === 'about' && props.lang === 'cs' && <AboutCsPage />}
{props.key === 'audit' && props.lang === 'cs' && <AuditCsPage />}
{props.key === 'audit' && props.lang === 'ru' && <AuditRuPage />}
{props.key === 'geo' && props.lang === 'cs' && <GeoCsPage />}
{props.key === 'caseKb' && props.lang === 'cs' && <CaseCsPage />}
{props.key === 'postIndexing' && props.lang === 'cs' && <PostIndexingCsPage />}
{props.key === 'caseHalf' && props.lang === 'cs' && <CaseHalfCsPage />}
{props.key === 'caseTypo' && props.lang === 'cs' && <CaseTypoCsPage />}
{props.key === 'caseTypo' && props.lang === 'ru' && <CaseTypoRuPage />}
{props.key === 'caseEdu' && props.lang === 'cs' && <CaseEduCsPage />}
{props.key === 'caseEdu' && props.lang === 'ru' && <CaseEduRuPage />}
{props.key === 'caseSeason' && props.lang === 'cs' && <CaseSeasonCsPage />}
{props.key === 'caseSeason' && props.lang === 'ru' && <CaseSeasonRuPage />}
{props.key === 'consulting' && props.lang === 'cs' && <ConsultingCsPage />}
{props.key === 'consulting' && props.lang === 'ru' && <ConsultingPage lang="ru" />}
{props.key === 'start' && props.lang === 'cs' && <StartCsPage />}
{props.key === 'start' && props.lang === 'ru' && <StartPage />}
{props.key === 'fullSeo' && props.lang === 'cs' && <FullSeoCsPage />}
{props.key === 'fullSeo' && props.lang === 'ru' && <FullSeoPage />}
{props.key === 'maps' && props.lang === 'cs' && <MapsCsPage />}
{props.key === 'maps' && props.lang === 'ru' && <MapsPage />}
{props.key && isService(props.key) && !(props.key === 'consulting' && props.lang !== 'en') && !(props.key === 'start' && (props.lang === 'ru' || props.lang === 'cs')) && !(props.key === 'fullSeo' && (props.lang === 'ru' || props.lang === 'cs')) && !(props.key === 'maps' && (props.lang === 'ru' || props.lang === 'cs')) && <Service lang={props.lang} service={props.key} />}
{View && <View lang={props.lang} />}
