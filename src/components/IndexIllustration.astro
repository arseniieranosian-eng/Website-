---
// Drawn illustrations (not screenshots) for the indexing article. Real SVG text, light palette, 640 × 300.
interface Props { kind: 'site' | 'inspect' | 'pages' | 'sitemaps' | 'wp' | 'manual' | 'parts' | 'dupreport' | 'addresses' | 'drop' | 'e404' | 'map' | 'chain' | 'gscadd' | 'flow'; aria: string }
const { kind, aria } = Astro.props;
---
<svg class="post-illus" viewBox="0 0 640 300" role="img" aria-label={aria} xmlns="http://www.w3.org/2000/svg" font-family="Inter, system-ui, Arial, sans-serif">
  <rect x="0.5" y="0.5" width="639" height="299" rx="12" fill="#fff" stroke="#e3e7ef" />
  {kind === 'site' && (
    <>
      <rect x="24" y="22" width="592" height="40" rx="20" fill="#fff" stroke="#c9d0de" />
      <circle cx="46" cy="42" r="7" fill="none" stroke="#5b6272" stroke-width="2" /><path d="M51 47l6 6" stroke="#5b6272" stroke-width="2" stroke-linecap="round" />
      <text x="68" y="48" font-size="16" fill="#0b0b0f">site:vasedomena.cz</text>
      <text x="28" y="88" font-size="13" fill="#5b6272">Přibližně 120 výsledků</text>
      {[0, 1, 2].map((i) => (
        <>
          <text x="28" y={116 + i * 62} font-size="12" fill="#5b6272">vasedomena.cz › {['', 'sluzby', 'kontakt'][i]}</text>
          <text x="28" y={136 + i * 62} font-size="17" fill="#1f4fd8">{['Úvodní stránka | Vaše firma', 'Naše služby | Vaše firma', 'Kontakt | Vaše firma'][i]}</text>
          <rect x="28" y={146 + i * 62} width={470 - i * 50} height="7" rx="3.5" fill="#e3e7ef" />
        </>
      ))}
    </>
  )}
  {kind === 'inspect' && (
    <>
      <rect x="24" y="22" width="592" height="40" rx="8" fill="#f4f6fa" stroke="#c9d0de" />
      <circle cx="46" cy="42" r="7" fill="none" stroke="#5b6272" stroke-width="2" /><path d="M51 47l6 6" stroke="#5b6272" stroke-width="2" stroke-linecap="round" />
      <text x="68" y="48" font-size="15" fill="#0b0b0f">https://vasedomena.cz/sluzby/</text>
      <rect x="24" y="84" width="592" height="196" rx="10" fill="#fff" stroke="#e3e7ef" />
      <circle cx="56" cy="124" r="16" fill="#1e8e3e" /><path d="M48 124l6 6 11-12" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" />
      <text x="84" y="130" font-size="18" font-weight="700" fill="#0b0b0f">Adresa URL je v Googlu</text>
      <text x="48" y="172" font-size="14" fill="#5b6272">Stránka byla nalezena, prolezena a zařazena do indexu.</text>
      <rect x="48" y="196" width="400" height="8" rx="4" fill="#e3e7ef" /><rect x="48" y="216" width="320" height="8" rx="4" fill="#e3e7ef" />
      <rect x="440" y="238" width="156" height="30" rx="15" fill="none" stroke="#1f4fd8" />
      <text x="518" y="258" font-size="13" font-weight="600" fill="#1f4fd8" text-anchor="middle">Požádat o indexaci</text>
    </>
  )}
  {kind === 'pages' && (
    <>
      <text x="28" y="40" font-size="16" font-weight="700" fill="#0b0b0f">Stránky</text>
      <rect x="28" y="56" width="300" height="26" rx="6" fill="#1e8e3e" />
      <rect x="328" y="56" width="120" height="26" rx="6" fill="#9aa3b5" />
      <text x="28" y="104" font-size="13" fill="#5b6272">Indexované (ukázkově 75 %)</text>
      <text x="328" y="104" font-size="13" fill="#5b6272">Neindexované (25 %)</text>
      <text x="28" y="140" font-size="14" font-weight="700" fill="#0b0b0f">Důvody, proč se stránky neindexují</text>
      {['Vyloučeno značkou noindex', 'Zablokováno souborem robots.txt', 'Duplicitní stránka, canonical na jinou adresu'].map((r, i) => (
        <>
          <line x1="28" x2="612" y1={156 + i * 44} y2={156 + i * 44} stroke="#e3e7ef" />
          <text x="28" y={184 + i * 44} font-size="14" fill="#0b0b0f">{r}</text>
          <text x="612" y={184 + i * 44} font-size="14" fill="#5b6272" text-anchor="end">{['4', '2', '11'][i]}</text>
        </>
      ))}
    </>
  )}
  {kind === 'sitemaps' && (
    <>
      <text x="28" y="40" font-size="16" font-weight="700" fill="#0b0b0f">Mapy webu</text>
      <text x="28" y="76" font-size="13" fill="#5b6272">Přidat novou mapu webu</text>
      <rect x="28" y="88" width="420" height="36" rx="8" fill="#f4f6fa" stroke="#c9d0de" />
      <text x="40" y="111" font-size="14" fill="#0b0b0f">https://vasedomena.cz/sitemap.xml</text>
      <rect x="464" y="88" width="100" height="36" rx="18" fill="#1f4fd8" />
      <text x="514" y="111" font-size="14" font-weight="600" fill="#fff" text-anchor="middle">Odeslat</text>
      <text x="28" y="168" font-size="13" fill="#5b6272">Odeslané mapy webu</text>
      <rect x="28" y="180" width="584" height="76" rx="10" fill="#fff" stroke="#e3e7ef" />
      <text x="44" y="206" font-size="14" font-weight="600" fill="#0b0b0f">sitemap.xml</text>
      <text x="44" y="236" font-size="13" fill="#1e8e3e">● Úspěch</text>
      <text x="612" y="236" font-size="13" fill="#5b6272" text-anchor="end">Zjištěné stránky: 120 (ukázkově)</text>
    </>
  )}
  {kind === 'wp' && (
    <>
      <text x="28" y="40" font-size="16" font-weight="700" fill="#0b0b0f">Nastavení › Čtení</text>
      <line x1="28" x2="612" y1="58" y2="58" stroke="#e3e7ef" />
      <text x="28" y="96" font-size="14" fill="#5b6272">Viditelnost pro vyhledávače</text>
      <rect x="28" y="112" width="22" height="22" rx="4" fill="#1f4fd8" /><path d="M33 123l5 5 8-10" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" />
      <text x="62" y="129" font-size="15" fill="#0b0b0f">Odrazovat vyhledávače od indexování webu</text>
      <text x="62" y="154" font-size="13" fill="#5b6272">Je na vyhledávačích, zda se tímto požadavkem budou řídit.</text>
      <rect x="28" y="190" width="150" height="36" rx="6" fill="#1f4fd8" /><text x="103" y="213" font-size="14" font-weight="600" fill="#fff" text-anchor="middle">Uložit změny</text>
      <text x="28" y="268" font-size="13" fill="#b3261e">Zapnutá volba po spuštění webu může web skrýt před Googlem.</text>
    </>
  )}
  {kind === 'manual' && (
    <>
      <text x="28" y="40" font-size="16" font-weight="700" fill="#0b0b0f">Ruční akce</text>
      <text x="28" y="64" font-size="13" fill="#5b6272">Zabezpečení a ruční akce</text>
      <line x1="28" x2="612" y1="78" y2="78" stroke="#e3e7ef" />
      <circle cx="58" cy="130" r="18" fill="#1e8e3e" /><path d="M49 130l7 7 12-14" stroke="#fff" stroke-width="3.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
      <text x="92" y="127" font-size="18" font-weight="700" fill="#0b0b0f">Nebyly zjištěny žádné problémy</text>
      <text x="92" y="150" font-size="13" fill="#5b6272">Ruční akce: žádné · Problémy se zabezpečením: žádné</text>
      <rect x="28" y="190" width="584" height="70" rx="10" fill="#f4f6fa" stroke="#e3e7ef" />
      <text x="44" y="220" font-size="14" fill="#0b0b0f">Pokud je tu hlášení, řiďte se jím.</text>
      <text x="44" y="242" font-size="13" fill="#5b6272">Ukázkový stav bez problémů.</text>
    </>
  )}
  {kind === 'parts' && (
    <>
      <text x="28" y="40" font-size="16" font-weight="700" fill="#0b0b0f">Pět částí SEO auditu</text>
      {['Technika', 'Obsah a struktura', 'Vnější odkazy', 'Konkurence', 'Místní vyhledávání'].map((n, i) => (
        <>
          <rect x={28 + i * 117} y="70" width="108" height="150" rx="10" fill={i === 0 ? '#1f4fd8' : '#f4f6fa'} stroke={i === 0 ? '#1f4fd8' : '#e3e7ef'} />
          <text x={82 + i * 117} y="104" font-size="26" font-weight="700" text-anchor="middle" fill={i === 0 ? '#fff' : '#9aa3b5'}>{i + 1}</text>
          <text x={82 + i * 117} y="150" font-size="13" font-weight="600" text-anchor="middle" fill={i === 0 ? '#fff' : '#0b0b0f'}>{n.split(' ')[0]}</text>
          <text x={82 + i * 117} y="168" font-size="13" font-weight="600" text-anchor="middle" fill={i === 0 ? '#fff' : '#0b0b0f'}>{n.split(' ').slice(1).join(' ')}</text>
        </>
      ))}
      <text x="28" y="252" font-size="13" fill="#1f4fd8" font-weight="600">Bezplatný audit pokrývá jen první část: technické chyby.</text>
    </>
  )}
  {kind === 'dupreport' && (
    <>
      <text x="28" y="40" font-size="16" font-weight="700" fill="#0b0b0f">Stránky</text>
      <text x="28" y="72" font-size="14" font-weight="700" fill="#0b0b0f">Důvody, proč se stránky neindexují</text>
      {['Duplicitní stránka bez kanonické stránky zvolené uživatelem', 'Alternativní stránka se správnou značkou canonical', 'Vyloučeno značkou noindex'].map((r, i) => (
        <>
          <line x1="28" x2="612" y1={90 + i * 50} y2={90 + i * 50} stroke="#e3e7ef" />
          <text x="28" y={120 + i * 50} font-size="14" fill="#0b0b0f">{r}</text>
          <text x="612" y={120 + i * 50} font-size="14" fill="#5b6272" text-anchor="end">{['6', '3', '2'][i]}</text>
        </>
      ))}
      <line x1="28" x2="612" y1="240" y2="240" stroke="#e3e7ef" />
      <text x="28" y="272" font-size="13" fill="#5b6272">Hodnoty jsou ukázkové; názvy důvodů se v Search Console mohou lišit.</text>
    </>
  )}
  {kind === 'addresses' && (
    <>
      {[['http://vasedomena.cz/sluzba', 'http'], ['https://vasedomena.cz/sluzba/', 'https'], ['https://www.vasedomena.cz/sluzba/', 'www']].map(([u], i) => (
        <>
          <rect x="28" y={28 + i * 66} width="584" height="48" rx="24" fill="#fff" stroke="#c4cde0" />
          <circle cx="56" cy={52 + i * 66} r="7" fill="#9aa3b5" />
          <text x="76" y={58 + i * 66} font-size="17" fill="#0b0b0f">{u}</text>
          <text x="596" y={58 + i * 66} font-size="13" fill="#5b6272" text-anchor="end">stejná stránka</text>
        </>
      ))}
      <text x="28" y="258" font-size="14" font-weight="600" fill="#1f4fd8">Tři adresy, jeden obsah: Google vybere jednu a ostatní nezařadí.</text>
      <text x="28" y="282" font-size="13" fill="#5b6272">Řešení: přesměrování 301 na jednu verzi.</text>
    </>
  )}
  {kind === 'drop' && (
    <>
      <text x="28" y="40" font-size="16" font-weight="700" fill="#0b0b0f">Návštěvnost webu</text>
      <line x1="28" x2="612" y1="250" y2="250" stroke="#c4cde0" /><line x1="28" x2="28" y1="60" y2="250" stroke="#c4cde0" />
      <polyline points="28,130 90,118 150,126 210,112 270,120 330,116" fill="none" stroke="#1f4fd8" stroke-width="3" stroke-linejoin="round" />
      <line x1="330" x2="330" y1="60" y2="250" stroke="#ff6a1a" stroke-width="2" stroke-dasharray="6 5" />
      <text x="338" y="76" font-size="13" font-weight="600" fill="#ff6a1a">spuštění nového webu</text>
      <polyline points="330,116 390,190 450,200 510,196 570,204 612,200" fill="none" stroke="#1f4fd8" stroke-width="3" stroke-linejoin="round" />
      <text x="28" y="276" font-size="13" fill="#5b6272">Nejdřív ověřte, zda je pokles skutečný (měření, sezónnost), pak hledejte příčinu. Ukázkový průběh.</text>
    </>
  )}
  {kind === 'e404' && (
    <>
      <text x="28" y="40" font-size="16" font-weight="700" fill="#0b0b0f">Stránky</text>
      <text x="28" y="72" font-size="14" font-weight="700" fill="#0b0b0f">Důvody, proč se stránky neindexují</text>
      {['Nenalezeno (404)', 'Stránka s přesměrováním', 'Vyloučeno značkou noindex'].map((r, i) => (
        <>
          <line x1="28" x2="612" y1={90 + i * 50} y2={90 + i * 50} stroke="#e3e7ef" />
          <text x="28" y={120 + i * 50} font-size="14" fill="#0b0b0f">{r}</text>
          <text x="612" y={120 + i * 50} font-size="14" fill="#5b6272" text-anchor="end">{['14', '5', '1'][i]}</text>
        </>
      ))}
      <line x1="28" x2="612" y1="240" y2="240" stroke="#e3e7ef" />
      <text x="28" y="272" font-size="13" fill="#5b6272">Hodnoty jsou ukázkové; názvy důvodů se v Search Console mohou lišit.</text>
    </>
  )}
  {kind === 'flow' && (
    <>
      <text x="28" y="40" font-size="16" font-weight="700" fill="#0b0b0f">Pořadí kroků</text>
      {['Základ webu', 'Měření', 'Reklama', 'Přesun rozpočtu'].map((n, i) => (
        <>
          <rect x={28 + i * 150} y="80" width="130" height="110" rx="12" fill={i === 0 ? '#1f4fd8' : '#f4f6fa'} stroke={i === 0 ? '#1f4fd8' : '#e3e7ef'} />
          <text x={93 + i * 150} y="124" font-size="24" font-weight="700" text-anchor="middle" fill={i === 0 ? '#fff' : '#9aa3b5'}>{i + 1}</text>
          <text x={93 + i * 150} y="160" font-size="15" font-weight="600" text-anchor="middle" fill={i === 0 ? '#fff' : '#0b0b0f'}>{n}</text>
          {i < 3 && <path d={`M${162 + i * 150} 135h12m-5 -5l5 5l-5 5`} stroke="#5b6272" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />}
        </>
      ))}
      <text x="28" y="232" font-size="13" fill="#5b6272">Nejdřív základ webu, pak měření, pak reklama na nejlepší stránky</text>
      <text x="28" y="252" font-size="13" fill="#5b6272">a přesun rozpočtu tam, kde funguje.</text>
    </>
  )}
  {kind === 'map' && (
    <>
      <text x="28" y="40" font-size="16" font-weight="700" fill="#0b0b0f">Mapa přesměrování</text>
      <text x="28" y="76" font-size="13" font-weight="600" fill="#5b6272">Stará adresa</text>
      <text x="360" y="76" font-size="13" font-weight="600" fill="#5b6272">Nová adresa</text>
      {[['/sluzby/seo', '/seo/'], ['/o-nas/tym', '/o-mne/'], ['/blog/clanek-12', '/blog/nazev-clanku/']].map(([a, b], i) => (
        <>
          <rect x="28" y={92 + i * 56} width="270" height="40" rx="8" fill="#f4f6fa" stroke="#e3e7ef" />
          <text x="44" y={117 + i * 56} font-size="15" fill="#0b0b0f">{a}</text>
          <path d={`M308 ${112 + i * 56}h38m-8 -7l8 7l-8 7`} stroke="#1f4fd8" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          <text x="318" y={104 + i * 56} font-size="11" font-weight="700" fill="#1f4fd8">301</text>
          <rect x="360" y={92 + i * 56} width="252" height="40" rx="8" fill="#fff" stroke="#1f4fd8" />
          <text x="376" y={117 + i * 56} font-size="15" fill="#0b0b0f">{b}</text>
        </>
      ))}
      <text x="28" y="272" font-size="13" fill="#5b6272">Každá stará adresa vede na nejbližší odpovídající novou stránku. Ukázkové adresy.</text>
    </>
  )}
  {kind === 'chain' && (
    <>
      <text x="28" y="40" font-size="16" font-weight="700" fill="#0b0b0f">Řetězec přesměrování</text>
      {[['A', '/stara', '#b3261e'], ['B', '/mezi', '#b3261e'], ['C', '/nova/', '#1e8e3e']].map(([l, u, c], i) => (
        <>
          <rect x={28 + i * 210} y="76" width="170" height="60" rx="10" fill="#fff" stroke={c} stroke-width="2" />
          <text x={113 + i * 210} y="102" font-size="18" font-weight="700" text-anchor="middle" fill={c}>{l}</text>
          <text x={113 + i * 210} y="124" font-size="14" text-anchor="middle" fill="#0b0b0f">{u}</text>
          {i < 2 && <path d={`M${200 + i * 210} 106h30m-7 -6l7 6l-7 6`} stroke="#5b6272" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />}
        </>
      ))}
      <text x="28" y="176" font-size="14" font-weight="600" fill="#b3261e">A → B → C: zpomaluje a mate Google</text>
      <rect x="28" y="196" width="170" height="44" rx="10" fill="#fff" stroke="#1e8e3e" stroke-width="2" />
      <text x="113" y="224" font-size="14" text-anchor="middle" fill="#0b0b0f">A /stara</text>
      <path d="M208 218h80m-8 -6l8 6l-8 6" stroke="#1e8e3e" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
      <rect x="298" y="196" width="170" height="44" rx="10" fill="#fff" stroke="#1e8e3e" stroke-width="2" />
      <text x="383" y="224" font-size="14" text-anchor="middle" fill="#0b0b0f">C /nova/</text>
      <text x="480" y="224" font-size="13" font-weight="600" fill="#1e8e3e">přímo A → C</text>
    </>
  )}
  {kind === 'gscadd' && (
    <>
      <text x="28" y="40" font-size="16" font-weight="700" fill="#0b0b0f">Přidat vlastnost</text>
      <rect x="28" y="64" width="270" height="170" rx="12" fill="#f4f6fa" stroke="#1f4fd8" stroke-width="2" />
      <text x="46" y="94" font-size="14" font-weight="700" fill="#1f4fd8">Doména</text>
      <text x="46" y="118" font-size="12" fill="#5b6272">Všechny adresy včetně subdomén</text>
      <rect x="46" y="134" width="234" height="34" rx="8" fill="#fff" stroke="#c4cde0" /><text x="58" y="156" font-size="14" fill="#0b0b0f">vasedomena.cz</text>
      <rect x="46" y="184" width="100" height="34" rx="17" fill="#1f4fd8" /><text x="96" y="206" font-size="13" font-weight="600" fill="#fff" text-anchor="middle">Pokračovat</text>
      <rect x="322" y="64" width="290" height="170" rx="12" fill="#fff" stroke="#e3e7ef" />
      <text x="340" y="94" font-size="14" font-weight="700" fill="#0b0b0f">Předpona adresy URL</text>
      <text x="340" y="118" font-size="12" fill="#5b6272">Jen adresy s přesnou předponou</text>
      <rect x="340" y="134" width="254" height="34" rx="8" fill="#f4f6fa" stroke="#e3e7ef" /><text x="352" y="156" font-size="14" fill="#5b6272">https://vasedomena.cz/</text>
      <text x="28" y="268" font-size="13" fill="#5b6272">Ukázkové zjednodušení; skutečný postup ověření vlastnictví se může lišit.</text>
    </>
  )}
</svg>
