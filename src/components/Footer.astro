---
import { META } from '../i18n/meta';
import { SERVICE_KEYS, path, type Lang, type PageKey } from '../i18n/routes';
import { t } from '../i18n/ui';
import { SITE } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
// K7 (brief of 03.11.2026, P2.1): a line for reporting a mistake, in every language, a mailto link to the site's contact address.
const MISTAKE = { cs: ['Našli jste chybu? ', 'Napište mi.'], en: ['Found a mistake? ', 'Write to me.'], ru: ['Нашли ошибку? ', 'Напишите мне.'], uk: ['Знайшли помилку? ', 'Напишіть мені.'] }[lang];
const PAGES: PageKey[] = ['home', 'audit', 'geo', 'cases', 'about', 'reviews', 'faq', 'contact', ...(lang === 'cs' ? (['blog'] as PageKey[]) : [])];
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="logo logo--light" href={path('home', lang)}><img class="logo-img" src="/images/logo-mark.png" width="65" height="40" alt="" decoding="async" /><span class="logo-text">Arsenii Eranosian<small>SEO · GEO/AEO</small></span></a>
      <p class="muted">{ui.footerTagline}</p>
      <a class="btn btn--primary btn--sm" href={path('audit', lang)}>{ui.ctaAuditLong}</a>
    </div>
    <nav aria-label={ui.footerPages}>
      <p class="footer-title">{ui.footerPages}</p>
      <ul>{PAGES.map((k) => <li><a href={path(k, lang)}>{META[k][lang].name}</a></li>)}</ul>
    </nav>
    <nav aria-label={ui.footerServices}>
      <p class="footer-title">{ui.footerServices}</p>
      <ul>{SERVICE_KEYS.map((k) => <li><a href={path(k, lang)}>{META[k][lang].name}</a></li>)}</ul>
    </nav>
    <div>
      <p class="footer-title">{ui.footerContact}</p>
      <ul>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><a href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a></li>
        <li>{SITE.city}</li>
        {SITE.socials.map((s) => <li><a href={s.url} rel="me noopener" target="_blank">{s.name}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="container footer-mistake"><p class="small">{MISTAKE[0]}<a href={`mailto:${SITE.email}?subject=${encodeURIComponent(lang === 'cs' ? 'Chyba na webu' : lang === 'ru' ? 'Ошибка на сайте' : lang === 'uk' ? 'Помилка на сайті' : 'Mistake on the site')}`}>{MISTAKE[1]}</a></p></div>
  <div class="container footer-bottom">
    <span>© {year} {SITE.person} · IČO {SITE.ico}. {ui.rights}</span>
    <a href={path('privacy', lang)}>{META.privacy[lang].name}</a>
  </div>
</footer>
