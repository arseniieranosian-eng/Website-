---
// Signature under a pull quote of the author: small round photo, name (link to /o-mne/) and the title.
import { path } from '../i18n/routes';
import { SITE } from '../data/site';
---
<footer class="quote-author">
  <img src="/images/author-avatar.jpg" width="48" height="48" alt={`${SITE.person}, SEO specialista v Praze`} decoding="async" />
  <cite><a href={path('about', 'cs')}>{SITE.person}</a><span>{SITE.jobTitle.cs}</span></cite>
</footer>
