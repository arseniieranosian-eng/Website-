---
interface Props { h1: string; lead?: string; eyebrow?: string }
const { h1, lead, eyebrow } = Astro.props;
---
<section class="page-hero">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{h1}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
