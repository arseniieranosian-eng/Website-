---
interface Props { h1: string; lead?: string; eyebrow?: string }
const { h1, lead, eyebrow } = Astro.props;
const hasArt = Astro.slots.has('art');
---
<section class="page-hero">
  <div class:list={['container', { 'hero-art-split': hasArt }]}>
    {hasArt ? (
      <>
        <div>
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          <h1>{h1}</h1>
          {lead && <p class="lead">{lead}</p>}
          <slot />
        </div>
        <slot name="art" />
      </>
    ) : (
      <>
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{h1}</h1>
        {lead && <p class="lead">{lead}</p>}
        <slot />
      </>
    )}
  </div>
</section>
