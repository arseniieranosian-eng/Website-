---
import type { Review } from '../data/reviews';
import type { Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
interface Props { reviews: Review[]; lang: Lang; compact?: boolean; notes?: Record<string, string> } // notes: extra caption line by review id
const { reviews, lang, compact = false, notes = {} } = Astro.props;
---
<div class="grid grid-3">
  {reviews.map((r) => {
    const name = r.author ?? r.company ?? r.role[lang];
    const sub = r.author ? [r.role[lang], r.company].filter(Boolean).join(', ') : r.company ? r.role[lang] : '';
    return (
      <figure class="card review">
        {r.rating && <div class="stars" aria-label={`${r.rating}/5`}>{'★'.repeat(r.rating)}</div>}
        <blockquote>{(compact && r.short ? r.short[lang] : r.text[lang]).split('\n\n').map((p) => <p>{p}</p>)}</blockquote>
        <figcaption>
          {r.logo && <img class="review__logo" src={r.logo} width="40" height="40" alt="" loading="lazy" decoding="async" />}
          <strong>{name}</strong>
          {sub && <span>{sub}</span>}
          {notes[r.id] && <span>{notes[r.id]}</span>}
          {r.source && <span class="badge">{r.source}</span>}
          {r.sample && <span class="badge">{t(lang).sampleNote}</span>}
        </figcaption>
      </figure>
    );
  })}
</div>
