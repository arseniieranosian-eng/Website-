---
// The single lead form used on home, /audit-zdarma/, /kontakt/ and service pages.
// Posts JSON to PUBLIC_FORM_ENDPOINT, then redirects to the thank-you page,
// which fires the GA4 `generate_lead` event (see views/Thanks.astro).
import { path, type Lang } from '../i18n/routes';
import { TURNSTILE_SITEKEY } from '../data/anti-bot';

interface Props {
  lang: Lang;
  id: string; // form_id reported to GA4, e.g. "home-hero", "service-maps"
  service?: string; // preselected option value
  title?: string;
  compact?: boolean;
  websiteRequired?: boolean; // the site address is mandatory (e.g. the free audit is impossible without it)
  nicheForm?: boolean; // English free-audit page: with ?niche=translation-agencies the extra fields, the hidden source fields and the dedicated thank-you page are switched on (brief of 28.11.2026)
}
const { lang, id, service = 'audit', title, compact = false, websiteRequired = false, nicheForm = false } = Astro.props;
// Default: our own PHP handler (public/send.php) that e-mails the enquiry.
// PUBLIC_FORM_ENDPOINT can point to a third-party service instead.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || '/send.php';

const T = {
  cs: {
    name: 'Jméno', contact: 'E-mail nebo telefon', website: 'Adresa webu', service: 'Co vás zajímá', message: 'Zpráva',
    messagePh: 'Krátce popište váš web a cíle', websitePh: 'https://vasweb.cz',
    consentA: 'Souhlasím se ', consentLink: 'zpracováním osobních údajů', consentB: ' za účelem odpovědi na poptávku.',
    submit: 'Odeslat poptávku', submitAudit: 'Chci bezplatný audit', sending: 'Odesílám…',
    invalidContact: 'Zadejte platný e-mail nebo telefonní číslo.',
    error: 'Poptávku se nepodařilo odeslat. Zkuste to prosím znovu, nebo mi napište e-mail.',
    options: { audit: 'Bezplatný SEO audit', consulting: 'Konzultace', start: 'Start na 3 měsíce', fullSeo: 'Full SEO na rok', maps: 'Mapy (Google + Mapy.com)', other: 'Jiné' },
  },
  en: {
    name: 'Name', contact: 'E-mail or phone', website: 'Website address', service: 'I am interested in', message: 'Message',
    messagePh: 'Briefly describe your website and goals', websitePh: 'https://yoursite.com',
    consentA: 'I agree to the ', consentLink: 'processing of my personal data', consentB: ' for the purpose of replying to my enquiry.',
    submit: 'Send enquiry', submitAudit: 'Get my free audit', sending: 'Sending…',
    invalidContact: 'Please enter a valid e-mail address or phone number.',
    error: 'Your enquiry could not be sent. Please try again or e-mail me directly.',
    options: { audit: 'Free SEO audit', consulting: 'Consulting', start: '3-month start', fullSeo: 'Full SEO (1 year)', maps: 'Maps (Google + Mapy.com)', other: 'Other' },
  },
  ru: {
    name: 'Имя', contact: 'E-mail или телефон', website: 'Адрес сайта', service: 'Что вас интересует', message: 'Сообщение',
    messagePh: 'Коротко опишите сайт и цели', websitePh: 'https://vashsajt.cz',
    consentA: 'Я согласен(на) на ', consentLink: 'обработку персональных данных', consentB: ' для ответа на заявку.',
    submit: 'Отправить заявку', submitAudit: 'Получить бесплатный аудит', sending: 'Отправляю…',
    invalidContact: 'Укажите корректный e-mail или номер телефона.',
    error: 'Не удалось отправить заявку. Попробуйте ещё раз или напишите мне на e-mail.',
    options: { audit: 'Бесплатный SEO-аудит', consulting: 'Консультация', start: 'Старт на 3 месяца', fullSeo: 'Full SEO на год', maps: 'Карты (Google + Mapy.com)', other: 'Другое' },
  },
  uk: {
    name: 'Ім’я', contact: 'E-mail або телефон', website: 'Адреса сайту', service: 'Що вас цікавить', message: 'Повідомлення',
    messagePh: 'Коротко опишіть сайт і цілі', websitePh: 'https://vashsait.cz',
    consentA: 'Я погоджуюся на ', consentLink: 'обробку персональних даних', consentB: ' для відповіді на заявку.',
    submit: 'Надіслати заявку', submitAudit: 'Отримати безкоштовний аудит', sending: 'Надсилаю…',
    invalidContact: 'Вкажіть коректний e-mail або номер телефону.',
    error: 'Не вдалося надіслати заявку. Спробуйте ще раз або напишіть мені на e-mail.',
    options: { audit: 'Безкоштовний SEO-аудит', consulting: 'Консультація', start: 'Старт на 3 місяці', fullSeo: 'Full SEO на рік', maps: 'Карти (Google + Mapy.com)', other: 'Інше' },
  },
}[lang];

const uid = `lf-${id}`;
---
<form
  class:list={['lead-form', { 'lead-form--compact': compact }]}
  action={endpoint}
  method="post"
  data-lead-form
  data-endpoint={endpoint}
  data-thanks={path('thanks', lang)}
  data-niche-form={nicheForm ? '' : undefined}
  data-thanks-niche={nicheForm ? path('thanksAudit', lang) : undefined}
  data-msg-contact={T.invalidContact}
  data-msg-sending={T.sending}
  data-turnstile={TURNSTILE_SITEKEY || undefined}
  novalidate
>
  {title && <p class="form-title">{title}</p>}
  <input type="hidden" name="form_id" value={id} />
  <input type="hidden" name="lang" value={lang} />
  <input type="hidden" name="page" value={Astro.url.pathname} />
  <input type="hidden" name="started" value="" data-started />
  <!-- Anti-spam honeypot: invisible, unlabeled, unfocusable and hidden from assistive technology. -->
  <div class="hp" aria-hidden="true" inert>
    <input type="text" name="company" tabindex="-1" autocomplete="off" />
  </div>

  <div class="field-row">
    <div class="field">
      <label for={`${uid}-name`}>{T.name} *</label>
      <input id={`${uid}-name`} name="name" type="text" autocomplete="name" required maxlength="120" />
    </div>
    <div class="field">
      <label for={`${uid}-contact`}>{T.contact} *</label>
      <input id={`${uid}-contact`} name="contact" type="text" inputmode="email" autocomplete="email" required maxlength="160" data-contact />
    </div>
  </div>
  <div class="field-row">
    <div class="field">
      <label for={`${uid}-website`}>{T.website}{websiteRequired ? ' *' : ''}</label>
      <input id={`${uid}-website`} name="website" type="text" inputmode="url" autocomplete="url" placeholder={T.websitePh} maxlength="200" required={websiteRequired} />
    </div>
    <div class="field">
      <label for={`${uid}-service`}>{T.service}</label>
      <select id={`${uid}-service`} name="service">
        {Object.entries(T.options).map(([v, label]) => <option value={v} selected={v === service}>{label}</option>)}
      </select>
    </div>
  </div>
  {nicheForm && (
    <div data-niche-fields hidden>
      <div class="field-row">
        <fieldset class="field" disabled>
          <legend>Which languages does your website have?</legend>
          <label><input type="checkbox" name="site_languages" value="Czech" /> Czech</label>{' '}
          <label><input type="checkbox" name="site_languages" value="English" /> English</label>{' '}
          <label><input type="checkbox" name="site_languages" value="Other" /> Other</label>
        </fieldset>
        <div class="field">
          <label for={`${uid}-offices`}>Where are your offices?</label>
          <select id={`${uid}-offices`} name="offices" disabled>
            <option value="">—</option>
            <option value="Prague only">Prague only</option>
            <option value="Prague and other cities">Prague and other cities</option>
            <option value="Outside Prague">Outside Prague</option>
          </select>
        </div>
      </div>
      {['source_page', 'niche', 'site_lang', 'utm_source', 'utm_medium', 'utm_campaign', 'referrer', 'submitted_at'].map((n) => <input type="hidden" name={n} value={n === 'site_lang' ? lang : ''} disabled />)}
    </div>
  )}
  {!compact && (
    <div class="field">
      <label for={`${uid}-message`}>{T.message}</label>
      <textarea id={`${uid}-message`} name="message" rows="4" maxlength="3000" placeholder={T.messagePh}></textarea>
    </div>
  )}
  <div class="consent">
    <input id={`${uid}-consent`} name="consent" type="checkbox" value="yes" required />
    <label for={`${uid}-consent`}>{T.consentA}<a href={path('privacy', lang)} target="_blank">{T.consentLink}</a>{T.consentB} *</label>
  </div>
  {TURNSTILE_SITEKEY && <div class="cf-turnstile" data-sitekey={TURNSTILE_SITEKEY} data-theme="light" data-language={lang === 'uk' ? 'uk' : lang === 'cs' ? 'cs' : lang === 'ru' ? 'ru' : 'en'} data-appearance="interaction-only"></div>}
  <button class="btn btn--primary btn--lg" type="submit">{service === 'audit' ? T.submitAudit : T.submit}</button>
  <p class="form-error" role="alert" hidden>{T.error}</p>
</form>

<script>
  import { track } from '../lib/track';
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const PHONE = /^\+?[\d\s().-]{9,20}$/;
  const MIN_FILL_MS = 3000;

  document.querySelectorAll<HTMLFormElement>('form[data-lead-form]').forEach((form) => {
    const started = form.querySelector<HTMLInputElement>('[data-started]')!;
    started.value = String(Date.now());
    const contact = form.querySelector<HTMLInputElement>('[data-contact]')!;
    const error = form.querySelector<HTMLElement>('.form-error')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const label = button.textContent;

    contact.addEventListener('input', () => contact.setCustomValidity(''));

    // Funnel of the English free-audit page (brief of 28.11.2026): only with ?niche=translation-agencies the extra fields, the hidden source fields and the dedicated thank-you page are switched on;
    // without the parameter the form is the ordinary one. Events (form_view / form_start / form_submit) go out only with the analytics consent (lib/track.ts).
    const niche = form.hasAttribute('data-niche-form') ? new URLSearchParams(location.search).get('niche') : null;
    const nicheOn = niche === 'translation-agencies';
    if (nicheOn) {
      const box = form.querySelector<HTMLElement>('[data-niche-fields]')!;
      box.hidden = false;
      box.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLFieldSetElement>('input, select, fieldset').forEach((x) => { x.disabled = false; });
      const q = new URLSearchParams(location.search);
      const set = (n: string, v: string) => { const el = form.querySelector<HTMLInputElement>(`[name="${n}"]`); if (el) el.value = v; };
      let sameOrigin = false;
      try { sameOrigin = !!document.referrer && new URL(document.referrer).origin === location.origin; } catch {}
      set('niche', niche!);
      set('source_page', sameOrigin ? document.referrer : location.href);
      set('referrer', document.referrer);
      for (const k of ['utm_source', 'utm_medium', 'utm_campaign']) set(k, q.get(k) ?? '');
      document.querySelector<HTMLElement>('[data-niche-context]')?.removeAttribute('hidden');
      form.dataset.thanks = `${form.dataset.thanksNiche}?niche=${niche}`;
      let seen = false;
      new IntersectionObserver((es, ob) => { if (!seen && es.some((x) => x.isIntersecting)) { seen = true; ob.disconnect(); track('form_view', { form_id: form.querySelector<HTMLInputElement>('[name=form_id]')!.value, niche: niche! }); } }).observe(form);
      form.addEventListener('focusin', () => track('form_start', { niche: niche! }), { once: true });
    }

    // Cloudflare Turnstile: the script is loaded once, on the first interaction with any form (nothing is requested from Cloudflare before that).
    if (form.dataset.turnstile) {
      const load = () => {
        if (document.querySelector('script[data-turnstile-api]')) return;
        const s = document.createElement('script');
        s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
        s.async = true; s.defer = true; s.dataset.turnstileApi = '';
        document.head.appendChild(s);
      };
      form.addEventListener('focusin', load, { once: true });
      form.addEventListener('pointerdown', load, { once: true });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.hidden = true;
      const v = contact.value.trim();
      contact.setCustomValidity(EMAIL.test(v) || PHONE.test(v) ? '' : form.dataset.msgContact!);
      if (!form.reportValidity()) return;

      // With Turnstile on, wait (up to 8 s) for the token the widget puts into the form.
      if (form.dataset.turnstile) {
        for (let i = 0; i < 40 && !(form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]')?.value); i++) await new Promise((r) => setTimeout(r, 200));
      }
      if (nicheOn) {
        const prague = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Prague', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' }).format(new Date());
        const el = form.querySelector<HTMLInputElement>('[name="submitted_at"]'); if (el) el.value = `${prague} (Europe/Prague)`;
      }
      const fd = new FormData(form);
      const data = Object.fromEntries(fd) as Record<string, string>;
      if (nicheOn) data.site_languages = fd.getAll('site_languages').join(', ');
      const goThanks = () => (window.location.href = form.dataset.thanks!);

      // Spam: honeypot filled or submitted inhumanly fast → pretend success, send nothing.
      if (data.company || Date.now() - Number(data.started) < MIN_FILL_MS) return goThanks();
      delete data.company;

      button.disabled = true;
      button.textContent = form.dataset.msgSending!;
      try {
        if (!form.dataset.endpoint) throw new Error('Form endpoint not configured');
        const res = await fetch(form.dataset.endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) {
          (window as unknown as { turnstile?: { reset: () => void } }).turnstile?.reset();
          throw new Error(`HTTP ${res.status}`);
        }
        try {
          sessionStorage.setItem('lead', JSON.stringify({ form_id: data.form_id, service: data.service, lang: data.lang, ...(nicheOn ? { niche: niche! } : {}) }));
          if (nicheOn) track('form_submit', { form_id: data.form_id, niche: niche! });
        } catch {}
        goThanks();
      } catch (err) {
        console.error(err);
        error.hidden = false;
        button.disabled = false;
        button.textContent = label;
      }
    });
  });
</script>
