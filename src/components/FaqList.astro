---
import type { FaqItem } from '../data/faq';
import type { Lang } from '../i18n/routes';
interface Props { items: FaqItem[]; lang: Lang }
const { items, lang } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details>
      <summary>{f.q[lang]}</summary>
      <p>{f.a[lang]}</p>
    </details>
  ))}
</div>
