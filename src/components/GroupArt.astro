---
// Illustration for a group of the "What is included" block of the Full SEO pages (same palette and 96x56 card as ServiceArt).
// The group heading carries the meaning, so the drawing is hidden from assistive technology. kind: site, offsite, ai; longtail, content, english (the three directions of the real estate review pages); plan (12-month plan in three stages), other (what applies to another small agency).
interface Props { kind: string }
const { kind } = Astro.props;
---
<svg class="group-art" viewBox="0 0 96 56" width="96" height="56" fill="none" aria-hidden="true" focusable="false">
  <rect x="0.5" y="0.5" width="95" height="55" rx="10" fill="#f4f6fa" stroke="#e3e7ef" />
  {kind === 'site' && (<>
    <rect x="12" y="10" width="52" height="38" rx="5" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" /><path d="M12 19h52" stroke="#1f4fd8" stroke-width="1.8" /><circle cx="18" cy="14.500" r="1.600" fill="#ff6a1a" /><circle cx="23.500" cy="14.500" r="1.600" fill="#a4baf0" />
    <rect x="18" y="25" width="20" height="17" rx="3" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.4" /><path d="M43 26h15M43 32h15M43 38h9" stroke="#a4baf0" stroke-width="2.400" stroke-linecap="round" />
    <circle cx="72" cy="34" r="9" fill="#ff6a1a" /><circle cx="72" cy="34" r="3.200" fill="#fff" /><path d="M72 22v4M72 42v4M60 34h4M80 34h4" stroke="#ff6a1a" stroke-width="3" stroke-linecap="round" />
  </>)}
  {kind === 'offsite' && (<>
    <rect x="9" y="12" width="26" height="32" rx="4" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" /><path d="M15 21h14M15 28h14M15 35h8" stroke="#a4baf0" stroke-width="2.200" stroke-linecap="round" />
    <rect x="61" y="12" width="26" height="32" rx="4" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" /><path d="M67 21h14M67 28h14M67 35h8" stroke="#1f4fd8" stroke-opacity=".5" stroke-width="2.200" stroke-linecap="round" />
    <path d="M42 28h-3a5 5 0 010-10h6M54 28h3a5 5 0 000 10h-6" stroke="#ff6a1a" stroke-width="3" stroke-linecap="round" /><path d="M43 28h10" stroke="#ff6a1a" stroke-width="3" stroke-linecap="round" />
  </>)}
  {kind === 'ai' && (<>
    <rect x="9" y="9" width="44" height="28" rx="9" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" /><path d="M20 37v9l10-9" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" stroke-linejoin="round" />
    <path d="M31 15l2.600 6.400L40 24l-6.400 2.600L31 33l-2.600-6.400L22 24l6.400-2.600z" fill="#ff6a1a" />
    <path d="M62 46V34M72 46V26M82 46V16" stroke="#1f4fd8" stroke-width="7" stroke-linecap="round" /><path d="M60 28l11-8 12-8" stroke="#ff6a1a" stroke-width="2.400" stroke-linecap="round" stroke-linejoin="round" />
  </>)}
  {kind === 'longtail' && (<>
    <rect x="9" y="9" width="78" height="16" rx="8" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" /><circle cx="20" cy="17" r="3.600" stroke="#1f4fd8" stroke-width="1.6" /><path d="M23 20l3 3" stroke="#1f4fd8" stroke-width="1.8" stroke-linecap="round" /><path d="M32 17h30" stroke="#a4baf0" stroke-width="2.600" stroke-linecap="round" /><path d="M66 17h14" stroke="#ff6a1a" stroke-width="2.600" stroke-linecap="round" />
    <path d="M13 32h70l-24 9v8l-10 4v-12z" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" stroke-linejoin="round" />
  </>)}
  {kind === 'content' && (<>
    <rect x="10" y="8" width="40" height="40" rx="5" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" /><path d="M17 18h26M17 26h26M17 34h14" stroke="#a4baf0" stroke-width="2.200" stroke-linecap="round" />
    <rect x="46" y="14" width="40" height="22" rx="8" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" /><path d="M58 36v7l8-7" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" stroke-linejoin="round" /><path d="M63 21c-3 0-5 2.500-3.500 5 1 1.600 3.500 1.600 3.500 4" stroke="#1f4fd8" stroke-width="2.200" stroke-linecap="round" /><circle cx="63" cy="32.500" r="1.500" fill="#1f4fd8" />
    <circle cx="80" cy="45" r="7" fill="#ff6a1a" /><path d="M76.500 45l2.500 2.500 4.500-5" stroke="#fff" stroke-width="2.200" stroke-linecap="round" stroke-linejoin="round" />
  </>)}
  {kind === 'english' && (<>
    <circle cx="34" cy="28" r="18" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" /><ellipse cx="34" cy="28" rx="7" ry="18" stroke="#1f4fd8" stroke-width="1.6" /><path d="M16 28h36M19 18h30M19 38h30" stroke="#1f4fd8" stroke-width="1.6" stroke-linecap="round" />
    <rect x="56" y="14" width="30" height="20" rx="7" fill="#ff6a1a" /><path d="M64 34v6l7-6" fill="#ff6a1a" stroke="#ff6a1a" stroke-width="1.600" stroke-linejoin="round" /><text x="71" y="29" text-anchor="middle" font-family="Inter, Arial, sans-serif" font-size="12" font-weight="700" fill="#fff">EN</text>
  </>)}
  {kind === 'plan' && (<>
    <path d="M12 38h72" stroke="#1f4fd8" stroke-opacity=".35" stroke-width="3" stroke-linecap="round" />
    <circle cx="20" cy="38" r="7" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" /><path d="M16.500 38l2.700 2.700 4.800-5.400" stroke="#1f4fd8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="48" cy="38" r="7" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" /><path d="M45 41.500l3-7 3 7z" fill="#1f4fd8" />
    <circle cx="76" cy="38" r="7" fill="#ff6a1a" /><path d="M72.500 40l2.500-3 2 2 2.500-3.500" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <rect x="30" y="9" width="36" height="16" rx="5" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" /><path d="M30 15h36" stroke="#1f4fd8" stroke-width="1.8" /><path d="M37 20h4M45 20h4M53 20h4" stroke="#a4baf0" stroke-width="2.400" stroke-linecap="round" />
  </>)}
  {kind === 'other' && (<>
    <path d="M10 32L26 18l16 14v16H10z" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" stroke-linejoin="round" /><rect x="21" y="36" width="10" height="12" rx="2" fill="#fff" stroke="#1f4fd8" stroke-width="1.6" />
    <path d="M46 28h12" stroke="#ff6a1a" stroke-width="2.800" stroke-linecap="round" /><path d="M54 22l6 6-6 6" stroke="#ff6a1a" stroke-width="2.800" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M62 32L76 20l14 12v16H62z" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" stroke-linejoin="round" /><rect x="71" y="36" width="10" height="12" rx="2" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.6" /><path d="M73 28l3 3 5-6" stroke="#ff6a1a" stroke-width="0" />
  </>)}
</svg>
