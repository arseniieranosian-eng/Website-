---
import { META } from '../i18n/meta';
import { LANGS, NICHE_GROUPS, SERVICE_MENU, langsFor, path, type Lang, type PageKey } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  pageKey?: PageKey;
  alternates: Partial<Record<Lang, string>>;
  langFallback: Record<Lang, string>;
}
const { lang, pageKey, alternates, langFallback } = Astro.props;
const ui = t(lang);
// "Services" is a dropdown of the service pages (there is no services collection page); the rest are plain links.
// The blog is in the menu of the Czech version only (the first posts are coming); en / ru follow when they have posts.
const NAV: PageKey[] = ['cases', 'geo', 'about', 'reviews', 'faq', 'contact', ...(lang === 'cs' ? (['blog'] as PageKey[]) : [])];
const label = (k: PageKey) => (k === 'geo' ? ui.navGeo : META[k][lang].name);
const current = (k: PageKey) => pageKey === k || (k === 'cases' && pageKey === 'caseKb');
// Niche menu ("SEO pro" in Czech, "SEO для" in Russian): only the groups and pages that exist in the current language.
const nicheGroups = (lang === 'cs' || lang === 'ru' ? NICHE_GROUPS : [])
  .map((g: any) => ({ id: g.id as string, label: (lang === 'ru' ? g.labelRu ?? g.label : g.label) as string, items: g.items.filter((i: any) => langsFor(i.page).includes(lang)).map((i: any) => ({ page: i.page as PageKey, label: (lang === 'ru' ? i.labelRu ?? i.label : i.label) as string })) }))
  .filter((g) => g.items.length > 0);
const showNiches = nicheGroups.length > 0;
const nichesLabel = lang === 'ru' ? 'SEO для' : 'SEO pro';
const inNiches = nicheGroups.some((g) => g.items.some((i) => i.page === pageKey));
const inServices = (SERVICE_MENU as readonly PageKey[]).includes(pageKey as PageKey);
---
<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href={path('home', lang)} aria-label="Arsenii Eranosian – SEO">
      <img class="logo-img" src="/images/logo-mark.png" width="65" height="40" alt="" decoding="async" /><span class="logo-text">Arsenii Eranosian<small>SEO · GEO/AEO</small></span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">{ui.menu}</span><span class="burger" aria-hidden="true"></span>
    </button>
    <div class="nav-wrap" id="site-nav">
      <nav aria-label={ui.menu}>
        <ul class="nav">
          <li class="nav-dd">
            <button class={inServices ? 'nav-dd__btn is-current' : 'nav-dd__btn'} type="button" aria-expanded="false" aria-controls="nav-services">
              {ui.services}<span class="nav-dd__chev" aria-hidden="true"></span>
            </button>
            <ul class="nav-sub" id="nav-services">
              {SERVICE_MENU.map((k) => (
                <li><a href={path(k, lang)} aria-current={pageKey === k ? 'page' : undefined}>{META[k][lang].name}</a></li>
              ))}
            </ul>
          </li>
          {showNiches && (
            <li class="nav-dd">
              <button class={inNiches ? 'nav-dd__btn is-current' : 'nav-dd__btn'} type="button" aria-expanded="false" aria-controls="nav-niches">
                {nichesLabel}<span class="nav-dd__chev" aria-hidden="true"></span>
              </button>
              <ul class="nav-sub" id="nav-niches">
                {nicheGroups.map((g) => (
                  <li class="nav-group">
                    <button class={g.items.some((i) => i.page === pageKey) ? 'nav-group__btn is-current' : 'nav-group__btn'} type="button" aria-expanded="false" aria-controls={`nav-group-${g.id}`}>
                      {g.label}<span class="nav-dd__chev" aria-hidden="true"></span>
                    </button>
                    <ul class="nav-sub2" id={`nav-group-${g.id}`}>
                      {g.items.map((i) => (
                        <li><a href={path(i.page, lang)} aria-current={pageKey === i.page ? 'page' : undefined}>{i.label}</a></li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ul>
            </li>
          )}
          {NAV.map((k) => (
            <li><a href={path(k, lang)} aria-current={current(k) ? 'page' : undefined}>{label(k)}</a></li>
          ))}
        </ul>
      </nav>
      <ul class="lang-switch" aria-label={ui.langSwitch}>
        {LANGS.map((l) => (
          <li>
            <a href={alternates[l] ?? langFallback[l]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} title={t(l).langName}>{l.toUpperCase()}</a>
          </li>
        ))}
      </ul>
      <a class="btn btn--primary btn--sm" href={path('audit', lang)}>{ui.ctaAudit}</a>
    </div>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.nav-toggle');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('nav-open', open);
  });

  // Dropdowns ("Services", "SEO pro"): open on hover (CSS), on click/tap and from the keyboard; close on Esc, outside click or focus leaving.
  document.querySelectorAll<HTMLElement>('.nav-dd').forEach((dd) => {
    const ddBtn = dd.querySelector<HTMLButtonElement>('.nav-dd__btn');
    const setOpen = (open: boolean) => ddBtn?.setAttribute('aria-expanded', String(open));
    ddBtn?.addEventListener('click', () => setOpen(ddBtn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('click', (e) => { if (!dd.contains(e.target as Node)) setOpen(false); });
    dd.querySelectorAll<HTMLButtonElement>('.nav-group__btn').forEach((gb) => gb.addEventListener('click', () => gb.setAttribute('aria-expanded', String(gb.getAttribute('aria-expanded') !== 'true'))));
    dd.addEventListener('keydown', (e) => { if (e.key === 'Escape') { setOpen(false); ddBtn?.focus(); } });
    dd.addEventListener('focusout', (e) => { if (!dd.contains((e as FocusEvent).relatedTarget as Node)) setOpen(false); });
  });
</script>
