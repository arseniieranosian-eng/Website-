---
import { caseByKey, type CaseStudy } from '../data/cases';
import { META } from '../i18n/meta';
import { path, type Lang } from '../i18n/routes';
import CaseArt from './CaseArt.astro';
import { t } from '../i18n/ui';
interface Props { lang: Lang; caseKey?: CaseStudy['key']; heading?: 'h2' | 'h3'; large?: boolean }
const { lang, caseKey = 'caseKb', heading = 'h3', large = false } = Astro.props;
const c = caseByKey(caseKey);
const H = heading;
const ART: Record<string, string> = { caseKb: 'kb', caseHalf: 'half', caseTypo: 'typo', caseEdu: 'edu', caseSeason: 'season', caseRazbor: 'razbor' };
// Large mode (the cases page, Czech): a bigger illustration in its own column; the first case has a picture with the three branches (an illustration, not a photo of the client).
const PHOTO: Record<string, Record<string, { src: string; alt: string; width?: number; height?: number }>> = {
  cs: {
    caseKb: { src: '/images/cases/kb-3-pobocky.webp', alt: 'Ilustrace: mapa České republiky se třemi pobočkami agentury, Praha, Pardubice a Brno' },
    caseTypo: { src: '/images/cases/typo-vzrostla-cs.webp', alt: 'Ilustrace: návštěvnost webu tiskárny vzrostla 8,75krát' },
    caseSeason: { src: '/images/cases/season-24-cs.webp', alt: 'Ilustrace: v nízké sezóně 24krát více poptávek z webu', width: 1024, height: 683 },
    caseHalf: { src: '/images/cases/half-pul-roku-cs.webp', alt: 'Ilustrace: překladatelská agentura, půl roku od nuly po růst poptávek', width: 1024, height: 683 },
    caseRazbor: { src: '/images/cases/razbor-realitni-cs.webp', alt: 'Ilustrace: rozbor webu realitní agentury v Praze', width: 1024, height: 683 },
  },
  // Russian cases page (author's pictures of 02.11.2026). The print-shop picture shows the ratio 8,75× with rounded example numbers (1 000 → 8 750 visits).
  ru: {
    caseKb: { src: '/images/cases/kb-3-filiala-ru.webp', alt: 'Иллюстрация: карта Чехии с тремя филиалами агентства: Прага, Пардубице и Брно' },
    caseTypo: { src: '/images/cases/typo-vyrosla-ru.webp', alt: 'Иллюстрация: посещаемость типографии выросла в 8,75 раза' },
    caseHalf: { src: '/images/cases/half-polgoda-ru.webp', alt: 'Иллюстрация: полгода от нуля до роста заявок: +65–70 % три месяца подряд, B2B-заявки ×3, появление в Google AI Overview', width: 1024, height: 683 },
    caseSeason: { src: '/images/cases/season-24-ru.webp', alt: 'Иллюстрация: заявки с сайта переводческого агентства выросли в 24 раза, весна → лето 2026, клики и показы из Google Search Console', width: 1024, height: 683 },
    caseRazbor: { src: '/images/cases/razbor-nedvizhimost-ru.webp', alt: 'Иллюстрация: разбор сайта агентства недвижимости в Праге: что я увидел и что предложил', width: 1024, height: 683 },
    caseEdu: { src: '/images/cases/edu-plus55-ru.webp', alt: 'Иллюстрация: органический трафик образовательной платформы вырос на 55 % с марта по сентябрь', width: 1024, height: 683 },
  },
};
const photo = large ? PHOTO[lang]?.[c.key] : undefined;
// Compact card (reviews, about, audit and service pages): the first case shows the new three-branches picture instead of the old small drawing (cs and ru; the en pages keep the drawing, the picture has no English text).
const thumb = !large && c.key === 'caseKb' ? PHOTO[lang]?.[c.key] : undefined;
---
<a class:list={['card card--link case-teaser', large && 'case-teaser--large']} href={path(c.key, lang)}>
  {large && (
    <div class="case-teaser__media">
      {photo ? <img src={photo.src} width={photo.width ?? 768} height={photo.height ?? 840} alt={photo.alt} loading="lazy" decoding="async" /> : <CaseArt kind={ART[c.key]} />}
    </div>
  )}
  <div>
    {!large && (thumb ? <img class="case-teaser__thumb" src={thumb.src} width="768" height="840" alt={thumb.alt} loading="lazy" decoding="async" /> : <CaseArt kind={ART[c.key]} />)}
    <p class="eyebrow">{t(lang).relatedCase} · {c.industry[lang]}</p>
    <H>{META[c.key][lang].h1}</H>
    <p>{c.teaser[lang]}</p>
    <span class="link-arrow">{t(lang).caseRead}</span>
  </div>
  {c.metrics.length > 0 && <dl class="stats stats--compact">
    {c.metrics.map((m) => <div><dt>{m.label[lang]}</dt><dd>{typeof m.value === 'string' ? m.value : m.value[lang]}</dd></div>)}
  </dl>}
</a>
