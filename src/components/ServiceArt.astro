---
// Small decorative illustration for a service in the service lists and tables of the niche landing pages (same style and palette as NicheArt / DoArt).
// The name next to it carries the meaning, so the drawing is hidden from assistive technology. kind: audit, consulting, start, fullSeo, maps.
interface Props { kind: string; size?: number }
const { kind, size = 72 } = Astro.props;
---
<svg class="svc-art" viewBox="0 0 96 56" width={size} height={Math.round((size * 56) / 96)} fill="none" aria-hidden="true" focusable="false">
  <rect x="0.5" y="0.5" width="95" height="55" rx="10" fill="#f4f6fa" stroke="#e3e7ef" />
  {kind === 'audit' && (<>
    <rect x="16" y="9" width="34" height="38" rx="5" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" /><path d="M23 19h20M23 26h20M23 33h11" stroke="#a4baf0" stroke-width="2" stroke-linecap="round" />
    <circle cx="62" cy="31" r="12" fill="#c9d6f7" fill-opacity="0.7" stroke="#1f4fd8" stroke-width="2.4" /><path d="M71 40l8 8" stroke="#1f4fd8" stroke-width="3.2" stroke-linecap="round" />
    <path d="M57 31l4 4 7-8" stroke="#ff6a1a" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
  </>)}
  {kind === 'consulting' && (<>
    <rect x="12" y="10" width="42" height="22" rx="8" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" /><path d="M22 32v8l9-8" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" stroke-linejoin="round" /><path d="M21 19h24M21 25h14" stroke="#1f4fd8" stroke-width="2.2" stroke-linecap="round" />
    <rect x="44" y="24" width="40" height="20" rx="8" fill="#ff6a1a" /><path d="M72 44v7l-8-7" fill="#ff6a1a" stroke="#ff6a1a" stroke-width="1.6" stroke-linejoin="round" /><path d="M52 31h24M52 37h12" stroke="#fff" stroke-width="2.2" stroke-linecap="round" />
  </>)}
  {kind === 'start' && (<>
    <rect x="12" y="34" width="16" height="12" rx="2" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.6" /><rect x="30" y="26" width="16" height="20" rx="2" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.6" /><rect x="48" y="18" width="16" height="28" rx="2" fill="#1f4fd8" />
    <path d="M72 46V10" stroke="#1f4fd8" stroke-width="2.2" stroke-linecap="round" /><path d="M72 11h14l-4 5 4 5H72z" fill="#ff6a1a" />
  </>)}
  {kind === 'fullSeo' && (<>
    <path d="M24 28a20 20 0 0 1 34-14" stroke="#1f4fd8" stroke-width="2.6" stroke-linecap="round" /><path d="M58 8v8h-8" stroke="#1f4fd8" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M72 28a20 20 0 0 1-34 14" stroke="#1f4fd8" stroke-width="2.6" stroke-linecap="round" /><path d="M38 48v-8h8" stroke="#1f4fd8" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M32 33l7-8 6 5 9-11" stroke="#ff6a1a" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" /><circle cx="54" cy="19" r="2.6" fill="#ff6a1a" />
  </>)}
  {kind === 'maps' && (<>
    <path d="M10 14l22-4 22 6 22-6 10 4v32l-10-4-22 6-22-6-22 4z" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.6" stroke-linejoin="round" />
    <path d="M32 10v36M54 16v36M76 10v32" stroke="#1f4fd8" stroke-opacity="0.35" stroke-width="1.4" />
    <path d="M48 12c-6 0-10 4.200-10 9.200 0 6.400 10 16 10 16s10-9.600 10-16C58 16.200 54 12 48 12z" fill="#ff6a1a" /><circle cx="48" cy="21" r="3.500" fill="#fff" />
  </>)}
  {kind === 'geo' && (<>
    <circle cx="32" cy="26" r="14" fill="#c9d6f7" fill-opacity=".7" stroke="#1f4fd8" stroke-width="2.200" /><path d="M42 36l10 10" stroke="#1f4fd8" stroke-width="4" stroke-linecap="round" /><path d="M26 26h12M32 20v12" stroke="#1f4fd8" stroke-opacity=".5" stroke-width="1.800" stroke-linecap="round" />
    <rect x="54" y="8" width="32" height="22" rx="8" fill="#fff" stroke="#1f4fd8" stroke-width="1.800" /><path d="M76 30v6l-8-6" fill="#fff" stroke="#1f4fd8" stroke-width="1.800" stroke-linejoin="round" /><path d="M62 16h16M62 22h10" stroke="#a4baf0" stroke-width="2.200" stroke-linecap="round" />
    <path d="M78 36l2.200 5.800L86 44l-5.800 2.200L78 52l-2.200-5.800L70 44l5.800-2.200z" fill="#ff6a1a" />
  </>)}
  {kind === 'questions' && (<>
    <rect x="12" y="10" width="40" height="26" rx="9" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" /><path d="M22 36v8l9-8" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" stroke-linejoin="round" /><path d="M32 17c-4 0-6 3-4 6 1 2 4 2 4 5" stroke="#1f4fd8" stroke-width="2.4" stroke-linecap="round" /><circle cx="32" cy="32" r="1.6" fill="#1f4fd8" />
    <rect x="52" y="22" width="32" height="22" rx="8" fill="#ff6a1a" /><path d="M58 31l5 5 9-10" stroke="#fff" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
  </>)}
  {kind === 'plan' && (<>
    <rect x="10" y="9" width="40" height="38" rx="5" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" /><path d="M17 19h26M17 27h26M17 35h14" stroke="#a4baf0" stroke-width="2" stroke-linecap="round" />
    <path d="M56 42V30M66 42V22M76 42V14" stroke="#1f4fd8" stroke-width="6" stroke-linecap="round" /><path d="M54 24l11-7 11-7" stroke="#ff6a1a" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /><path d="M83 8l-9-1 3 8z" fill="#ff6a1a" />
  </>)}
</svg>
