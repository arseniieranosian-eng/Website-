---
// Decorative illustration for the "at least two illustrations on every page" rule (author's rule of 01.11.2026). Rendered by the base layout from the map in lib/page-art.ts;
// the page text carries the meaning, so the drawings are hidden from assistive technology. Same palette as NicheArt / CaseArt / ServiceArt.
// kind: niche:<id> (NicheArt), case:<id> (CaseArt) or one of the drawings below.
import NicheArt from './NicheArt.astro';
import CaseArt from './CaseArt.astro';
interface Props { kind: string; lang?: string }
const { kind, lang } = Astro.props;
const [group, id] = kind.includes(':') ? kind.split(':') : ['own', kind];
// ru / uk: the author's photo of the free audit (05.11.2026) replaces the drawing.
const photo = (lang === 'ru' || lang === 'uk') && group === 'own' && id === 'audit';
---
<div class="page-art" aria-hidden="true">
  {group === 'niche' && <NicheArt kind={id} />}
  {group === 'case' && <CaseArt kind={id} />}
  {photo && <img class="page-art-photo" src="/images/services/audit-free-ru.webp" width="768" height="512" alt="" loading="lazy" decoding="async" />}
  {group === 'own' && !photo && (
    <svg viewBox="0 0 96 56" width="96" height="56" fill="none" focusable="false">
      <rect x="0.5" y="0.5" width="95" height="55" rx="10" fill="#f4f6fa" stroke="#e3e7ef" />
      {id === 'audit' && (<>
        <rect x="12" y="10" width="34" height="38" rx="5" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" /><path d="M18 20l3 3 5-6M18 32l3 3 5-6" stroke="#ff6a1a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /><path d="M31 21h9M31 33h9" stroke="#a4baf0" stroke-width="2.2" stroke-linecap="round" />
        <circle cx="68" cy="26" r="12" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="2.2" /><path d="M77 35l8 8" stroke="#1f4fd8" stroke-width="3.4" stroke-linecap="round" /><path d="M62 27l4 4 7-8" stroke="#1f4fd8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
      </>)}
      {id === 'faq' && (<>
        <rect x="10" y="10" width="46" height="26" rx="8" fill="#1f4fd8" /><path d="M20 36v7l8-7" fill="#1f4fd8" stroke="#1f4fd8" stroke-width="1.6" stroke-linejoin="round" /><g fill="#fff" font-family="Inter, Arial, sans-serif" font-size="18" font-weight="700" text-anchor="middle"><text x="33" y="30">?</text></g>
        <rect x="46" y="26" width="38" height="20" rx="7" fill="#ff6a1a" /><path d="M72 46v6l-7-6" fill="#ff6a1a" stroke="#ff6a1a" stroke-width="1.6" stroke-linejoin="round" /><path d="M54 33h22M54 39h14" stroke="#fff" stroke-width="2.2" stroke-linecap="round" />
      </>)}
      {id === 'contact' && (<>
        <rect x="12" y="14" width="46" height="30" rx="5" fill="#fff" stroke="#1f4fd8" stroke-width="2" /><path d="M14 17l21 16 21-16" stroke="#1f4fd8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="70" cy="22" r="10" fill="#ff6a1a" /><path d="M66 22h8M71 18l4 4-4 4" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /><rect x="64" y="36" width="22" height="10" rx="5" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.6" />
      </>)}
      {id === 'thanks' && (<>
        <circle cx="30" cy="28" r="16" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="2.2" /><path d="M22 28l6 6 11-12" stroke="#1f4fd8" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M82 10 52 22l12 6 4 12 6-9z" fill="#ff6a1a" stroke="#ff6a1a" stroke-width="2" stroke-linejoin="round" /><path d="M64 28l18-18" stroke="#fff" stroke-width="1.8" stroke-linecap="round" />
      </>)}
      {id === 'privacy' && (<>
        <path d="M30 8 12 15v12c0 11 7 18 18 22 11-4 18-11 18-22V15z" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="2.2" stroke-linejoin="round" /><rect x="23" y="26" width="14" height="11" rx="2.5" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" /><path d="M26 26v-4a4 4 0 0 1 8 0v4" stroke="#1f4fd8" stroke-width="1.8" />
        <rect x="58" y="12" width="26" height="32" rx="4" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" /><path d="M63 20h16M63 27h16M63 34h10" stroke="#a4baf0" stroke-width="2.2" stroke-linecap="round" /><circle cx="78" cy="38" r="5" fill="#ff6a1a" />
      </>)}
      {id === 'geo' && (<>
        <rect x="10" y="12" width="44" height="26" rx="8" fill="#fff" stroke="#1f4fd8" stroke-width="2" /><circle cx="26" cy="25" r="6" fill="none" stroke="#1f4fd8" stroke-width="2.2" /><path d="M31 30l5 5" stroke="#1f4fd8" stroke-width="2.4" stroke-linecap="round" />
        <path d="M70 10l3 8 8 3-8 3-3 8-3-8-8-3 8-3z" fill="#ff6a1a" /><path d="M80 34l1.600 4.400L86 40l-4.400 1.600L80 46l-1.600-4.400L74 40l4.400-1.600z" fill="#1f4fd8" /><path d="M40 46h24" stroke="#a4baf0" stroke-width="2.4" stroke-linecap="round" />
      </>)}
      {id === 'blog' && (<>
        <rect x="14" y="12" width="36" height="34" rx="5" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" /><rect x="19" y="17" width="26" height="12" rx="2" fill="#c9d6f7" /><path d="M19 35h26M19 40h16" stroke="#a4baf0" stroke-width="2.2" stroke-linecap="round" />
        <rect x="46" y="20" width="36" height="28" rx="5" fill="#1f4fd8" /><path d="M52 29h24M52 35h24M52 41h14" stroke="#c9d6f7" stroke-width="2.2" stroke-linecap="round" /><circle cx="78" cy="14" r="5" fill="#ff6a1a" />
      </>)}
      {id === 'article' && (<>
        <rect x="14" y="8" width="38" height="40" rx="5" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" /><path d="M21 18h24M21 25h24M21 32h14" stroke="#a4baf0" stroke-width="2.2" stroke-linecap="round" />
        <circle cx="66" cy="26" r="11" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="2.2" /><path d="M74 34l9 9" stroke="#1f4fd8" stroke-width="3.2" stroke-linecap="round" /><path d="M61 27l4 3 6-7" stroke="#ff6a1a" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
      </>)}
      {id === 'growth' && (<>
        <path d="M14 44V34M26 44V26M38 44V30M50 44V18" stroke="#1f4fd8" stroke-width="7" stroke-linecap="round" /><path d="M12 28l14-9 12 5 20-14" stroke="#ff6a1a" stroke-width="2.600" stroke-linecap="round" stroke-linejoin="round" /><path d="M52 10h8v8" stroke="#ff6a1a" stroke-width="2.600" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="76" cy="30" r="12" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="2" /><path d="M70 30l4 4 7-8" stroke="#1f4fd8" stroke-width="2.600" stroke-linecap="round" stroke-linejoin="round" />
      </>)}
    </svg>
  )}
</div>
