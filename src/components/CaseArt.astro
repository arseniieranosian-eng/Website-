---
// Small decorative illustration for a case-study card on the home pages (same style and palette as NicheArt / ServiceArt). The card heading carries the meaning, so the drawing is hidden from assistive
// technology. kind: half (translation agency, half a year: enquiries growing month after month), typo (print shop: organic traffic growth), kb (city pages), edu (education platform), season (seasonal peak), razbor (site review).
interface Props { kind: string }
const { kind } = Astro.props;
---
<svg class="case-art" viewBox="0 0 96 56" width="96" height="56" fill="none" aria-hidden="true" focusable="false">
  <rect x="0.5" y="0.5" width="95" height="55" rx="10" fill="#f4f6fa" stroke="#e3e7ef" />
  {kind === 'half' && (<>
    <rect x="10" y="30" width="9" height="16" rx="2" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.4" /><rect x="22" y="24" width="9" height="22" rx="2" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.4" /><rect x="34" y="16" width="9" height="30" rx="2" fill="#1f4fd8" />
    <path d="M12 25l11-7 12-8" stroke="#ff6a1a" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /><circle cx="35" cy="10" r="2.6" fill="#ff6a1a" />
    <rect x="52" y="14" width="30" height="16" rx="6" fill="#1f4fd8" /><path d="M58 30v5l6-5" fill="#1f4fd8" stroke="#1f4fd8" stroke-width="1.6" stroke-linejoin="round" />
    <rect x="58" y="32" width="26" height="14" rx="5" fill="#ff6a1a" /><path d="M76 46v4l-5-4" fill="#ff6a1a" stroke="#ff6a1a" stroke-width="1.4" stroke-linejoin="round" />
    <g fill="#fff" font-family="Inter, Arial, sans-serif" font-size="9" font-weight="700" text-anchor="middle"><text x="67" y="25">CS</text><text x="71" y="42">EN</text></g>
  </>)}
  {kind === 'typo' && (<>
    <rect x="10" y="26" width="40" height="18" rx="5" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" /><rect x="17" y="14" width="26" height="14" rx="2" fill="#fff" stroke="#1f4fd8" stroke-width="1.6" />
    <rect x="18" y="35" width="24" height="12" rx="2" fill="#fff" stroke="#1f4fd8" stroke-width="1.6" /><path d="M22 40h16M22 44h10" stroke="#a4baf0" stroke-width="2" stroke-linecap="round" />
    <path d="M58 44V30M68 44V22M78 44V12" stroke="#1f4fd8" stroke-width="7" stroke-linecap="round" /><path d="M58 24l10-8 10-8" stroke="#ff6a1a" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /><path d="M74 6h6v6" stroke="#ff6a1a" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
  </>)}
  {kind === 'kb' && (<>
    <path d="M24 10c-7 0-12 5-12 11 0 8 12 21 12 21s12-13 12-21c0-6-5-11-12-11z" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" stroke-linejoin="round" /><circle cx="24" cy="21" r="4.5" fill="#fff" stroke="#1f4fd8" stroke-width="1.6" />
    <path d="M52 44V34M62 44V26M72 44V18M82 44V10" stroke="#1f4fd8" stroke-width="6" stroke-linecap="round" /><path d="M50 28l11-7 11-7 11-6" stroke="#ff6a1a" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
  </>)}
  {kind === 'edu' && (<>
    <path d="M10 18l22-9 22 9-22 9z" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" stroke-linejoin="round" /><path d="M20 24v9c0 3 6 6 12 6s12-3 12-6v-9" stroke="#1f4fd8" stroke-width="1.8" stroke-linejoin="round" /><path d="M54 18v10" stroke="#ff6a1a" stroke-width="2.4" stroke-linecap="round" />
    <path d="M62 40h24M62 32h18M62 24h12" stroke="#a4baf0" stroke-width="5" stroke-linecap="round" /><circle cx="86" cy="22" r="3" fill="#ff6a1a" />
  </>)}
  {kind === 'season' && (<>
    <rect x="9" y="12" width="40" height="34" rx="5" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" /><path d="M9 22h40" stroke="#1f4fd8" stroke-width="1.8" /><path d="M18 8v8M40 8v8" stroke="#1f4fd8" stroke-width="2" stroke-linecap="round" />
    <path d="M16 38h6M26 38h6M36 38h6M16 30h6" stroke="#a4baf0" stroke-width="3" stroke-linecap="round" /><path d="M26 30h6" stroke="#ff6a1a" stroke-width="3" stroke-linecap="round" />
    <path d="M56 44c6 0 7-10 12-10s5-22 10-22 4 28 12 32" stroke="#1f4fd8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /><circle cx="73" cy="12" r="2.8" fill="#ff6a1a" />
  </>)}
  {kind === 'razbor' && (<>
    <rect x="10" y="8" width="42" height="40" rx="5" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" /><path d="M17 17h20M17 25h28M17 33h14" stroke="#a4baf0" stroke-width="3" stroke-linecap="round" />
    <circle cx="64" cy="26" r="13" fill="#c9d6f7" fill-opacity=".6" stroke="#1f4fd8" stroke-width="2.2" /><path d="M74 36l11 10" stroke="#1f4fd8" stroke-width="4" stroke-linecap="round" /><path d="M58 27l4 4 7-8" stroke="#ff6a1a" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
  </>)}
</svg>
