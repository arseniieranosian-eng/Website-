---
// Illustration for an item of the "Who is it for?" list on the Start (3 months) pages (same palette and 96x56 card as GroupArt).
// The item text carries the meaning, so the drawing is hidden from assistive technology. kind: newsite, nosystem, redesign, maps
interface Props { kind: string }
const { kind } = Astro.props;
---
<svg class="audience-art" viewBox="0 0 96 56" width="84" height="49" fill="none" aria-hidden="true" focusable="false">
  <rect x="0.5" y="0.5" width="95" height="55" rx="10" fill="#f4f6fa" stroke="#e3e7ef" />
  {kind === 'newsite' && (<>
    <rect x="12" y="10" width="46" height="36" rx="5" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" /><path d="M12 19h46" stroke="#1f4fd8" stroke-width="1.8" /><circle cx="18" cy="14.500" r="1.600" fill="#1f4fd8" /><circle cx="24" cy="14.500" r="1.600" fill="#a4baf0" />
    <rect x="18" y="24" width="18" height="15" rx="3" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.4" /><path d="M41 25h12M41 31h12M41 37h7" stroke="#a4baf0" stroke-width="2.400" stroke-linecap="round" />
    <path d="M62 44V34M72 44V27M82 44V18" stroke="#1f4fd8" stroke-width="7" stroke-linecap="round" /><path d="M62 24l9-7 12-6" stroke="#ff6a1a" stroke-width="2.400" stroke-linecap="round" stroke-linejoin="round" />
  </>)}
  {kind === 'nosystem' && (<>
    <rect x="10" y="9" width="30" height="38" rx="5" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" /><path d="M16 19h18M16 26h18M16 33h10" stroke="#a4baf0" stroke-width="2.400" stroke-linecap="round" />
    <path d="M48 28h14" stroke="#1f4fd8" stroke-width="2.400" stroke-linecap="round" /><path d="M58 23l5 5-5 5" stroke="#1f4fd8" stroke-width="2.400" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="76" cy="28" r="13" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" /><path d="M69 28l5 5 9-10" stroke="#ff6a1a" stroke-width="3.200" stroke-linecap="round" stroke-linejoin="round" />
  </>)}
  {kind === 'redesign' && (<>
    <rect x="9" y="12" width="34" height="30" rx="5" fill="#fff" stroke="#1f4fd8" stroke-opacity=".5" stroke-width="1.8" stroke-dasharray="3 3" /><path d="M15 22h22M15 29h22M15 36h12" stroke="#a4baf0" stroke-width="2.200" stroke-linecap="round" />
    <rect x="53" y="12" width="34" height="30" rx="5" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" /><path d="M59 22h22M59 29h22M59 36h12" stroke="#1f4fd8" stroke-opacity=".5" stroke-width="2.200" stroke-linecap="round" />
    <path d="M46 27h4M47 22l-3 5 3 5" stroke="#ff6a1a" stroke-width="2.400" stroke-linecap="round" stroke-linejoin="round" /><path d="M66 50V47M72 50V45M78 50V43" stroke="#ff6a1a" stroke-width="2.400" stroke-linecap="round" />
  </>)}
  {kind === 'maps' && (<>
    <path d="M10 14l22-4 22 4 22-4 10 3v30l-10-3-22 4-22-4-22 4z" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" stroke-linejoin="round" /><path d="M32 10v34M54 14v34" stroke="#1f4fd8" stroke-opacity=".35" stroke-width="1.4" />
    <path d="M62 10c-6 0-10 4.500-10 9.500C52 27 62 40 62 40s10-13 10-20.500C72 14.500 68 10 62 10z" fill="#ff6a1a" /><circle cx="62" cy="19.500" r="3.600" fill="#fff" />
    <path d="M20 36h10M20 42h14" stroke="#a4baf0" stroke-width="2.400" stroke-linecap="round" />
  </>)}
</svg>
