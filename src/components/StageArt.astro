---
// Illustration for a stage of the Start (3 months) timeline (same palette and 96x56 card as GroupArt).
// The stage text carries the meaning, so the drawing is hidden from assistive technology. kind: audit, content, scale
interface Props { kind: string }
const { kind } = Astro.props;
---
<svg class="stage-art" viewBox="0 0 96 56" width="96" height="56" fill="none" aria-hidden="true" focusable="false">
  <rect x="0.5" y="0.5" width="95" height="55" rx="10" fill="#f4f6fa" stroke="#e3e7ef" />
  {kind === 'audit' && (<>
    <rect x="12" y="8" width="38" height="40" rx="5" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" /><path d="M19 19h24M19 27h24M19 35h12" stroke="#a4baf0" stroke-width="2.400" stroke-linecap="round" />
    <circle cx="60" cy="27" r="13" fill="#c9d6f7" fill-opacity=".7" stroke="#1f4fd8" stroke-width="2" /><path d="M69.500 36.500L80 47" stroke="#1f4fd8" stroke-width="4" stroke-linecap="round" /><path d="M54 27l4 4 8-8" stroke="#ff6a1a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
  </>)}
  {kind === 'content' && (<>
    <rect x="12" y="8" width="44" height="40" rx="5" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" /><rect x="18" y="14" width="32" height="10" rx="3" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.4" /><path d="M18 32h32M18 39h18" stroke="#a4baf0" stroke-width="2.400" stroke-linecap="round" />
    <path d="M60 44l2-9 18-18 7 7-18 18z" fill="#ff6a1a" stroke="#ff6a1a" stroke-width="1.600" stroke-linejoin="round" /><path d="M76 21l7 7" stroke="#fff" stroke-width="1.800" /><path d="M60 44l2-9 7 7z" fill="#fff" stroke="#ff6a1a" stroke-width="1.400" stroke-linejoin="round" />
  </>)}
  {kind === 'scale' && (<>
    <path d="M14 46V36M28 46V30M42 46V24" stroke="#1f4fd8" stroke-width="8" stroke-linecap="round" /><path d="M12 28l16-8 14-8" stroke="#ff6a1a" stroke-width="2.400" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="68" cy="28" r="5" fill="#ff6a1a" /><circle cx="68" cy="28" r="11" stroke="#1f4fd8" stroke-opacity=".6" stroke-width="1.800" /><circle cx="68" cy="28" r="17" stroke="#1f4fd8" stroke-opacity=".3" stroke-width="1.600" />
  </>)}
</svg>
