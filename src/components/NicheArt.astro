---
// Small decorative illustration for a niche heading (the heading carries the meaning, so the drawing is hidden from assistive
// technology). One drawing per niche id from NICHE_GROUPS in routes.ts; add a branch here when a new niche appears.
interface Props { kind: string }
const { kind } = Astro.props;
---
<svg class="niche-art" viewBox="0 0 96 56" width="96" height="56" fill="none" aria-hidden="true" focusable="false">
  <rect x="0.5" y="0.5" width="95" height="55" rx="10" fill="#f4f6fa" stroke="#e3e7ef" />
  {kind === 'translation' && (<>
    <path d="M10 26 17 20 25 22 31 16 40 18 46 24 43 30 36 32 32 40 22 40 14 36Z" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" stroke-linejoin="round" />
    <circle cx="28" cy="29" r="2.6" fill="#ff6a1a" />
    <rect x="52" y="9" width="30" height="17" rx="6" fill="#1f4fd8" /><path d="M60 26v5l6-5" fill="#1f4fd8" stroke="#1f4fd8" stroke-width="1.6" stroke-linejoin="round" />
    <rect x="46" y="30" width="30" height="17" rx="6" fill="#ff6a1a" /><path d="M68 47v5l-6-5" fill="#ff6a1a" stroke="#ff6a1a" stroke-width="1.6" stroke-linejoin="round" />
    <g fill="#fff" font-family="Inter, Arial, sans-serif" font-size="10" font-weight="700" text-anchor="middle"><text x="67" y="21">A</text><text x="61" y="42">Я</text></g>
  </>)}
  {kind === 'accounting' && (<>
    <rect x="14" y="10" width="34" height="38" rx="5" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" /><path d="M21 20h20M21 27h20M21 34h12" stroke="#a4baf0" stroke-width="2.2" stroke-linecap="round" />
    <rect x="54" y="14" width="30" height="34" rx="5" fill="#1f4fd8" /><rect x="59" y="19" width="20" height="8" rx="2" fill="#c9d6f7" />
    <g fill="#fff"><circle cx="62" cy="34" r="2.2" /><circle cx="69" cy="34" r="2.2" /><circle cx="76" cy="34" r="2.2" /><circle cx="62" cy="41" r="2.2" /><circle cx="69" cy="41" r="2.2" /></g><circle cx="76" cy="41" r="2.2" fill="#ff6a1a" />
  </>)}
  {kind === 'gaming' && (<>
    <rect x="14" y="16" width="44" height="26" rx="13" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="2" />
    <path d="M27 25v10M22 30h10" stroke="#1f4fd8" stroke-width="3" stroke-linecap="round" />
    <circle cx="44" cy="26" r="3" fill="#ff6a1a" /><circle cx="50" cy="32" r="3" fill="#1f4fd8" />
    <rect x="64" y="14" width="20" height="26" rx="3" fill="#fff" stroke="#1f4fd8" stroke-width="2" /><rect x="68" y="18" width="12" height="9" rx="1.5" fill="#c9d6f7" /><path d="M68 33h12M70 46h8" stroke="#1f4fd8" stroke-width="2.2" stroke-linecap="round" />
  </>)}
  {kind === 'machinery' && (<>
    <circle cx="34" cy="30" r="13" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="2" /><circle cx="34" cy="30" r="5" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" />
    <path d="M34 11v6M34 43v6M15 30h6M47 30h6M20.5 16.5l4.2 4.2M43.3 39.3l4.2 4.2M47.5 16.5l-4.2 4.2M24.7 39.3l-4.2 4.2" stroke="#1f4fd8" stroke-width="3" stroke-linecap="round" />
    <circle cx="70" cy="34" r="9" fill="#ff6a1a" /><circle cx="70" cy="34" r="3.4" fill="#fff" />
    <path d="M70 21v5M70 42v5M57 34h5M78 34h5M60.8 24.8l3.5 3.5M75.7 39.7l3.5 3.5M79.2 24.8l-3.5 3.5M64.3 39.7l-3.5 3.5" stroke="#ff6a1a" stroke-width="2.4" stroke-linecap="round" />
  </>)}
  {kind === 'printing' && (<>
    <rect x="12" y="26" width="46" height="20" rx="5" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" /><rect x="20" y="14" width="30" height="14" rx="2" fill="#fff" stroke="#1f4fd8" stroke-width="1.6" />
    <rect x="22" y="36" width="26" height="14" rx="2" fill="#fff" stroke="#1f4fd8" stroke-width="1.6" /><path d="M26 41h18M26 45h12" stroke="#a4baf0" stroke-width="2" stroke-linecap="round" />
    <g><rect x="66" y="12" width="9" height="32" fill="#1f4fd8" /><rect x="75" y="12" width="9" height="32" fill="#ff6a1a" /><rect x="66" y="44" width="18" height="4" rx="2" fill="#c9d6f7" /></g>
  </>)}
  {kind === 'finance' && (<>
    <rect x="14" y="30" width="10" height="16" rx="2" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.6" /><rect x="29" y="22" width="10" height="24" rx="2" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.6" /><rect x="44" y="14" width="10" height="32" rx="2" fill="#1f4fd8" />
    <circle cx="70" cy="28" r="14" fill="#fff" stroke="#ff6a1a" stroke-width="2" /><path d="M65 28h10M70 23v10" stroke="#ff6a1a" stroke-width="2.4" stroke-linecap="round" />
  </>)}
  {kind === 'realty' && (<>
    <path d="M16 30 38 12l22 18v16H16z" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" stroke-linejoin="round" />
    <rect x="31" y="34" width="14" height="12" rx="1.5" fill="#fff" stroke="#1f4fd8" stroke-width="1.6" />
    <path d="M72 12c-6 0-10 4.4-10 9.6 0 6.8 10 16.4 10 16.4s10-9.6 10-16.4C82 16.4 78 12 72 12z" fill="#ff6a1a" /><circle cx="72" cy="21.5" r="3.6" fill="#fff" />
  </>)}
</svg>
