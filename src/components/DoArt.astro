---
// Small decorative illustration for an item of the "what I do" list on a niche landing page (same style and palette as NicheArt: soft card, blue strokes, one orange accent).
// The heading next to it carries the meaning, so the drawing is hidden from assistive technology. One drawing per `kind`: pairs, services, b2b, versions, local, geo.
interface Props { kind: string }
const { kind } = Astro.props;
---
<svg class="do-art" viewBox="0 0 96 56" width="96" height="56" fill="none" aria-hidden="true" focusable="false">
  <rect x="0.5" y="0.5" width="95" height="55" rx="10" fill="#f4f6fa" stroke="#e3e7ef" />
  {kind === 'pairs' && (<>
    <rect x="9" y="17" width="30" height="22" rx="6" fill="#1f4fd8" />
    <rect x="57" y="17" width="30" height="22" rx="6" fill="#ff6a1a" />
    <g fill="#fff" font-family="Inter, Arial, sans-serif" font-size="11" font-weight="700" text-anchor="middle"><text x="24" y="32">CS</text><text x="72" y="32">EN</text></g>
    <path d="M43 24h10m-3-3 3 3-3 3M53 33H43m3-3-3 3 3 3" stroke="#1f4fd8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </>)}
  {kind === 'services' && (<>
    <rect x="12" y="10" width="32" height="16" rx="4" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.6" /><path d="M18 18h20" stroke="#1f4fd8" stroke-width="2" stroke-linecap="round" />
    <rect x="52" y="10" width="32" height="16" rx="4" fill="#fff" stroke="#1f4fd8" stroke-width="1.6" /><path d="M58 18h14" stroke="#a4baf0" stroke-width="2" stroke-linecap="round" />
    <rect x="12" y="30" width="32" height="16" rx="4" fill="#fff" stroke="#1f4fd8" stroke-width="1.6" /><path d="M18 38h14" stroke="#a4baf0" stroke-width="2" stroke-linecap="round" />
    <rect x="52" y="30" width="32" height="16" rx="4" fill="#ff6a1a" /><path d="M58 38h20" stroke="#fff" stroke-width="2" stroke-linecap="round" />
  </>)}
  {kind === 'b2b' && (<>
    <rect x="14" y="10" width="34" height="38" rx="4" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" />
    <g fill="#1f4fd8"><rect x="20" y="16" width="6" height="6" rx="1" /><rect x="30" y="16" width="6" height="6" rx="1" /><rect x="20" y="26" width="6" height="6" rx="1" /><rect x="30" y="26" width="6" height="6" rx="1" /></g>
    <rect x="25" y="38" width="10" height="10" rx="1.5" fill="#fff" stroke="#1f4fd8" stroke-width="1.6" />
    <circle cx="68" cy="28" r="14" fill="#ff6a1a" /><path d="M61 28l5 5 9-10" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
  </>)}
  {kind === 'versions' && (<>
    <rect x="10" y="9" width="30" height="38" rx="5" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" /><path d="M16 19h18M16 26h18M16 33h10" stroke="#a4baf0" stroke-width="2" stroke-linecap="round" />
    <rect x="56" y="9" width="30" height="38" rx="5" fill="#fff" stroke="#1f4fd8" stroke-width="1.8" /><path d="M62 19h18M62 26h18M62 33h10" stroke="#a4baf0" stroke-width="2" stroke-linecap="round" />
    <path d="M42 28h12m-3-3 3 3-3 3" stroke="#1f4fd8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="48" cy="44" r="7" fill="#ff6a1a" /><path d="M44.5 44l2.5 2.5 4.5-5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  </>)}
  {kind === 'local' && (<>
    <path d="M10 14l22-4 22 6 22-6 10 4v32l-10-4-22 6-22-6-22 4z" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.6" stroke-linejoin="round" />
    <path d="M32 10v36M54 16v36M76 10v32" stroke="#1f4fd8" stroke-opacity="0.35" stroke-width="1.4" />
    <path d="M48 12c-6 0-10 4.2-10 9.2 0 6.4 10 16 10 16s10-9.600 10-16C58 16.200 54 12 48 12z" fill="#ff6a1a" /><circle cx="48" cy="21" r="3.5" fill="#fff" />
  </>)}
  {kind === 'geo' && (<>
    <rect x="12" y="10" width="52" height="30" rx="9" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" /><path d="M24 40v8l10-8" fill="#c9d6f7" stroke="#1f4fd8" stroke-width="1.8" stroke-linejoin="round" />
    <path d="M22 22h32M22 29h20" stroke="#1f4fd8" stroke-width="2.2" stroke-linecap="round" />
    <path d="M74 12l3 8 8 3-8 3-3 8-3-8-8-3 8-3z" fill="#ff6a1a" /><path d="M70 40l1.5 4 4 1.5-4 1.5-1.5 4-1.5-4-4-1.5 4-1.5z" fill="#1f4fd8" />
  </>)}
</svg>
