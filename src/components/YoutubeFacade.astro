---
// YouTube video as a facade (the same pattern as the review video on the translation niche pages): a poster with a play button; the player (youtube-nocookie.com, no autoplay before the click)
// loads only on click, so YouTube is not contacted before the visitor asks for it. 16:9, a title in Czech, a link to the original. No VideoObject markup (site rule).
interface Props { youtube: string; poster: string; width: number; height: number; alt: string; playLabel: string; frameTitle: string; openLabel: string; note?: string }
const { youtube, poster, width, height, alt, playLabel, frameTitle, openLabel, note } = Astro.props;
---
<figure class="niche-video" data-youtube={youtube} data-title={frameTitle}>
  <button class="niche-video__facade" type="button" aria-label={playLabel}>
    <img src={poster} width={width} height={height} alt={alt} loading="lazy" decoding="async" />
    <span class="niche-video__play" aria-hidden="true"></span>
  </button>
  <figcaption class="muted small">{note && <>{note} · </>}<a href={`https://youtu.be/${youtube}`} target="_blank" rel="noopener">{openLabel}</a></figcaption>
</figure>
<script>
  document.querySelectorAll<HTMLElement>('.niche-video').forEach((fig) => {
    const btn = fig.querySelector<HTMLButtonElement>('.niche-video__facade');
    btn?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${fig.dataset.youtube}?autoplay=1&rel=0`;
      f.allow = 'autoplay; fullscreen; picture-in-picture';
      f.allowFullscreen = true;
      f.title = fig.dataset.title ?? '';
      f.className = 'niche-video__frame';
      btn.replaceWith(f);
    });
  });
</script>
