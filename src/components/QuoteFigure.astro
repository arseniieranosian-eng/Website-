---
// The author's quote on a service page: figure > blockquote (cite = page URL) + caption with a link to the about page.
import type { Lang } from '../i18n/routes';
import QuoteCaption from './QuoteCaption.astro';
interface Props { text: string; cite: string; lang?: Lang }
const { text, cite, lang = 'cs' } = Astro.props;
---
<section class="section section--tight">
  <div class="container narrow">
    <figure class="quote-fig">
      <blockquote cite={cite}><p>{text}</p></blockquote>
      <QuoteCaption lang={lang} />
    </figure>
  </div>
</section>
