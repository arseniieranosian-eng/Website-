# Apache config for the static build (upload the contents of dist/ to the web root).
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# 301 redirects from the old service URLs (the /sluzby/, /en/services/ and /ru/uslugi/ section was removed).
# Absolute https://seo-eranosian.com (no www) targets on purpose: no host-dependent rules (see the note below about the hosting redirects).
<IfModule mod_alias.c>
  RedirectMatch 301 ^/sluzby/konzultace/?$ https://seo-eranosian.com/konzultace/
  RedirectMatch 301 ^/sluzby/start-3-mesice/?$ https://seo-eranosian.com/start-3-mesice/
  RedirectMatch 301 ^/sluzby/full-seo/?$ https://seo-eranosian.com/full-seo/
  RedirectMatch 301 ^/sluzby/mapy/?$ https://seo-eranosian.com/mapy/
  RedirectMatch 301 ^/sluzby/?$ https://seo-eranosian.com/

  RedirectMatch 301 ^/en/services/consulting/?$ https://seo-eranosian.com/en/consulting/
  RedirectMatch 301 ^/en/services/3-month-start/?$ https://seo-eranosian.com/en/3-month-start/
  RedirectMatch 301 ^/en/services/full-seo/?$ https://seo-eranosian.com/en/full-seo/
  RedirectMatch 301 ^/en/services/maps/?$ https://seo-eranosian.com/en/maps/
  RedirectMatch 301 ^/en/services/?$ https://seo-eranosian.com/en/

  RedirectMatch 301 ^/ru/uslugi/konsultacii/?$ https://seo-eranosian.com/ru/konsultacii/
  RedirectMatch 301 ^/ru/uslugi/start-3-mesyaca/?$ https://seo-eranosian.com/ru/start-3-mesyaca/
  RedirectMatch 301 ^/ru/uslugi/full-seo/?$ https://seo-eranosian.com/ru/full-seo/
  RedirectMatch 301 ^/ru/uslugi/karty/?$ https://seo-eranosian.com/ru/karty/
  RedirectMatch 301 ^/ru/uslugi/?$ https://seo-eranosian.com/ru/

  # case study: the client was anonymised, the address changed
  RedirectMatch 301 ^/pripadove-studie/kb-preklady/?$ https://seo-eranosian.com/pripadove-studie/seo-prekladatelska-agentura-4-mesice/
  RedirectMatch 301 ^/en/case-studies/kb-preklady/?$ https://seo-eranosian.com/en/case-studies/seo-translation-agency-4-months/
  RedirectMatch 301 ^/ru/kejsy/kb-preklady/?$ https://seo-eranosian.com/ru/kejsy/seo-perevodcheskoe-agentstvo-4-mesyaca/
  RedirectMatch 301 ^/en/case-studies/seo-translation-agency/?$ https://seo-eranosian.com/en/case-studies/seo-translation-agency-4-months/
  RedirectMatch 301 ^/ru/kejsy/seo-perevodcheskoe-agentstvo/?$ https://seo-eranosian.com/ru/kejsy/seo-perevodcheskoe-agentstvo-4-mesyaca/
</IfModule>

# No host/HTTPS redirects here on purpose: Český hosting handles www and HTTPS in the
# hosting panel (Webserver -> Nastavení -> pencil). Duplicating them in .htaccess caused
# ERR_TOO_MANY_REDIRECTS.

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml text/plain
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>
